---
import { getMetadata } from "~/shared/lib/constants";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Layout/footer.astro";
import Navbar from "../components/Layout/navbar.astro";
import AttributionScript from "../components/analytics/AttributionScript.astro";
import GoogleAnalytics from "../components/analytics/GoogleAnalytics.astro";
import MetaPixel from "../components/analytics/MetaPixel.astro";
import MicrosoftClarity from "../components/analytics/MicrosoftClarity.astro";
import ConsentScript from "../components/consent/ConsentScript.astro";
import CookieBanner from "../components/consent/CookieBanner.astro";
import OpenGraph from "../components/seo/OpenGraph.astro";
import SEOHead from "../components/seo/SEOHead.astro";
import SchemaOrg from "../components/seo/SchemaOrg.astro";
import FloatingCTA from "../components/ui/FloatingCTA.astro";
import ReadingProgress from "../components/ui/ReadingProgress.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
  showFooterCta?: boolean;
  type?: "organization" | "website" | "article" | "service" | "project";
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
  };
  service?: {
    name: string;
    description: string;
    image?: string;
    url?: string;
    serviceType?: string;
    price?: number;
    priceCurrency?: string;
  };
  project?: {
    name: string;
    description: string;
    image?: string;
    client?: string;
    datePublished?: string;
    url?: string;
    services?: string[];
  };
  faqs?: {
    question: string;
    answer: string;
  }[];
}

const metadata = getMetadata();

const {
  title = metadata.title,
  description = metadata.description,
  image = "/og-image.png",
  robots,
  showFooterCta = true,
  type = "website",
  article,
  service,
  project,
  faqs,
} = Astro.props;
---

<html lang="es" dir="ltr" class="w-full overflow-x-clip">
  <head>
    <ConsentScript />
    <BaseHead title={title} description={description} image={image} />
    <SEOHead robots={robots} />
    <OpenGraph
      title={title}
      description={description}
      image={image}
      type={type === "article" ? "article" : "website"}
      article={article}
    />
    <SchemaOrg
      type={type}
      article={article
        ? {
            title,
            description,
            image,
            datePublished: article.publishedTime,
            dateModified: article.modifiedTime,
            author: article.author,
          }
        : undefined}
      service={service}
      project={project}
      faqs={faqs}
    />
    <GoogleAnalytics />
    <AttributionScript />
    <MicrosoftClarity />
    <MetaPixel />
    <script>
      // Prefetch links on hover for instant navigation
      document.addEventListener("astro:page-load", () => {
        const links = document.querySelectorAll('a[href^="/"]');
        links.forEach((link) => {
          link.addEventListener("mouseenter", () => {
            const href = link.getAttribute("href");
            if (href) {
              const url = new URL(href, window.location.origin);
              if (url.origin === window.location.origin) {
                // Prefetch the page
                const prefetchLink = document.createElement("link");
                prefetchLink.rel = "prefetch";
                prefetchLink.href = href;
                document.head.appendChild(prefetchLink);
              }
            }
          });
        });
      });
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:bg-background focus:text-foreground focus:px-4 focus:py-2 focus:rounded-lg focus:ring-2 focus:ring-primary focus:outline-none font-medium"
    >
      Saltar al contenido principal
    </a>
    <ReadingProgress />
    <Navbar />
    <main id="main-content" class="flex flex-col w-full gap-20 pb-20">
      <slot />
    </main>
    <Footer showCta={showFooterCta} />
    {Astro.url.pathname !== "/contact" && <FloatingCTA />}
    <CookieBanner />
    <!-- GoHighLevel CRM tracking: única fuente de carga (con guard anti-doble-carga).
         CookieBanner reutiliza window.__loadGHL() al aceptar consent de marketing. -->
    <script is:inline>
      window.GHL_TRACKING_ID_PENDING = "tk_bd6c82a0afde449a8ffd7dd348ef5130";
      window.__loadGHL = function () {
        if (
          window.sessionStorage.getItem("doscientos:internal-traffic") === "1"
        )
          return;
        if (!window.GHL_TRACKING_ID_PENDING) return;
        if (document.getElementById("ghl-tracking")) return;
        var s = document.createElement("script");
        s.id = "ghl-tracking";
        s.src = "https://link.msgsndr.com/js/external-tracking.js";
        s.dataset.trackingId = window.GHL_TRACKING_ID_PENDING;
        document.body.appendChild(s);
      };
      if (window.__DOS_CONSENT?.marketing) window.__loadGHL();
    </script>
  </body>
</html>

<script>
  // astro-reveal: zero-JS-in-prod scroll reveals for all sections/titles
  // (auto-inits on load + astro:page-load). GSAP only drives the hero.
  import "@polgubau/astro-reveal";
  import "../shared/scripts/animations";
</script>

<style is:global>
  @keyframes opacity-fade {
    from {
      opacity: 1;
    }
    to {
      transform: translateY(20px);
      opacity: 0;
      filter: blur(10px);
    }
  }
</style>
