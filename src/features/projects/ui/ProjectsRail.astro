---
import ProjectCard from "~/components/ui/ProjectCard.astro";
import type { ProjectMetadata } from "~/content.config";
type Props = {
  projects: ProjectMetadata[];
  id?: string;
};

const { projects, id } = Astro.props;
---

<div
  id={id}
  class="grid grid-cols-1 lg:grid-cols-2 gap-6 w-full"
  data-stagger="150"
>
  {
    projects.map((project, projectIndex) => (
      <div
        class:list={{ "lg:col-span-2": projectIndex === 0 }}
        data-reveal="bottom"
        data-speed="normal"
        data-easing="smooth"
        data-distance="small"
      >
        <ProjectCard
          id={project.id}
          title={project.data.title}
          client={project.data.client}
          timeline={project.data.timeline}
          summary={project.data.summary}
          services_provided={project.data.services_provided ?? []}
          color={project.data.color}
          cover={project.data.cover}
          featured={projectIndex === 0}
        />
      </div>
    ))
  }
</div>
