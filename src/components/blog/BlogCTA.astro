---
/**
 * BlogCTA — CTA de conversión al final de cada artículo del blog.
 * Enlaza al servicio más relevante según el tipo de artículo.
 */
import type { BlogCtaVariant } from "~/data/commercialRoutes";

interface Props {
  variant?: BlogCtaVariant;
  headline?: string;
  body?: string;
  cta?: string;
  href?: string;
}

const { variant = "contact", headline, body, cta, href } = Astro.props;

const defaults: Record<
  NonNullable<Props["variant"]>,
  { headline: string; body: string; cta: string; href: string }
> = {
  contact: {
    headline: "¿Tienes un proyecto en mente?",
    body: "Cuéntanos qué necesitas. Respuesta en menos de 24h, sin compromiso.",
    cta: "Hablar con el equipo",
    href: "/contact",
  },
  diagnostic: {
    headline: "Detecta qué proceso te está costando dinero",
    body: "En 20 minutos revisamos tu flujo, calculamos el coste oculto y te decimos qué automatizar primero.",
    cta: "Pedir diagnóstico gratis",
    href: "/diagnostico-procesos?ref=blog-cta",
  },
  automation: {
    headline: "Automatiza el proceso que más horas consume",
    body: "Excel, renovaciones, incidencias o partes de trabajo: revisamos el caso y priorizamos el primer módulo rentable.",
    cta: "Ver diagnóstico de procesos",
    href: "/diagnostico-procesos?ref=blog-automation",
  },
  legacy: {
    headline: "Moderniza sin parar el negocio",
    body: "Auditamos el sistema actual, identificamos el módulo más crítico y diseñamos una migración progresiva sin big bang.",
    cta: "Revisar mi sistema",
    href: "/diagnostico-procesos?ref=blog-legacy",
  },
  mvp: {
    headline: "Valida antes de construir de más",
    body: "Te ayudamos a convertir una idea en un primer producto medible, con alcance cerrado y aprendizaje real.",
    cta: "Definir mi MVP",
    href: "/diagnostico-procesos?ref=blog-mvp",
  },
  app: {
    headline: "Antes de hacer una app, valida el flujo",
    body: "Muchas apps de negocio empiezan como portal, PWA o automatización interna. Revisamos qué formato tiene más ROI.",
    cta: "Elegir el enfoque correcto",
    href: "/diagnostico-procesos?ref=blog-app",
  },
  packs: {
    headline: "¿Buscas una web rápida y profesional?",
    body: "Nuestros packs incluyen diseño, desarrollo y lanzamiento. Precio fijo, sin sorpresas.",
    cta: "Ver packs de webs",
    href: "/packs",
  },
  projects: {
    headline: "¿Quieres ver resultados reales?",
    body: "Casos de éxito con métricas concretas: usuarios, ahorro, ROI.",
    cta: "Ver proyectos",
    href: "/projects",
  },
  barcelona: {
    headline: "¿Tu empresa está en Barcelona?",
    body: "Somos una agencia con base en el Maresme. Reuniones presenciales, sin costes extra.",
    cta: "Desarrollo web en Barcelona",
    href: "/desarrollo-web-barcelona",
  },
  madrid: {
    headline: "¿Tu empresa está en Madrid?",
    body: "Trabajamos con empresas madrileñas en remoto con la misma dedicación que si estuviéramos a la vuelta de la esquina.",
    cta: "Desarrollo web en Madrid",
    href: "/desarrollo-web-madrid",
  },
  maresme: {
    headline: "¿Tu negocio está en el Maresme?",
    body: "Estamos en Premià de Mar. Reuniones presenciales en toda la comarca, sin desplazamientos extra.",
    cta: "Agencia digital en el Maresme",
    href: "/agencia-digital-maresme",
  },
};

const config = defaults[variant];
const finalHeadline = headline ?? config.headline;
const finalBody = body ?? config.body;
const finalCta = cta ?? config.cta;
const finalHref = href ?? config.href;
---

<div
  class="not-prose my-16 rounded-2xl bg-primary px-8 py-10 text-background space-y-4"
>
  <h2 class="text-2xl md:text-3xl font-bold leading-tight">
    {finalHeadline}
  </h2>
  <p class="text-lg opacity-85 max-w-xl">
    {finalBody}
  </p>
  <a
    href={finalHref}
    class="inline-flex items-center gap-2 mt-2 rounded-xl bg-background text-primary font-semibold px-6 py-3 text-sm hover:bg-background/90 transition-colors"
  >
    {finalCta}
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="size-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M5 12h14M12 5l7 7-7 7"></path>
    </svg>
  </a>
</div>
