<script>
  // Minimal attribution bootstrap — see ~/shared/lib/attribution.ts for what
  // this actually does and why (first-touch capture, hidratación de los
  // enlaces de WhatsApp y un page_view enviado por sendBeacon en idle).
  import { initAttribution } from "~/shared/lib/attribution";

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAttribution, {
      once: true,
    });
  } else {
    initAttribution();
  }
  document.addEventListener("astro:page-load", initAttribution);
</script>
