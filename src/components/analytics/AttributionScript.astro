---
const trackingEndpoint = import.meta.env.PUBLIC_TRACKING_ENDPOINT || "https://app.doscientos.es";
---

<script define:vars={{ trackingEndpoint }}>
  (function () {
    var FIRST_TOUCH_KEY = "doscientos:first-touch";
    var EVENT_ID_KEY = "doscientos:event-id";
    var VISITOR_ID_KEY = "doscientos:visitor-id";
    var TRACKING_ENDPOINT = trackingEndpoint;
    var lastPageViewKey = "";

    function uuid() {
      if (window.crypto && typeof window.crypto.randomUUID === "function") {
        return window.crypto.randomUUID();
      }
      return String(Date.now()) + "-" + Math.random().toString(16).slice(2);
    }

    function getEventId() {
      try {
        var existing = window.sessionStorage.getItem(EVENT_ID_KEY);
        if (existing) return existing;
        var next = uuid();
        window.sessionStorage.setItem(EVENT_ID_KEY, next);
        return next;
      } catch (_) {
        return uuid();
      }
    }

    function getVisitorId() {
      try {
        var existing = window.localStorage.getItem(VISITOR_ID_KEY);
        if (existing) return existing;
        var next = uuid();
        window.localStorage.setItem(VISITOR_ID_KEY, next);
        return next;
      } catch (_) {
        return uuid();
      }
    }

    function currentTouch() {
      var params = new URLSearchParams(window.location.search);
      return {
        landing_path: window.location.pathname,
        referrer: document.referrer || "",
        utm_source: params.get("utm_source") || "",
        utm_medium: params.get("utm_medium") || "",
        utm_campaign: params.get("utm_campaign") || "",
        utm_term: params.get("utm_term") || "",
        utm_content: params.get("utm_content") || "",
        captured_at: new Date().toISOString(),
      };
    }

    function storeFirstTouch(touch) {
      try {
        if (!window.localStorage.getItem(FIRST_TOUCH_KEY)) {
          window.localStorage.setItem(FIRST_TOUCH_KEY, JSON.stringify(touch));
        }
      } catch (_) {
        // Storage can be unavailable in private browsing.
      }
    }

    function hydrateWhatsappLinks(touch) {
      var links = document.querySelectorAll('a[href*="/api/public/whatsapp-click"]');
      links.forEach(function (link) {
        try {
          var url = new URL(link.href);
          url.searchParams.set("event_id", getEventId());
          url.searchParams.set("visitor_id", getVisitorId());
          url.searchParams.set("landing_path", touch.landing_path);
          url.searchParams.set("referrer", touch.referrer);
          ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"].forEach(function (key) {
            if (touch[key]) url.searchParams.set(key, touch[key]);
          });
          link.href = url.toString();
        } catch (_) {
          // Leave the original href untouched if URL parsing fails.
        }
      });
    }

    function inferConversionStep() {
      var params = new URLSearchParams(window.location.search);
      var explicit = params.get("conversion_step");
      if (explicit) return explicit;
      var ref = params.get("ref") || "";
      var path = window.location.pathname;
      if (ref.indexOf("calculadora") !== -1) return "calculator";
      if (ref.indexOf("blog-") === 0) return "blog_cta";
      if (ref.indexOf("pack") !== -1 || path.indexOf("/packs") === 0) return "pack_cta";
      if (path === "/contact") return "contact_form";
      if (path.indexOf("/blog") === 0) return "blog_cta";
      if (path.indexOf("/diagnostico") === 0) return "diagnostic_form";
      return "landing_form";
    }

    function eventPayload(eventName, touch, extra) {
      return Object.assign({
        event_id: getEventId(),
        visitor_id: getVisitorId(),
        event_name: eventName,
        conversion_step: inferConversionStep(),
        landing_path: touch.landing_path,
        referrer: touch.referrer,
        utm_source: touch.utm_source,
        utm_medium: touch.utm_medium,
        utm_campaign: touch.utm_campaign,
        utm_term: touch.utm_term,
        utm_content: touch.utm_content,
      }, extra || {});
    }

    function postEvent(eventName, extra) {
      try {
        var touch = currentTouch();
        var body = JSON.stringify(eventPayload(eventName, touch, extra));
        var url = new URL("/api/public/events", TRACKING_ENDPOINT).toString();
        if (navigator.sendBeacon) {
          var blob = new Blob([body], { type: "application/json" });
          if (navigator.sendBeacon(url, blob)) return;
        }
        fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: body,
          keepalive: true,
        }).catch(function () {});
      } catch (_) {
        // Analytics must never break the page.
      }
    }

    function hydrateTrackedClicks() {
      document.querySelectorAll("a,button").forEach(function (el) {
        if (el.dataset.dosTracked) return;
        el.dataset.dosTracked = "1";
        el.addEventListener("click", function () {
          var label = el.getAttribute("aria-label") || el.textContent || "";
          var href = el instanceof HTMLAnchorElement ? el.href : "";
          var isWhatsapp = href.indexOf("/api/public/whatsapp-click") !== -1 || href.indexOf("wa.me") !== -1;
          var isContact = href.indexOf("/contact") !== -1 || href.indexOf("mailto:") === 0 || href.indexOf("tel:") === 0;
          if (!isWhatsapp && !isContact) return;
          postEvent(isWhatsapp ? "whatsapp_cta_click" : "contact_cta_click", {
            landing_ref: el.getAttribute("data-landing-ref") || "",
            payload: {
              label: label.trim().slice(0, 120),
              href: href.slice(0, 500),
            },
          });
        });
      });
    }

    function initAttribution() {
      var touch = currentTouch();
      storeFirstTouch(touch);
      getEventId();
      getVisitorId();
      hydrateWhatsappLinks(touch);
      hydrateTrackedClicks();
      var pageViewKey = touch.landing_path + window.location.search;
      if (pageViewKey !== lastPageViewKey) {
        lastPageViewKey = pageViewKey;
        postEvent("page_view");
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAttribution, { once: true });
    } else {
      initAttribution();
    }
    document.addEventListener("astro:page-load", initAttribution);
  })();
</script>
