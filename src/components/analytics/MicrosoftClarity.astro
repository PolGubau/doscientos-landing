---
/**
 * Microsoft Clarity
 * Heatmaps + grabaciones de sesión + click maps , gratis y sin límites
 * Se integra automáticamente con GA4
 * Crea cuenta en: https://clarity.microsoft.com
 */

const CLARITY_ID = import.meta.env.PUBLIC_CLARITY_ID;
const isDev = import.meta.env.DEV;

if (isDev) {
  console.log("🔥 Microsoft Clarity disabled in development");
}
---

{
  !isDev && CLARITY_ID && (
    <script is:inline define:vars={{ CLARITY_ID }}>
      window.CLARITY_ID_PENDING = CLARITY_ID;
    </script>
  )
}
