---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import { ClientRouter } from "astro:transitions";
import { getLangFromUrl } from "~/shared/i18n/utils";
import { getMetadata } from "../shared/lib/constants";
import "../styles/global.css";
// Section/title scroll-reveal styles (pure CSS). Loaded after global.css so
// the library's [data-state="visible"] rule wins over any equal-specificity
// resting rule. Hero stays GSAP-controlled (see global.css #hero override).
import "@polgubau/astro-reveal/styles";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const lang = getLangFromUrl(Astro.url);

const metadata = getMetadata();

const {
  title = metadata.title,
  description = metadata.description,
  image = "/og-image.png",
} = Astro.props;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

// Generate alternate language URL (single-locale site)
const alternateUrl = new URL(
  Astro.url.pathname.replace(/^\/(ca|en)/, ""),
  Astro.site,
);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- Favicons -->
<link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="doscientos" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<link rel="manifest" href="/site.webmanifest" />

<!-- PWA Meta Tags -->
<meta name="mobile-web-app-capable" content="yes" />
<meta name="application-name" content="doscientos" />
<meta name="theme-color" content="#0c110b" />
<meta name="msapplication-TileColor" content="#bdff7b" />
<meta name="msapplication-config" content="/browserconfig.xml" />

<link rel="sitemap" href="/sitemap.xml" />
<link rel="me" href="https://brandfetch.com/doscientos.es" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={title}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta name="twitter:card" content="summary_large_image" />
{
  googleSiteVerification && (
    <meta name="google-site-verification" content={googleSiteVerification} />
  )
}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Alternate Language URLs (hreflang) -->
<link rel="alternate" hreflang="es" href={alternateUrl} />
<link rel="alternate" hreflang="x-default" href={alternateUrl} />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="language" content={lang} />
<ClientRouter />
