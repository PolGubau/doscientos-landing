---
import SectionHeader from "~/components/ui/SectionHeader.astro";
import ProjectsRail from "~/features/projects/ui/ProjectsRail.astro";
import { getProjects } from "~/shared/lib/collections";

const projects = await getProjects(4);
---

<section id="cases" class="landing-section">
  <SectionHeader
    title="Casos y productos en producción"
    description="MVPs lanzados, sistemas migrados, automatizaciones activas y herramientas públicas que ya están en uso."
    linkText="Ver todos"
    linkHref="/projects"
  />

  <div class="w-full">
    <ProjectsRail projects={projects} />
  </div>
</section>
