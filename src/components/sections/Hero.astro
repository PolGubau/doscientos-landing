---
import { copy } from "~/shared/lib/copy";
import Button from "../ui/Button.astro";
import HeroOrbital from "./HeroOrbital.astro";

const { hero } = copy;
---

<section
  id="hero"
  class="relative flex flex-col justify-center px-6 items-center min-h-[100svh]"
>
  <!-- Title sits in the middle of the orbital ring; fades out on scroll -->
  <div
    id="hero-content"
    class="relative z-20 flex flex-col items-center w-full"
  >
    <!-- Main title con bounce impactante -->
    <h1
      data-reveal="scale"
      data-init
      data-speed="fast"
      data-easing="bounce"
      data-delay="100"
      class="text-3xl sm:text-3xl max-md:max-w-xl text-balance md:max-w-xl text-center md:text-3xl font-medium tracking-tight text-foreground"
    >
      {hero.title}
    </h1>
  </div>

  <!--
    Subtitle + CTAs assemble in at the top as the ring grows on scroll
    (revealed by orbital.ts). data-reveal hides it from first paint; on desktop
    it is top-anchored, on mobile (no scroll choreography) it flows under the
    title and orbital.ts reveals it statically.
  -->
  <div
    id="hero-scroll-reveal"
    data-reveal
    data-init
    class="relative md:absolute md:inset-x-0 md:top-0 z-20 flex flex-col gap-6 md:gap-10 items-center w-full px-6 mt-8 md:mt-0 md:pt-24 lg:pt-32"
  >
    <!-- Subtitle -->
    <div class="text-muted-foreground max-w-xl text-center lg:text-lg">
      {hero.subtitle}
    </div>

    <!-- CTA -->
    <div class="pt-2 md:pt-4 flex flex-col items-center gap-4 w-full">
      <div
        class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center items-center w-full max-w-xs sm:max-w-none"
      >
        <a href={`/contact`} id="hero-cta-primary" class="w-full sm:w-auto">
          <Button withArrow class="w-full sm:w-fit">
            {hero.cta}
          </Button>
        </a>
        <a href="/projects" id="hero-cta-secondary" class="w-full sm:w-auto">
          <Button variant="outline" class="w-full sm:w-fit"
            >Ver proyectos</Button
          >
        </a>
      </div>

      <script is:inline>
        ["hero-cta-primary", "hero-cta-secondary"].forEach((id) => {
          document.getElementById(id)?.addEventListener("click", () => {
            if ("gtag" in window) {
              window.gtag("event", "cta_click", {
                event_category: "engagement",
                event_label: id,
              });
            }
          });
        });
      </script>
    </div>
  </div>

  <!-- Orbital ring — absolutely positioned, sits behind the hero content (z-10) -->
  <HeroOrbital />
</section>
