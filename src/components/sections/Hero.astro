---
import {
  Calendar,
  CheckCheck,
  FileSpreadsheet,
  FileText,
  Folder,
  Image,
  Mail,
  MessageCircle,
  NotebookPen,
  PenLine,
  Receipt,
  StickyNote,
} from "@lucide/astro";
import { copy } from "~/shared/lib/copy";
import Button from "../ui/Button.astro";
import SectionTag from "../ui/SectionTag.astro";

const { hero } = copy;

const ICONS = {
  "file-spreadsheet": FileSpreadsheet,
  folder: Folder,
  "notebook-pen": NotebookPen,
  "pen-line": PenLine,
  mail: Mail,
  "message-circle": MessageCircle,
  calendar: Calendar,
  receipt: Receipt,
  "file-text": FileText,
  "sticky-note": StickyNote,
} as const;

// Each chip's thumbnail (above the filename caption) is rendered differently
// depending on what it represents, so the cloud reads as a mix of real
// attachments instead of identical icon pills — like a chat's media preview:
// - "mail": a draft being written (to/subject rows + body + blinking cursor)
// - "chat": a WhatsApp-style photo attachment (image + timestamp/read ticks)
// - "grid": a spreadsheet/calendar cell grid
// - "lines": a generic document preview (text bars + large watermark icon)
const KINDS = {
  "file-spreadsheet": "grid",
  folder: "lines",
  "notebook-pen": "lines",
  "pen-line": "lines",
  mail: "mail",
  "message-circle": "chat",
  calendar: "grid",
  receipt: "lines",
  "file-text": "lines",
  "sticky-note": "lines",
} as const;

// Which cells light up in the "grid" preview — purely decorative.
const GRID_ACTIVE = new Set([1, 4, 7]);

// Art-directed scatter positions (% within #hero-stage) for the chaos chips.
// Kept clear-ish of the centre and inset from the stage edges — these cards
// are bigger than the old icon pills — so nothing clips against the
// overflow-hidden hero, and so the software window reads cleanly once it
// forms there. Vertically compressed towards the middle (20%-78%) so the
// cloud sits centred in the stage instead of stretching close to its top/
// bottom edges. Cycles if more/fewer chaos items are ever added in copy.ts.
const POSITIONS = [
  { left: "10%", top: "25%" },
  { left: "23%", top: "67%" },
  { left: "46%", top: "20%" },
  { left: "74%", top: "25%" },
  { left: "89%", top: "55%" },
  { left: "14%", top: "45%" },
  { left: "58%", top: "75%" },
  { left: "82%", top: "77%" },
  { left: "36%", top: "78%" },
  { left: "90%", top: "34%" },
];

const chaos = hero.stage.chaos.map((item, i) => ({
  ...item,
  Icon: ICONS[item.icon as keyof typeof ICONS],
  kind: KINDS[item.icon as keyof typeof KINDS],
  pos: POSITIONS[i % POSITIONS.length],
}));
---

<section
  id="hero"
    class="relative flex flex-col px-6 items-center justify-center min-h-[100svh] pt-28 pb-8 md:pt-36 gap-4 md:gap-5 overflow-hidden"
>
  <div class="relative z-20 max-w-4xl text-center">
    <h1 class="hero-title text-balance">{hero.title}</h1>
    <p class="mt-4 max-w-2xl mx-auto text-base md:text-lg text-muted-foreground text-pretty">
      {hero.subtitle}
    </p>
  </div>

  <!--
    Caption stack: three short beats crossfade in sync with the storyboard
    below as the visitor scrolls.
    Absolutely-stacked so the swap never shifts layout. Only the first is
    visible at rest (CSS default) — that is also the mobile/reduced-motion
    fallback, no JS required. aria-live announces each change to screen
    readers.
  -->
  <div
    aria-live="polite"
    class="relative z-20 h-10 md:h-12 w-full flex items-center justify-center shrink-0 px-4"
  >
    {
      hero.stage.captions.map((caption) => (
        <SectionTag class="hero-caption absolute inset-0 flex items-center justify-center text-center !z-30">
          {caption}
        </SectionTag>
      ))
    }
  </div>

  <!--
    Storyboard stage: scattered tool chips converge into a single software
    window as the visitor scrolls (see hero-stage.ts). Desktop: pinned +
    scrubbed choreography. Mobile: chaos chips are hidden via CSS and the
    window renders as a static, finished illustration — no JS, no pin.
  -->
  <div
    id="hero-stage"
    class="relative z-10 w-full max-w-5xl mx-auto flex items-center justify-center min-h-[290px] md:min-h-[380px]"
    aria-hidden="true"
  >
    <div id="hero-lines" class="absolute inset-0"></div>

    <!--
      Lightweight loading placeholder: the chaos chips below start hidden
      (opacity 0 by default in CSS, see .hero-chaos-inner) until the
      dynamically-imported GSAP chunk finishes loading and plays their
      entrance, so on a slow connection the stage would otherwise read as an
      empty hole in the page. This is purely CSS-driven (delayed fade-in,
      then auto fade-out via @keyframes hero-loader-lifecycle below) so it
      can never get stuck even if the script fails to load, and is also
      hidden immediately by hero-stage.ts the instant the real entrance
      runs. Not shown on mobile/reduced-motion — see the media query at the
      bottom of this file — since those paths never show the chaos stage.
    -->
    <div id="hero-loader" aria-hidden="true">
      <span class="hero-loader-dot"></span>
      <span class="hero-loader-dot"></span>
      <span class="hero-loader-dot"></span>
    </div>

    <div id="hero-chaos" class="absolute inset-0">
      {
        chaos.map(({ Icon, label, pos, color, kind }) => (
          <div
            class="hero-chaos-item"
            style={`left:${pos.left};top:${pos.top};--chip-color:${color}`}
          >
            <div class="hero-chaos-inner">
              <div class="hero-chaos-preview">
                {kind === "mail" && (
                  <div class="hero-chaos-mail">
                    <span class="hero-chaos-mail-row">
                      <span class="hero-chaos-mail-label">Para</span>
                      <span class="hero-chaos-bar" style="width:64%" />
                    </span>
                    <span class="hero-chaos-mail-row">
                      <span class="hero-chaos-mail-label">Asunto</span>
                      <span class="hero-chaos-bar" style="width:48%" />
                    </span>
                    <span
                      class="hero-chaos-bar hero-chaos-bar--body"
                      style="width:88%"
                    />
                    <span class="hero-chaos-mail-row">
                      <span
                        class="hero-chaos-bar hero-chaos-bar--body"
                        style="width:36%"
                      />
                      <span class="hero-chaos-cursor" />
                    </span>
                  </div>
                )}
                {kind === "chat" && (
                  <div class="hero-chaos-chat">
                    <div class="hero-chaos-chat-photo">
                      <Image class="size-6" />
                    </div>
                    <div class="hero-chaos-chat-meta">
                      <span>12:04</span>
                      <CheckCheck class="size-3" />
                    </div>
                  </div>
                )}
                {kind === "grid" && (
                  <div class="hero-chaos-grid">
                    {Array.from({ length: 9 }).map((_, gi) => (
                      <span
                        class={`hero-chaos-cell${GRID_ACTIVE.has(gi) ? " is-active" : ""}`}
                      />
                    ))}
                  </div>
                )}
                {kind === "lines" && (
                  <div class="hero-chaos-lines">
                    <Icon class="hero-chaos-watermark" />
                    <span class="hero-chaos-bar" style="width:85%" />
                    <span class="hero-chaos-bar" style="width:60%" />
                    <span class="hero-chaos-bar" style="width:72%" />
                  </div>
                )}
                <div class="hero-chaos-fade" />
                <span class="hero-chaos-label">{label}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div id="hero-window" class="hero-window">
      <div class="hero-window-bar">
        <span class="hero-window-dot"></span>
        <span class="hero-window-dot"></span>
        <span class="hero-window-dot"></span>
        <span class="hero-window-title">{hero.stage.window.label}</span>
      </div>
      <div class="hero-window-body">
        {
          hero.stage.window.rows.map((row) => (
            <div class="hero-window-row">{row}</div>
          ))
        }
        <div class="hero-window-metric">
          <span
            class="hero-window-metric-value"
            data-count={hero.stage.window.metricValue}
            data-count-suffix={hero.stage.window.metricSuffix}
            >{hero.stage.window.metricValue}{
              hero.stage.window.metricSuffix
            }</span
          >
          <span class="hero-window-metric-label"
            >{hero.stage.window.metricLabel}</span
          >
        </div>
      </div>
    </div>

  </div>

  <!--
    CTA stays visible from the first frame. The animation earns the click by
    showing what changes, rather than hiding the action until the end.
  -->
  <div
    id="hero-content"
    class="relative z-20 flex flex-col items-center text-center gap-4 md:gap-5 max-w-2xl mx-auto shrink-0"
  >
    <div
      id="hero-scroll-reveal"
      class="flex flex-col gap-4 md:gap-6 items-center w-full"
    >
      <div class="flex flex-col items-center gap-4 w-full">
        <div
          class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center items-center w-full max-w-xs sm:max-w-none"
        >
          <a href={`/contact`} id="hero-cta-primary" class="w-full sm:w-auto">
            <Button withArrow class="w-full sm:w-fit">
              Revisar mi proceso
            </Button>
          </a>
          <a href="/projects" id="hero-cta-secondary" class="w-full sm:w-auto">
            <Button variant="outline" class="w-full sm:w-fit"
              >Ver un caso parecido</Button
            >
          </a>
        </div>

        <script is:inline>
          ["hero-cta-primary", "hero-cta-secondary"].forEach((id) => {
            document.getElementById(id)?.addEventListener("click", () => {
              if ("gtag" in window) {
                window.gtag("event", "cta_click", {
                  event_category: "engagement",
                  event_label: id,
                });
              }
            });
          });
        </script>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /*
   * .hero-caption is applied as a class prop to <SectionTag>, which renders
   * its own <span> inside SectionTag.astro — a different file. Astro's
   * style scoping only instruments elements written directly in the file
   * that owns the <style> block, so a *scoped* rule here would never match
   * that <span> and Tailwind's `text-xs` (from SectionTag's own markup)
   * would silently win. Must be global to actually override it.
   */
  .hero-caption {
    opacity: 0;
    transition: none;
    font-size: 1.05rem !important;
    line-height: 1.3;
    font-weight: 600 !important;
    letter-spacing: normal !important;
    text-transform: none !important;
    color: var(--foreground) !important;
    /*
     * SectionTag's own markup hardcodes `w-fit` on this span. Combined with
     * the `absolute inset-0` we add here, top/left/right/bottom AND width
     * are all specified at once — CSS resolves that over-constrained box by
     * dropping `right` (ltr), so the span shrinks to fit its text and
     * anchors at left:0 instead of stretching to fill the caption row.
     * `justify-center`/`text-center` then have nothing to centre within,
     * since the box is already exactly as wide as the text. Forcing the
     * width back to 100% here restores the stretch so centring works.
     */
    width: 100% !important;
    height: 100% !important;
  }
  /*
   * The first caption is the very first thing a visitor reads, before any
   * JS has had a chance to run (dynamic-imported on desktop, entirely
   * skipped on reduced-motion) — so unlike the other two captions (which
   * only ever appear via hero-stage.ts's scrubbed crossfade) it must reveal
   * itself with a pure-CSS entrance rather than depending on GSAP.
   * Previously this was a static `opacity: 1`, which meant hero-stage.ts's
   * own entrance tween (gsap.from with immediateRender) had to snap it back
   * to hidden the instant its dynamically-imported chunk finished loading —
   * reading as "pops in fully formed, then vanishes, then replays" whenever
   * that import lagged even slightly behind first paint. Animating it here
   * instead makes the entrance identical (and immediate) regardless of JS
   * timing, so there's never a blank/flash gap — see the removed
   * gsap.from(captions[0]) in hero-stage.ts.
   */
  @keyframes hero-caption-intro {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  .hero-caption:first-child {
    opacity: 1;
    animation: hero-caption-intro 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s
      both;
  }

  @media (min-width: 768px) {
    .hero-caption {
      font-size: 1.5rem !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-caption:first-child {
      animation: none;
      opacity: 1;
    }
  }
</style>

<style>
  .hero-chaos-item {
    position: absolute;
    transform: translate(-50%, -50%);
  }

  .hero-chaos-inner {
    opacity: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 140px;
  }

  #hero-loader {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    pointer-events: none;
    opacity: 0;
    animation: hero-loader-lifecycle 2.2s ease forwards;
  }

  .hero-loader-dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: var(--muted-foreground);
    animation: hero-loader-bounce 0.9s ease-in-out infinite;
  }

  .hero-loader-dot:nth-child(2) {
    animation-delay: 0.15s;
  }

  .hero-loader-dot:nth-child(3) {
    animation-delay: 0.3s;
  }

  /*
   * Delayed fade-in (0-14%) means a fast load never shows the loader at
   * all — hero-stage.ts usually hides it within a frame or two of the
   * script executing. The fade-out at the end (72-100%) is the fallback
   * for when JS never runs at all (e.g. it fails to load): the loader
   * disappears on its own instead of spinning forever.
   */
  @keyframes hero-loader-lifecycle {
    0%,
    14% {
      opacity: 0;
    }
    28%,
    72% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes hero-loader-bounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    50% {
      transform: translateY(-5px);
      opacity: 1;
    }
  }

  /*
   * Single card: the "attachment preview" doubles as its own caption — the
   * filename/label sits directly over the animated content, faded in via
   * .hero-chaos-fade, instead of living in a separate pill underneath.
   * Taller than the old 4:3 thumbnail (which only had to fit the preview)
   * so the label has room to breathe over the gradient.
   */
  .hero-chaos-preview {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg, 0.85rem);
    overflow: hidden;
    background: color-mix(in srgb, var(--chip-color) 14%, var(--background));
    border: 1.5px solid color-mix(in srgb, var(--chip-color) 40%, var(--muted));
    box-shadow: var(--shadow-pastel-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
  }

  /* "lines" preview: generic document — a few text bars plus a large, faint
     icon watermark in the corner. */
  .hero-chaos-lines {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    width: 100%;
  }

  .hero-chaos-watermark {
    position: absolute;
    right: -0.35rem;
    bottom: -0.35rem;
    width: 2.6rem;
    height: 2.6rem;
    color: var(--chip-color);
    opacity: 0.22;
  }

  .hero-chaos-bar {
    display: block;
    height: 6px;
    border-radius: 9999px;
    background: color-mix(
      in srgb,
      var(--chip-color) 55%,
      var(--muted-foreground)
    );
    opacity: 0.55;
  }

  .hero-chaos-bar--body {
    opacity: 0.35;
  }

  /* "mail" preview: a draft being written. */
  .hero-chaos-mail {
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
    width: 100%;
  }

  .hero-chaos-mail-row {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .hero-chaos-mail-row .hero-chaos-bar {
    flex: 1;
  }

  .hero-chaos-mail-label {
    flex-shrink: 0;
    font-size: 0.52rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted-foreground);
  }

  .hero-chaos-cursor {
    flex-shrink: 0;
    width: 2px;
    height: 10px;
    background: var(--chip-color);
    animation: hero-chaos-caret 1s step-end infinite;
  }

  @keyframes hero-chaos-caret {
    50% {
      opacity: 0;
    }
  }

  /* "chat" preview: a WhatsApp-style photo attachment. */
  .hero-chaos-chat {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-chaos-chat-photo {
    width: 100%;
    height: 100%;
    border-radius: 0.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--chip-color) 65%, white),
      color-mix(in srgb, var(--chip-color) 35%, var(--background))
    );
  }

  .hero-chaos-chat-meta {
    position: absolute;
    right: 0.3rem;
    bottom: 0.28rem;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.08rem 0.32rem;
    border-radius: 9999px;
    background: rgb(0 0 0 / 0.35);
    color: white;
    font-size: 0.52rem;
    line-height: 1;
  }

  /* "grid" preview: spreadsheet / calendar cells. */
  .hero-chaos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.2rem;
    width: 100%;
    height: 100%;
  }

  .hero-chaos-cell {
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--chip-color) 16%, var(--background));
    border: 1px solid color-mix(in srgb, var(--chip-color) 30%, var(--muted));
  }

  .hero-chaos-cell.is-active {
    background: color-mix(in srgb, var(--chip-color) 55%, var(--background));
    border-color: var(--chip-color);
  }

  /*
   * Bottom fade: dissolves the animated preview into a solid tint so the
   * label reads clearly on top of it, like a media attachment's filename
   * overlaid on its own thumbnail instead of living in a separate pill.
   * z-index above .hero-chaos-lines (which sets z-index:1 on itself) so it
   * covers every preview variant, including the "lines" watermark icon.
   */
  .hero-chaos-fade {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 62%;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--background) 88%, var(--chip-color) 12%) 30%,
      transparent 100%
    );
  }

  .hero-chaos-label {
    position: absolute;
    z-index: 3;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.45rem;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: center;
  }

  #hero-lines {
    pointer-events: none;
  }

  .hero-chaos-line {
    position: absolute;
    height: 2px;
    border-radius: 9999px;
    background: linear-gradient(
      to right,
      var(--chip-color, var(--primary)),
      transparent
    );
    pointer-events: none;
  }

  #hero-window {
    opacity: 0;
    transform: translateY(16px) scale(0.85);
    width: min(380px, 90%);
    border-radius: var(--radius-xl);
    border: 1px solid var(--muted);
    background: var(--background);
    box-shadow: var(--shadow-pastel);
    overflow: hidden;
  }

  .hero-window-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--muted);
  }

  .hero-window-dot {
    size: 8px;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: var(--muted);
  }

  .hero-window-title {
    margin-left: 0.4rem;
    font-size: 0.7rem;
    color: var(--muted-foreground);
  }

  .hero-window-body {
    padding: 1rem 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .hero-window-row {
    opacity: 0;
    transform: translateY(8px);
    font-size: 0.8rem;
    color: var(--foreground);
    background: var(--muted);
    border-radius: var(--radius-md);
    padding: 0.5rem 0.65rem;
  }

  .hero-window-metric {
    margin-top: 0.4rem;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .hero-window-metric-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary);
  }

  .hero-window-metric-label {
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  /*
   * Payoff headline: absolute overlay over the same stage as #hero-window
   * (its sibling), so it can fade in as the window fades out in phase 4
   * without either ever affecting the other's layout. Anchored to the
   * *bottom* of the stage (not vertically centred) so it lands right above
   * the subtitle/CTA block in #hero-content below — a tall, vertically
   * centred stage would otherwise leave a large empty gap between the
   * headline and the subtitle in the hero's resting state.
   * Hidden by default (opacity 0) — hero-stage.ts is what reveals it.
   */
  #hero-payoff {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0 1rem 0.5rem;
    opacity: 0;
    pointer-events: none;
  }

  .hero-payoff-text {
    max-width: 46rem;
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-align: center;
    text-wrap: balance;
    color: var(--foreground);
  }

  @media (min-width: 768px) {
    .hero-payoff-text {
      font-size: 2.75rem;
    }
  }

  /*
   * Word-by-word entrance for the payoff headline (hero-stage.ts, phase 4):
   * each word is masked by an overflow-hidden outer span while its inner
   * span is the one hero-stage.ts actually transforms (yPercent/rotateX),
   * so every word rises and rotates in from below its own mask instead of
   * the whole line just fading/popping in as one block.
   */
  .payoff-word-outer {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    perspective: 600px;
  }

  .payoff-word-inner {
    display: inline-block;
    transform-origin: bottom center;
    will-change: transform;
  }

  /*
   * Mobile never pins/scrubs the stage, and prefers-reduced-motion skips
   * hero-stage.ts entirely (see animations.ts) — in both cases the GSAP
   * timeline that would normally converge the chaos into the window and
   * then swap it for the payoff headline never runs. Force the finished
   * state here: chaos hidden, window hidden, payoff headline shown — it's
   * the single most important line, so it's what mobile visitors see
