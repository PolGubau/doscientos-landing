---
import { Calendar, Check, FileText, Mail, MessageSquare } from "@lucide/astro";
import Folder from "@lucide/astro/icons/folder";
import PencilLine from "@lucide/astro/icons/pencil-line";
import { copy } from "~/shared/lib/copy";
import { branding } from "~/config/branding";

const { hero } = copy;

const ICONS = {
  "file-spreadsheet": FileText,
  folder: Folder,
  "notebook-pen": PencilLine,
  "pen-line": PencilLine,
  mail: Mail,
  "message-circle": MessageSquare,
  calendar: Calendar,
  receipt: FileText,
  "file-text": FileText,
  "sticky-note": FileText,
} as const;

// Each chip's thumbnail (above the filename caption) is rendered differently
// depending on what it represents, so the cloud reads as a mix of real
// attachments instead of identical icon pills — like a chat's media preview:
// - "mail": a draft being written (to/subject rows + body + blinking cursor)
// - "chat": a WhatsApp-style photo attachment (image + timestamp/read ticks)
// - "grid": a spreadsheet/calendar cell grid
// - "lines": a generic document preview (text bars + large watermark icon)
const KINDS = {
  "file-spreadsheet": "grid",
  folder: "lines",
  "notebook-pen": "lines",
  "pen-line": "lines",
  mail: "mail",
  "message-circle": "chat",
  calendar: "grid",
  receipt: "lines",
  "file-text": "lines",
  "sticky-note": "lines",
} as const;

// Which cells light up in the "grid" preview — purely decorative.
const GRID_ACTIVE = new Set([1, 4, 7]);

// Art-directed scatter positions (% within #hero-stage) for the chaos chips.
// Kept clear-ish of the centre and inset from the stage edges — these cards
// are bigger than the old icon pills — so nothing clips against the
// overflow-hidden hero, and so the software window reads cleanly once it
// forms there. Vertically compressed towards the middle (20%-78%) so the
// cloud sits centred in the stage instead of stretching close to its top/
// bottom edges. Cycles if more/fewer chaos items are ever added in copy.ts.
const POSITIONS = [
  { left: "10%", top: "25%" },
  { left: "23%", top: "67%" },
  { left: "46%", top: "20%" },
  { left: "74%", top: "25%" },
  { left: "89%", top: "55%" },
  { left: "14%", top: "45%" },
  { left: "58%", top: "75%" },
  { left: "82%", top: "77%" },
  { left: "36%", top: "78%" },
  { left: "90%", top: "34%" },
];

const chaos = hero.stage.chaos.map((item, i) => ({
  ...item,
  Icon: ICONS[item.icon as keyof typeof ICONS],
  kind: KINDS[item.icon as keyof typeof KINDS],
  pos: POSITIONS[i % POSITIONS.length],
}));
---

<section
  id="hero"
  class="hero-section relative flex flex-col px-6 items-center justify-start min-h-[calc(100svh-4rem)] pt-8 pb-8 md:pt-8 gap-7 md:gap-8 overflow-hidden"
>
  <div class="hero-intro relative z-20 max-w-3xl text-center">
    <p class="hero-eyebrow">Software a medida y automatización para PYMEs</p>
    <h1 class="hero-title text-balance" data-hero-static="true">
      {hero.title}
    </h1>
    <p
      class="hero-subtitle mt-4 max-w-xl mx-auto text-base md:text-lg text-muted-foreground text-balance"
    >
      {hero.subtitle}
    </p>
  </div>

  <div
    id="hero-content"
    class="relative z-20 flex flex-col items-center text-center max-w-2xl mx-auto shrink-0"
  >
    <div id="hero-scroll-reveal" class="flex flex-col items-center w-full">
      <div
        class="flex flex-col sm:flex-row gap-3 justify-center items-center w-full max-w-xs sm:max-w-none"
      >
        <a
          href="/diagnostico?ref=home-hero"
          id="hero-cta-primary"
          class="hero-cta hero-cta--primary w-full sm:w-auto"
        >
          <Calendar class="size-3.5" aria-hidden="true" />
          {hero.cta}
        </a>
        <a
          href={branding.contact.calCom.bookingUrl}
          id="hero-cta-secondary"
          class="hero-cta hero-cta--secondary w-full sm:w-auto"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            aria-hidden="true"
            class="h-3.5 w-auto shrink-0"
            viewBox="0 0 87.5 72"
            fill="none"
          >
            <path
              fill="#00832d"
              d="M49.5 36l8.53 9.75 11.47 7.33 2-17.02-2-16.64-11.69 6.44z"
            ></path>
            <path
              fill="#0066da"
              d="M0 51.5V66c0 3.315 2.685 6 6 6h14.5l3-10.96-3-9.54-9.95-3z"
            ></path>
            <path fill="#e94235" d="M20.5 0L0 20.5l10.55 3 9.95-3 2.95-9.41z"
            ></path>
            <path fill="#2684fc" d="M20.5 20.5H0v31h20.5z"></path>
            <path
              fill="#00ac47"
              d="M82.6 8.68L69.5 19.42v33.66l13.16 10.79c1.97 1.54 4.85.135 4.85-2.37V11c0-2.535-2.945-3.925-4.91-2.32zM49.5 36v15.5h-29V72h43c3.315 0 6-2.685 6-6V53.08z"
            ></path>
            <path
              fill="#ffba00"
              d="M63.5 0h-43v20.5h29V36l20-16.57V6c0-3.315-2.685-6-6-6z"></path>
          </svg>
          Agendar videollamada
        </a>
      </div>
      <p class="hero-cta-note">{hero.ctaNote}</p>

      <script is:inline>
        ["hero-cta-primary", "hero-cta-secondary"].forEach((id) => {
          document.getElementById(id)?.addEventListener("click", () => {
            if ("gtag" in window) {
              window.gtag("event", "cta_click", {
                event_category: "engagement",
                event_label: id,
              });
            }
          });
        });
      </script>
    </div>
  </div>

  <!--
    Storyboard stage: scattered tool chips converge into a single software
    window as the visitor scrolls (see hero-stage.ts). Desktop: pinned +
    scrubbed choreography. Mobile: chaos chips are hidden via CSS and the
    window renders as a static, finished illustration — no JS, no pin.
  -->
  <div
    id="hero-stage"
    class="relative z-10 w-full max-w-5xl mx-auto flex items-center justify-center min-h-[230px] md:min-h-[300px]"
    aria-hidden="true"
  >
    <div id="hero-lines" class="absolute inset-0"></div>

    <div id="hero-chaos" class="absolute inset-0">
      {
        chaos.map(({ Icon, label, pos, color, kind }) => (
          <div
            class="hero-chaos-item"
            style={`left:${pos.left};top:${pos.top};--chip-color:${color}`}
          >
            <div class="hero-chaos-inner">
              <div class="hero-chaos-preview">
                {kind === "mail" && (
                  <div class="hero-chaos-mail">
                    <span class="hero-chaos-mail-row">
                      <span class="hero-chaos-mail-label">Para</span>
                      <span class="hero-chaos-bar" style="width:64%" />
                    </span>
                    <span class="hero-chaos-mail-row">
                      <span class="hero-chaos-mail-label">Asunto</span>
                      <span class="hero-chaos-bar" style="width:48%" />
                    </span>
                    <span
                      class="hero-chaos-bar hero-chaos-bar--body"
                      style="width:88%"
                    />
                    <span class="hero-chaos-mail-row">
                      <span
                        class="hero-chaos-bar hero-chaos-bar--body"
                        style="width:36%"
                      />
                      <span class="hero-chaos-cursor" />
                    </span>
                  </div>
                )}
                {kind === "chat" && (
                  <div class="hero-chaos-chat">
                    <div class="hero-chaos-chat-photo">
                      <span class="size-6 rounded bg-primary/20" />
                    </div>
                    <div class="hero-chaos-chat-meta">
                      <span>12:04</span>
                      <Check class="size-3" />
                    </div>
                  </div>
                )}
                {kind === "grid" && (
                  <div class="hero-chaos-grid">
                    {Array.from({ length: 9 }).map((_, gi) => (
                      <span
                        class={`hero-chaos-cell${GRID_ACTIVE.has(gi) ? " is-active" : ""}`}
                      />
                    ))}
                  </div>
                )}
                {kind === "lines" && (
                  <div class="hero-chaos-lines">
                    <Icon class="hero-chaos-watermark" />
                    <span class="hero-chaos-bar" style="width:85%" />
                    <span class="hero-chaos-bar" style="width:60%" />
                    <span class="hero-chaos-bar" style="width:72%" />
                  </div>
                )}
                <div class="hero-chaos-fade" />
                <span class="hero-chaos-label">{label}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div id="hero-window" class="hero-window">
      <div class="hero-window-bar">
        <span class="hero-window-dot"></span>
        <span class="hero-window-dot"></span>
        <span class="hero-window-dot"></span>
        <span class="hero-window-title">{hero.stage.window.label}</span>
      </div>
      <div class="hero-window-body">
        {
          hero.stage.window.rows.map((row) => (
            <div class="hero-window-row">
              <span>{row}</span>
              <span class="hero-window-row-status" aria-hidden="true">
                <span class="hero-window-row-loader" />
                <svg
                  class="hero-window-row-check"
                  viewBox="0 0 16 16"
                  fill="none"
                >
                  <path d="m3.25 8.25 3 3 6.5-6.5" />
                </svg>
              </span>
            </div>
          ))
        }
        <div class="hero-window-metric">
          <span
            class="hero-window-metric-value"
            data-count={hero.stage.window.metricValue}
            data-count-suffix={hero.stage.window.metricSuffix}
            >{hero.stage.window.metricValue}{
              hero.stage.window.metricSuffix
            }</span
          >
          <span class="hero-window-metric-label"
            >{hero.stage.window.metricLabel}</span
          >
        </div>
      </div>
      <div id="hero-window-flow" aria-hidden="true">
        <span class="hero-window-flow-line"></span>
        <svg class="hero-window-flow-packet" viewBox="0 0 16 16" fill="none">
          <path d="M3.5 2.5h6l3 3v8H3.5z"></path>
          <path d="M9.5 2.5v3h3M5.5 8h5M5.5 10.5h5"></path>
        </svg>
        <span class="hero-window-flow-line"></span>
        <svg class="hero-window-flow-packet" viewBox="0 0 16 16" fill="none">
          <path d="M3.5 2.5h6l3 3v8H3.5z"></path>
          <path d="M9.5 2.5v3h3M5.5 8h5M5.5 10.5h5"></path>
        </svg>
      </div>
    </div>
    <div id="hero-cursor" aria-hidden="true">
      <svg class="hero-cursor-pointer" viewBox="0 0 20 25" fill="none">
        <path
          d="M3.2 2.8c-.78-.42-1.68.25-1.47 1.11l4.57 18.5c.2.83 1.35.96 1.74.2l2.35-4.67 4.86-1.38c.8-.23.96-1.29.26-1.74L3.2 2.8Z"
        ></path>
      </svg>
      <span class="hero-cursor-label">Tú</span>
    </div>
  </div>
</section>

<style>
  .hero-title {
    max-width: 36rem;
    margin: 0 auto;
    font-size: clamp(2.2rem, 3.4vw, 3.2rem);
    font-weight: 750;
    line-height: 1.04;
    letter-spacing: -0.045em;
    color: var(--foreground);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    margin-bottom: 1.15rem;
    padding: 0.35rem 0.65rem;
    border-radius: 9999px;
    background: var(--background);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--foreground) 8%, transparent);
    color: var(--muted-foreground);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 2.85rem;
    padding: 0.7rem 1rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease;
  }

  .hero-cta:hover {
    transform: translateY(-1px);
  }

  .hero-cta:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }

  .hero-cta--primary {
    background: var(--foreground);
    box-shadow: 0 8px 20px
      color-mix(in srgb, var(--foreground) 14%, transparent);
    color: var(--background);
  }

  .hero-cta--primary:hover {
    background: color-mix(in srgb, var(--foreground) 91%, var(--background));
    box-shadow: 0 10px 24px
      color-mix(in srgb, var(--foreground) 18%, transparent);
  }

  .hero-cta--secondary {
    background: var(--background);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--foreground) 8%, transparent);
    color: var(--foreground);
  }

  .hero-cta--secondary:hover {
    background: color-mix(in srgb, var(--foreground) 4%, var(--background));
  }

  @media (min-width: 640px) {
    .hero-cta {
      gap: 0.45rem;
      min-height: 2.3rem;
      padding: 0.52rem 0.8rem;
      font-size: 0.78rem;
    }
  }

  .hero-cta-note {
    margin-top: 0.85rem;
    color: var(--muted-foreground);
    font-size: 0.78rem;
  }

  .hero-title,
  .hero-subtitle,
  #hero-content {
    animation: hero-content-enter 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-title {
    animation-delay: 0.08s;
  }

  #hero-content {
    animation-delay: 0.24s;
  }

  .hero-subtitle {
    animation-delay: 0.16s;
  }

  @keyframes hero-content-enter {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    #hero-content,
    .hero-subtitle {
      animation: none;
    }
  }
</style>

<style>
  .hero-chaos-item {
    position: absolute;
    transform: translate(-50%, -50%);
  }

  .hero-chaos-inner {
    opacity: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 140px;
  }

  /*
   * Single card: the "attachment preview" doubles as its own caption — the
   * filename/label sits directly over the animated content, faded in via
   * .hero-chaos-fade, instead of living in a separate pill underneath.
   * Taller than the old 4:3 thumbnail (which only had to fit the preview)
   * so the label has room to breathe over the gradient.
   */
  .hero-chaos-preview {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg, 0.85rem);
    overflow: hidden;
    background: color-mix(in srgb, var(--chip-color) 14%, var(--background));
    border: 1.5px solid color-mix(in srgb, var(--chip-color) 40%, var(--muted));
    box-shadow: var(--shadow-pastel-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
  }

  /* "lines" preview: generic document — a few text bars plus a large, faint
     icon watermark in the corner. */
  .hero-chaos-lines {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    width: 100%;
  }

  .hero-chaos-watermark {
    position: absolute;
    right: -0.35rem;
    bottom: -0.35rem;
    width: 2.6rem;
    height: 2.6rem;
    color: var(--chip-color);
    opacity: 0.22;
  }

  .hero-chaos-bar {
    display: block;
    height: 6px;
    border-radius: 9999px;
    background: color-mix(
      in srgb,
      var(--chip-color) 55%,
      var(--muted-foreground)
    );
    opacity: 0.55;
  }

  .hero-chaos-bar--body {
    opacity: 0.35;
  }

  /* "mail" preview: a draft being written. */
  .hero-chaos-mail {
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
    width: 100%;
  }

  .hero-chaos-mail-row {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .hero-chaos-mail-row .hero-chaos-bar {
    flex: 1;
  }

  .hero-chaos-mail-label {
    flex-shrink: 0;
    font-size: 0.52rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted-foreground);
  }

  .hero-chaos-cursor {
    flex-shrink: 0;
    width: 2px;
    height: 10px;
    background: var(--chip-color);
    animation: hero-chaos-caret 1s step-end infinite;
  }

  @keyframes hero-chaos-caret {
    50% {
      opacity: 0;
    }
  }

  /* "chat" preview: a WhatsApp-style photo attachment. */
  .hero-chaos-chat {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-chaos-chat-photo {
    width: 100%;
    height: 100%;
    border-radius: 0.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--chip-color) 65%, white),
      color-mix(in srgb, var(--chip-color) 35%, var(--background))
    );
  }

  .hero-chaos-chat-meta {
    position: absolute;
    right: 0.3rem;
    bottom: 0.28rem;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.08rem 0.32rem;
    border-radius: 9999px;
    background: rgb(0 0 0 / 0.35);
    color: white;
    font-size: 0.52rem;
    line-height: 1;
  }

  /* "grid" preview: spreadsheet / calendar cells. */
  .hero-chaos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.2rem;
    width: 100%;
    height: 100%;
  }

  .hero-chaos-cell {
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--chip-color) 16%, var(--background));
    border: 1px solid color-mix(in srgb, var(--chip-color) 30%, var(--muted));
  }

  .hero-chaos-cell.is-active {
    background: color-mix(in srgb, var(--chip-color) 55%, var(--background));
    border-color: var(--chip-color);
  }

  /*
   * Bottom fade: dissolves the animated preview into a solid tint so the
   * label reads clearly on top of it, like a media attachment's filename
   * overlaid on its own thumbnail instead of living in a separate pill.
   * z-index above .hero-chaos-lines (which sets z-index:1 on itself) so it
   * covers every preview variant, including the "lines" watermark icon.
   */
  .hero-chaos-fade {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 62%;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--background) 88%, var(--chip-color) 12%) 30%,
      transparent 100%
    );
  }

  .hero-chaos-label {
    position: absolute;
    z-index: 3;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.45rem;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: center;
  }

  #hero-lines {
    pointer-events: none;
  }

  .hero-chaos-line {
    position: absolute;
    height: 3px;
    border-radius: 9999px;
    background: linear-gradient(
      to right,
      var(--chip-color, var(--primary)),
      color-mix(in srgb, var(--chip-color, var(--primary)) 25%, transparent)
    );
    pointer-events: none;
  }

  #hero-window {
    position: relative;
    opacity: 0;
    transform: translateY(16px) scale(0.85);
    width: min(420px, 90%);
    border-radius: var(--radius-xl);
    border: 1px solid color-mix(in srgb, var(--primary) 25%, var(--muted));
    background: var(--background);
    box-shadow:
      0 24px 70px color-mix(in srgb, var(--primary) 22%, transparent),
      var(--shadow-pastel);
    overflow: hidden;
  }

  .hero-window-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--muted);
  }

  .hero-window-dot {
    size: 8px;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: var(--muted);
  }

  .hero-window-title {
    margin-left: 0.4rem;
    font-size: 0.7rem;
    color: var(--muted-foreground);
  }

  .hero-window-body {
    padding: 1rem 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .hero-window-row {
    opacity: 0;
    transform: translateY(8px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--foreground);
    background: var(--muted);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    padding: 0.5rem 0.65rem;
  }

  .hero-window-row-status {
    position: relative;
    flex: 0 0 1.15rem;
    width: 1.15rem;
    height: 1.15rem;
  }

  .hero-window-row-loader,
  .hero-window-row-check {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(0.5);
  }

  .hero-window-row-loader {
    border: 2px solid color-mix(in srgb, var(--brand-lime) 24%, var(--muted));
    border-top-color: var(--brand-lime);
    border-radius: 9999px;
  }

  .hero-window-row-check {
    border-radius: 9999px;
    background: var(--brand-lime);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke: var(--primary);
    stroke-width: 2.5;
  }

  #hero-window-flow {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .hero-window-flow-line {
    position: absolute;
    height: 2px;
    width: 1px;
    border-radius: 9999px;
    opacity: 0;
    background: linear-gradient(
      to right,
      var(--brand-lime),
      color-mix(in srgb, var(--brand-lime) 25%, transparent)
    );
    transform-origin: 0 50%;
  }

  .hero-window-flow-packet {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 1rem;
    height: 1rem;
    padding: 0.12rem;
    border-radius: 0.28rem;
    background: var(--background);
