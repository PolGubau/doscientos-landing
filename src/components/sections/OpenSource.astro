---
import { ArrowUpRight, BadgeCheck, ShieldCheck, Sparkles } from "@lucide/astro";
import npmDownloads from "~/data/npm-downloads.json";

const downloads = new Intl.NumberFormat("es-ES").format(
  npmDownloads.totals.downloads,
);

const benefits = [
  {
    icon: ShieldCheck,
    title: "Base técnica mantenida",
    description:
      "Partimos de componentes propios para lo repetible, en lugar de improvisar las partes críticas en cada proyecto.",
  },
  {
    icon: BadgeCheck,
    title: "Nada es una caja negra",
    description:
      "Documentamos decisiones y mantenemos una parte de nuestras bases abierta para que pueda revisarse.",
  },
  {
    icon: Sparkles,
    title: "A medida donde importa",
    description:
      "Tu operativa, integraciones y ventajas de negocio se diseñan específicamente para tu empresa.",
  },
];
---

<section id="open-source" class="open-source-section landing-section">
  <div class="open-source-shell">
    <div class="open-source-intro" data-stagger="100">
      <span class="open-source-kicker" data-reveal="bottom"
        >BASE TÉCNICA ABIERTA</span
      >
      <h2 data-reveal="bottom" data-speed="normal" data-easing="smooth">
        No empezamos de cero donde no aporta valor.
      </h2>
      <p data-reveal="bottom" data-speed="normal" data-easing="soft">
        Construimos lo específico de tu negocio a medida. Para lo repetible,
        partimos de componentes propios, mantenidos y abiertos.
      </p>
      <p class="open-source-downloads" data-reveal="bottom" data-speed="fast">
        <strong>{downloads}</strong>
        <span>descargas acumuladas de nuestras herramientas abiertas</span>
      </p>
      <a
        href="/open-source"
        class="open-source-link"
        data-reveal="bottom"
        data-speed="fast"
        data-easing="soft"
      >
        Conocer nuestra base técnica <ArrowUpRight
          class="size-4"
          aria-hidden="true"
        />
      </a>
    </div>

    <div class="open-source-panel" data-stagger="100">
      <div
        class="open-source-principle"
        data-reveal="bottom"
        data-easing="smooth"
      >
        <span>La regla</span>
        <p>Estándar donde da seguridad. A medida donde da ventaja.</p>
      </div>
      <ul class="open-source-benefits">
        {
          benefits.map(({ icon: Icon, title, description }, index) => (
            <li data-reveal="bottom" data-speed="normal" data-easing="soft">
              <span class="open-source-benefit-number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="open-source-icon">
                <Icon class="size-5" aria-hidden="true" />
              </span>
              <div>
                <h3>{title}</h3>
                <p>{description}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="open-source-note" data-reveal="bottom" data-speed="fast">
        Para equipos técnicos: código, documentación y paquetes públicos
        disponibles.
      </p>
    </div>
  </div>
</section>

<style>
  .open-source-section {
    padding-block: clamp(3rem, 8vw, 7rem);
  }
  .open-source-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 7vw, 7rem);
    width: min(72rem, 100%);
    margin: 0 auto;
    align-items: center;
  }
  .open-source-intro {
    max-width: 34rem;
  }
  .open-source-kicker {
    color: var(--primary);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.13em;
  }
  .open-source-intro h2 {
    max-width: 13ch;
    margin: 0.8rem 0 1.25rem;
    color: var(--foreground);
    font-size: clamp(2.25rem, 4vw, 4.25rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }
  .open-source-intro > p {
    max-width: 31rem;
    margin: 0;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.65;
  }
  .open-source-downloads {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    width: fit-content;
    margin: 1.75rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--foreground) 14%, transparent);
  }
  .open-source-downloads strong {
    color: var(--primary);
    font-size: clamp(2rem, 3vw, 2.75rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }
  .open-source-downloads span {
    max-width: 14rem;
    color: var(--muted-foreground);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .open-source-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.5rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--foreground) 14%, transparent);
    border-radius: 999px;
    color: var(--foreground);
    font-size: 0.88rem;
    font-weight: 750;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }
  .open-source-link:hover {
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary) 8%, var(--background));
    color: var(--primary);
  }
  .open-source-link:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }
  .open-source-link :global(svg) {
    transition: transform 180ms ease;
  }
  .open-source-link:hover :global(svg) {
    transform: translate(0.14rem, -0.14rem);
  }
  .open-source-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--foreground) 12%, transparent);
    border-radius: 1.75rem;
    background: var(--foreground);
    box-shadow:
      var(--shadow-pastel),
      0 1.5rem 3rem color-mix(in srgb, var(--foreground) 12%, transparent);
  }
  .open-source-panel::before {
    position: absolute;
    top: -7rem;
    right: -4rem;
    z-index: -1;
    width: 16rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--primary) 45%, transparent);
    content: "";
    filter: blur(2rem);
    opacity: 0.7;
  }
  .open-source-principle {
    position: relative;
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid
      color-mix(in srgb, var(--background) 12%, transparent);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--primary) 40%, var(--foreground)),
      color-mix(in srgb, var(--primary) 12%, var(--foreground))
    );
  }
  .open-source-principle span,
  .open-source-note {
    color: color-mix(in srgb, var(--background) 62%, transparent);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .open-source-principle p {
    max-width: 23rem;
    margin: 0.65rem 0 0;
    color: var(--background);
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .open-source-benefits {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .open-source-benefits li {
    display: grid;
    grid-template-columns: 1.5rem auto minmax(0, 1fr);
    gap: 0.85rem;
    padding: 1.35rem clamp(1.5rem, 4vw, 2.5rem);
    transition: background-color 180ms ease;
  }
  .open-source-benefits li:hover {
    background: color-mix(in srgb, var(--background) 4%, transparent);
  }
  .open-source-benefit-number {
    padding-top: 0.18rem;
    color: color-mix(in srgb, var(--background) 38%, transparent);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .open-source-icon {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--background) 11%, transparent);
    color: var(--background);
  }
  .open-source-benefits h3 {
    margin: 0;
    color: var(--background);
    font-size: 1rem;
    font-weight: 750;
  }
  .open-source-benefits p {
    margin: 0.35rem 0 0;
    color: color-mix(in srgb, var(--background) 68%, transparent);
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .open-source-note {
    margin: 0;
    padding: 1.2rem clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid color-mix(in srgb, var(--background) 12%, transparent);
    background: color-mix(in srgb, var(--background) 3%, transparent);
  }
  @media (max-width: 800px) {
    .open-source-shell {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .open-source-intro h2 {
      max-width: 15ch;
    }
    .open-source-panel {
      max-width: 38rem;
    }
  }
  @media (max-width: 480px) {
    .open-source-downloads {
      width: 100%;
    }
    .open-source-benefits li {
      grid-template-columns: auto 1fr;
      column-gap: 0.8rem;
    }
    .open-source-benefit-number {
      display: none;
    }
  }
</style>
