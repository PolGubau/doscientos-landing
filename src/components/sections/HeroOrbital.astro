---
import { Image } from "astro:assets";
import { getProjects } from "~/shared/lib/collections";

const projects = await getProjects();

// Loop projects to fill the ring (~16 slots for a dense circle)
const SLOTS = 16;
const thumbnails = Array.from(
  { length: SLOTS },
  (_, i) => projects[i % projects.length],
);
---

<!--
  Orbital ring of project thumbnails.
  JS (orbital.ts) handles all positioning + animation.
  Starts hidden (opacity-0); GSAP reveals and places each thumb.
-->
<div
  id="orbital-ring"
  class="absolute inset-0 pointer-events-none select-none"
  aria-hidden="true"
>
  <!-- Inner wrapper rotated by the cursor (orbital.ts), independent of the
       scroll transforms applied to #orbital-ring. -->
  <div id="orbital-inner" class="absolute inset-0 pointer-events-none">
    {
      thumbnails.map((project, i) => (
        <a
          href={`/projects/${project.id}`}
          class="orbital-thumb absolute left-1/2 top-1/2 block rounded-lg pointer-events-auto overflow-hidden"
          style={`background-color: ${project.data.color}; --i: ${i}`}
          data-index={i}
          data-title={project.data.title}
          data-client={project.data.client}
        >
          <Image
            src={project.data.cover}
            alt={project.data.title}
            widths={[240, 720]}
            sizes="(max-width: 767px) 240px, 720px"
            format="webp"
            quality={70}
            class="orbital-img object-cover block"
            loading={i < 4 ? "eager" : "lazy"}
            decoding="async"
          />
        </a>
      ))
    }
  </div>
</div>

<!--
  Floating hover label. Lives outside #orbital-ring so it is not affected by
  the ring's scroll transforms/fade. Positioned in screen space by orbital.ts.
-->
<div id="orbital-label" class="orbital-label" aria-hidden="true">
  <span class="orbital-label-title"></span>
  <span class="orbital-label-client"></span>
</div>

<style>
  .orbital-thumb {
    /* Hidden from initial paint — GSAP reveals each card during the entrance animation */
    opacity: 0;
    /* No permanent will-change: it pins the card to a base-resolution GPU layer,
       which the ring's scale(3) then stretches → blurry border-radius + image on
       the proximity 3D tilt. Letting Chrome rasterize on demand keeps it sharp at
       the real screen-space scale. */
    transform-style: preserve-3d;
    --shadow-t: 0;
    box-shadow:
      0 calc(var(--shadow-t) * 6px) calc(var(--shadow-t) * 16px)
        rgb(0 0 0 / calc(var(--shadow-t) * 0.12)),
      0 calc(var(--shadow-t) * 2px) calc(var(--shadow-t) * 5px)
        rgb(0 0 0 / calc(var(--shadow-t) * 0.06));
  }

  #orbital-inner {
    will-change: transform;
    transform-style: preserve-3d;
  }

  .orbital-label {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    pointer-events: none;
    opacity: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding: 0.5rem 0.95rem;
    border-radius: 9999px;
    white-space: nowrap;
    background: var(--background, #fff);
    color: var(--foreground, #111);
    box-shadow: 0 10px 35px rgb(0 0 0 / 0.16);
    will-change: transform, opacity;
  }

  .orbital-label-title {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.1;
  }

  .orbital-label-client {
    font-size: 0.72rem;
    line-height: 1.1;
    color: var(--muted-foreground, #6b7280);
  }

  /* Dimensions driven by orbital.ts via CSS vars */
  .orbital-img {
    width: var(--thumb-w, 64px);
    height: var(--thumb-h, 96px);
    display: block;
    transition: box-shadow 0.25s ease;
    /* The back face shows the same photo, mirrored, on the rotateY flip */
    backface-visibility: visible;
  }

  /*
    Mobile (< 768px): the orbital choreography is disabled (orbital.ts returns
    early), so lay the thumbnails out as a static, horizontally-scrollable strip
    instead of an absolutely-positioned ring. Higher specificity (#id .class)
    overrides the absolute/inset-0 utility classes on the thumbs.
  */
  @keyframes orbital-slide-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.92);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 767px) {
    /* The cursor-rotation wrapper has no role on mobile; collapse it so the
       flex strip lays out the thumbs directly. */
    #orbital-inner {
      display: contents;
    }
    #orbital-ring {
      position: relative;
      inset: auto;
      display: flex;
      gap: 0.875rem;
      width: 100%;
      margin-top: 1.5rem;
      /* Extra bottom padding leaves room for the card shadows */
      padding: 0.5rem 1.5rem 1rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      /* Keep snapped cards inset from the edge so they read as "next" */
      scroll-padding-inline: 1.5rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      /* Fade the leading/trailing edges to hint there is more to scroll */
      -webkit-mask-image: linear-gradient(
        to right,
        transparent,
        #000 1.25rem,
        #000 calc(100% - 1.25rem),
        transparent
      );
      mask-image: linear-gradient(
        to right,
        transparent,
        #000 1.25rem,
        #000 calc(100% - 1.25rem),
        transparent
      );
    }
    #orbital-ring::-webkit-scrollbar {
      display: none;
    }
    #orbital-ring .orbital-thumb {
      position: relative;
      left: auto;
      top: auto;
      flex: 0 0 auto;
      scroll-snap-align: center;
      border-radius: 1rem;
      box-shadow: 0 10px 24px -10px rgb(0 0 0 / 0.28);
      transition: transform 0.18s ease;
      /* Staggered entrance: each card slides up with a delay based on its index.
         animation-fill-mode: both keeps the card hidden before the delay fires. */
      animation: orbital-slide-in 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(var(--i, 0) * 55ms + 150ms);
    }
    /* Tactile press feedback (replaces the cursor-only proximity effect) */
    #orbital-ring .orbital-thumb:active {
      transform: scale(0.96);
    }
    #orbital-ring .orbital-img {
      width: 8rem;
      height: 10.5rem;
    }
  }
</style>
