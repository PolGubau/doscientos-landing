---
import { BadgeCheck, FileCheck, ShieldCheck } from "@lucide/astro";
import SectionHeader from "../ui/SectionHeader.astro";

const proof = [
  {
    icon: ShieldCheck,
    title: "Duermes tranquilo",
    description:
      "Tu facturación cumple la normativa desde la primera factura. Sin sustos si llega una inspección.",
  },
  {
    icon: BadgeCheck,
    title: "Referencia en el sector",
    description:
      "Otros equipos confían en nuestra herramienta para cumplir la ley. Ese es el nivel que aplicamos a tu proyecto.",
  },
  {
    icon: FileCheck,
    title: "Cero multas, cero dolores de cabeza",
    description:
      "Nos ocupamos de que sigas cumpliendo también el año que viene. Tú solo facturas.",
  },
];
---

<section class="landing-section">
  <SectionHeader
    title="Con Hacienda no se juega."
    subtitle="Por eso lo hacemos nosotros."
    description="Si Hacienda inspecciona tu negocio y las facturas no cumplen VeriFactu, la sanción es directa. Nosotros construimos la librería técnica que otros equipos usan como referencia para cumplir esa norma — y la aplicamos en cada proyecto que tocamos."
    align="center"
  />

  <div
    class="flex flex-col items-center gap-4"
    data-reveal="bottom"
    data-speed="normal"
    data-easing="smooth"
  >
    <span
      class="text-xs font-medium uppercase tracking-widest text-muted-foreground/70"
    >
      Cumplimiento con la normativa
    </span>
    <div
      class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
    >
      <img
        src="/logos/agencia-tributaria.svg"
        alt="Agencia Tributaria (Hacienda)"
        class="h-10 w-auto"
        loading="lazy"
        decoding="async"
      />
      <span
        class="text-2xl font-bold tracking-tight text-foreground"
        aria-label="VERI*FACTU"
      >
        VERI<span class="text-primary">*</span>FACTU
      </span>
    </div>
  </div>

  <ul class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto w-full">
    {
      proof.map(({ icon: Icon, title, description }, i) => (
        <li
          class="panel gap-5"
          data-reveal="bottom"
          data-speed="normal"
          data-easing="smooth"
          data-delay={i * 100}
        >
          <span class="flex items-center justify-center size-11 rounded-xl bg-primary/10 text-primary shrink-0">
            <Icon class="size-6" aria-hidden="true" />
          </span>
          <div class="flex flex-col gap-2">
            <h3 class="text-lg font-bold text-pretty">{title}</h3>
            <p class="text-sm text-muted-foreground text-pretty leading-relaxed">
              {description}
            </p>
          </div>
        </li>
      ))
    }
  </ul>

  <p class="text-xs text-muted-foreground/70 text-center max-w-md mx-auto">
    Para técnicos: nuestra librería <code class="text-foreground font-medium"
      >@doscientos/verifactu</code
    > es open source y está publicada en npm.
  </p>
</section>
