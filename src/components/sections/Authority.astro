---
import { BadgeCheck, FileCheck, ShieldCheck } from "@lucide/astro";
import SectionHeader from "../ui/SectionHeader.astro";

const proof = [
  {
    icon: ShieldCheck,
    title: "Trazabilidad desde el inicio",
    description:
      "Diseñamos el flujo de facturación con trazabilidad y dejamos documentadas las decisiones técnicas y operativas.",
  },
  {
    icon: BadgeCheck,
    title: "Tecnología auditable",
    description:
      "Nuestra librería open source permite revisar cómo resolvemos la parte técnica del cumplimiento.",
  },
  {
    icon: FileCheck,
    title: "Preparado para evolucionar",
    description:
      "Incluimos documentación y un plan de mantenimiento para revisar cambios normativos con tu asesoría.",
  },
];
---

<section class="landing-section">
  <SectionHeader
    title="VeriFactu sin sorpresas técnicas"
    subtitle="Cumplimiento con trazabilida"
    description="Ayudamos a implementar los requisitos técnicos aplicables a la facturación y dejamos el sistema documentado para que puedas revisarlo con tu asesoría."
    align="center"
  />

  <div
    class="flex flex-col items-center gap-4"
    data-reveal="bottom"
    data-speed="normal"
    data-easing="smooth"
  >
    <span
      class="text-xs font-medium uppercase tracking-widest text-muted-foreground/70"
    >
      Cumplimiento con la normativa
    </span>
    <div
      class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
    >
      <img
        src="/logos/agencia-tributaria.svg"
        alt="Agencia Tributaria (Hacienda)"
        class="h-10 w-auto"
        loading="lazy"
        decoding="async"
      />
      <span
        class="text-2xl font-bold tracking-tight text-foreground"
        aria-label="VERI*FACTU"
      >
        VERI<span class="text-primary">*</span>FACTU
      </span>
    </div>
  </div>

  <ul class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto w-full">
    {
      proof.map(({ icon: Icon, title, description }, i) => (
        <li
          class="panel gap-5"
          data-reveal="bottom"
          data-speed="normal"
          data-easing="smooth"
          data-delay={i * 100}
        >
          <span class="flex items-center justify-center size-11 rounded-xl bg-primary/10 text-primary shrink-0">
            <Icon class="size-6" aria-hidden="true" />
          </span>
          <div class="flex flex-col gap-2">
            <h3 class="text-lg font-bold text-pretty">{title}</h3>
            <p class="text-sm text-muted-foreground text-pretty leading-relaxed">
              {description}
            </p>
          </div>
        </li>
      ))
    }
  </ul>

  <p class="text-xs text-muted-foreground/70 text-center max-w-md mx-auto">
    Para técnicos: nuestra librería <code class="text-foreground font-medium"
      >@doscientos/verifactu</code
    > es open source y está publicada en npm.
  </p>
  <p class="text-xs text-muted-foreground/60 text-center max-w-2xl mx-auto">
    La configuración fiscal final depende de la operativa de cada empresa y debe
    validarse con su asesoría.
  </p>
</section>
