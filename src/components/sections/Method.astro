---
import { Image } from "astro:assets";
import flatmatchThumbnail from "~/assets/media/landing/flatmatch-thumbnail.webp";
import { diagnosticRoute } from "~/data/commercialRoutes";
import { copy } from "~/shared/lib/copy";
import Button from "../ui/Button.astro";
import Link from "../ui/Link.astro";
import SectionHeader from "../ui/SectionHeader.astro";

const { method } = copy;
---

<section id="method" class="lg:py-32 px-6 max-w-7xl mx-auto">
  <div class="flex gap-24 w-full max-lg:flex-col">
    <div
      class="lg:sticky lg:top-32 self-start shrink-0 w-full lg:max-w-md flex flex-col justify-between gap-36"
    >
      <SectionHeader
        title="Así trabajamos"
        descriptionClass="max-w-sm"
        subtitle="Fácil y cómodo"
        description="Tenemos experiencia en llegar a tu producto deseado: escuchamos, planeamos y trabajamos contigo paso a paso."
      />

      <div class="hidden lg:block">
        <a
          href="/recursos/proceso-en-flatmatch"
          aria-label="Leer el artículo: Descubre cómo implementamos nuestro método en la práctica"
        >
          <article
            class="group p-2 rounded-3xl shadow-pastel hover:shadow-pastel-sm bg-accent hover:bg-accent/80 transition-all duration-300"
          >
            <Image
              src={flatmatchThumbnail}
              alt="Vista general de nuestro método de trabajo paso a paso"
              width={600}
              height={400}
              class="rounded-3xl object-cover -mt-14 group-hover:scale-102 transition-transform duration-300"
            />
            <footer
              class="p-4 grid grid-cols-[1fr_auto] items-center gap-2 justify-between"
            >
              <p class="text-muted-foreground">
                Descubre cómo implementamos nuestro método en la práctica
              </p>

              <Link href={"/recursos/proceso-en-flatmatch"} />
            </footer>
          </article>
        </a>
      </div>
    </div>

    <div class="relative space-y-24" data-stagger="150">
      <!-- Progress bar (background line) -->
      <div
        class="block absolute left-4 lg:left-5 top-0 bottom-0 w-0.5 bg-muted"
      >
      </div>
      <!-- Progress line (animated) -->
      <div
        id="progress-line"
        class="block absolute left-4 lg:left-5 top-0 w-0.5 bg-primary"
        style="height: 0px"
      >
      </div>
      {
        method.steps.map((step, index) => (
          <div
            class="method-step group relative"
            data-step={index}
            data-reveal="left"
            data-duration="600"
          >
            <div class="flex gap-8 items-start">
              <div class="relative z-10 shrink-0">
                <div
                  class="step-badge size-8 lg:size-10 flex items-center justify-center rounded-full bg-background border-2 border-muted font-semibold text-sm transition-all duration-500"
                  data-step-index={index}
                >
                  {index + 1}
                </div>
              </div>

              {/* Content */}
              <div class="step-content flex-1 space-y-4 lg:pt-1">
                <div class="space-y-2">
                  <h3 class="text-xl lg:text-2xl font-semibold text-balance">
                    {step.title}
                  </h3>
                </div>
                <p class="text-muted-foreground leading-relaxed max-w-2xl">
                  {step.description}
                </p>
                {index === method.steps.length - 1 && (
                  <a
                    href={`${diagnosticRoute.href}?ref=home-method`}
                    class="inline-flex"
                  >
                    <Button size="lg" withArrow>
                      Pedir diagnóstico
                    </Button>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Lightweight baseline for mobile / reduced-motion / no-desktop-GSAP.
  // Uses IntersectionObserver (no scroll listener, no rAF loop) to grow the
  // progress line and mark badges as "active" once passed. On desktop with
  // motion allowed, gsap-animations.ts takes over with a smoother
  // scroll-scrubbed version, so this baseline intentionally skips itself.
  const isDesktop = window.matchMedia("(min-width: 768px)").matches;
  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!isDesktop || prefersReduced) {
    const stepsContainer =
      document.querySelector(".method-step")?.parentElement;
    const badges = Array.from(
      document.querySelectorAll<HTMLElement>(".step-badge"),
    );
    const progressLine = document.getElementById("progress-line");

    if (stepsContainer && progressLine && badges.length > 0) {
      let badgeCenters: number[] = [];

      const measure = () => {
        const containerTop =
          stepsContainer.getBoundingClientRect().top + window.scrollY;
        badgeCenters = badges.map((badge) => {
          const rect = badge.getBoundingClientRect();
          return rect.top + window.scrollY + rect.height / 2 - containerTop;
        });
      };
      measure();

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const badge = entry.target as HTMLElement;
            const index = badges.indexOf(badge);
            if (index === -1) continue;

            if (entry.isIntersecting) {
              badge.classList.add("active");
              progressLine.style.height = `${badgeCenters[index]}px`;
            } else if (entry.boundingClientRect.top > 0) {
              // Scrolled back above the viewport — retract to the previous step.
              badge.classList.remove("active");
              const prevCenter = badgeCenters[index - 1] ?? 0;
              progressLine.style.height = `${prevCenter}px`;
            }
          }
        },
        { rootMargin: "-45% 0px -50% 0px", threshold: 0 },
      );

      for (const badge of badges) observer.observe(badge);

      window.addEventListener("resize", measure);
    }
  }
</script>

<style>
  .step-badge {
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .step-badge.active {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: var(--color-background);
    transform: scale(1.1);
  }

  #progress-line {
    transition: height 0.4s ease;
    box-shadow: 0 10px 18px -6px var(--color-primary);
  }

  /* Desktop-only "reading focus": gsap-animations.ts adds .gsap-ready once
     ScrollTrigger takes over, so mobile/no-JS always shows full-brightness
     text. #progress-line's own transition above is also disabled there
     (GSAP drives it every frame instead). */
  #method.gsap-ready #progress-line {
    transition: none;
  }

  #method.gsap-ready .step-content {
    opacity: 0.45;
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  #method.gsap-ready .step-content.is-past {
    opacity: 0.75;
  }

  #method.gsap-ready .step-content.active {
    opacity: 1;
    transform: translateX(4px);
  }

  #method.gsap-ready .step-content.active h3 {
    color: var(--color-primary);
    transition: color 0.5s ease;
  }

  #method.gsap-ready .step-badge.current {
    box-shadow: 0 0 0 6px
      color-mix(in srgb, var(--color-primary) 18%, transparent);
  }
</style>
