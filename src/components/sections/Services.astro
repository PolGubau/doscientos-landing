---
import { Code, Database, Palette, Smartphone } from "@lucide/astro";
import Image from "astro/components/Image.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import CtaButton from "../ui/CtaButton.astro";

import imageMobile from "~/assets/media/landing/flatmatch-mobile.webp";
import imageFooter from "~/assets/media/landing/nh-admin.webp";
import imagePhones from "~/assets/media/landing/phones.webp";

const services = [
  {
    title: "CRMs, gestores de pedidos y portales de cliente a medida",
    description:
      "¿Gestionas clientes en Excel o un CRM genérico que no encaja con tu proceso? Construimos la herramienta exacta: seguimiento de ventas, gestión de facturas, control de stock, informes automáticos. Sin licencias mensuales ni adaptar tu negocio a una plantilla.",
  },
  {
    title: "Tu idea en producción en 6 semanas: marketplace, SaaS o app B2B",
    description:
      "Plataformas de reservas, marketplaces, herramientas B2B, apps de gestión interna. Lanzamos lo justo para validar con usuarios reales, tus primeros clientes prueban el producto mientras tu competencia sigue en Figma.",
  },
  {
    title: "Pedidos, facturas e informes que se procesan solos",
    description:
      "Conectamos tu tienda, ERP, CRM y contabilidad. Los pedidos entran automáticamente en el ERP, las facturas se generan y envían sin tocarlas, y el informe del lunes llega el domingo. ROI medible en 2–3 meses.",
  },
  {
    title: "Tu sistema de hace 10 años está frenando tu negocio",
    description:
      "Migramos de Access, PHP monolítico o Excel a arquitecturas modernas. Mientras construimos el nuevo sistema, el antiguo sigue funcionando. Tus clientes no notan nada — tú sí.",
  },
  {
    title: "Arquitectura que aguanta ×10 usuarios sin reescribir nada",
    description: "Pensada para escalar, no para el siguiente sprint.",
  },
];

const benefits = [
  {
    label: "Precio fijo",
    icon: Code,
  },
  {
    label: "Entrega en 6 semanas",
    icon: Palette,
  },
  {
    label: "Demo semanal",
    icon: Smartphone,
  },
  {
    label: "Código 100% tuyo",
    icon: Database,
  },
  {
    label: "Sin lock-in",
    icon: Code,
  },
  {
    label: "Senior desde día 1",
    icon: Palette,
  },
];
---

<section class="landing-section">
  <SectionHeader
    title="Problemas de negocio"
    subtitle="que resolvemos con software."
    description="ERPs, CRMs, automatizaciones y MVPs. No webs corporativas, sistemas que operan en producción y generan ROI medible."
  />

  <!-- bento con stagger -->
  <ul
    class="bento flex flex-col lg:grid grid-cols-3 auto-rows-auto gap-4 w-full"
    data-stagger="120"
  >
    <li
      class="row-span-2 panel gap-4 grid grid-rows-[auto_1fr]"
      data-reveal="top-left"
      data-speed="normal"
      data-easing="smooth"
    >
      <header class="flex flex-col gap-4">
        <h3>{services[0].title}</h3>
        <p>{services[0].description}</p>
      </header>
      <div class="relative w-full h-full overflow-hidden max-h-[360px]">
        <Image
          width={800}
          height={650}
          src={imagePhones}
          alt="Apps móviles a medida desarrolladas por doscientos para gestión de clientes y pedidos"
          class="w-full h-full object-cover object-top"
        />

        <div
          class="absolute bottom-0 left-0 w-full h-12 bg-gradient-to-t from-accent"
        >
        </div>
      </div>
    </li>
    <li
      class="col-span-2 panel flex flex-col justify-between gap-4"
      data-reveal="top-right"
      data-speed="normal"
      data-easing="smooth"
    >
      <header class="flex flex-col gap-4">
        <h3>{services[1].title}</h3>
        <p>{services[1].description}</p>
      </header>
      {
        benefits && (
          <ul class="flex gap-2 flex-wrap max-w-md">
            {benefits.map((step) => {
              const IconComponent = step.icon;
              return (
                <li class="py-1.5 px-3 bg-muted text-sm rounded-full flex gap-2 items-center text-foreground">
                  <IconComponent class="size-3.5" />
                  {step.label}
                </li>
              );
            })}
          </ul>
        )
      }
    </li>
    <li
      class="col-span-2 col-start-2 row-start-2 panel"
      data-reveal="right"
      data-speed="normal"
      data-easing="smooth"
    >
      <div class="grid lg:grid-cols-[2fr_1fr] gap-4 h-full">
        <div class="flex flex-col justify-between gap-6">
          <header class="flex flex-col gap-4">
            <h3>{services[2].title}</h3>
            <p>{services[2].description}</p>
          </header>
          <CtaButton size="sm" />
        </div>
        <div class="relative w-full flex items-end justify-end">
          <Image
            width={500}
            height={900}
            src={imageMobile}
            alt="App móvil de Flatmatch mostrando el flujo de búsqueda y reserva de piso"
            class="w-full max-h-[200px] border-4 border-b-0 border-primary bg-[#c7c7c7] p-1 rounded-t-[32px] object-cover object-top"
          />

          <div
            class="absolute bottom-0 left-0 w-full h-12 bg-gradient-to-t from-accent"
          >
          </div>
        </div>
      </div>
    </li>
    <li
      class="col-span-2 row-start-3 panel"
      data-reveal="bottom-left"
      data-speed="normal"
      data-easing="smooth"
    >
      <h3>{services[3].title}</h3>
      <p>{services[3].description}</p>
      <div class="relative w-full h-full">
        <Image
          width={900}
          height={300}
          src={imageFooter}
          alt="Panel de administración a medida tras migrar un sistema legacy a arquitectura moderna"
          class="w-full max-w-[700px] h-[110px] mt-4 border border-muted p-2 rounded-2xl object-cover object-top"
        />

        <div
          class="absolute bottom-0 left-0 w-full h-12 bg-gradient-to-t from-accent"
        >
        </div>
      </div>
    </li>
    <li
      class="flex flex-col gap-4 bg-linear-60 from-primary/20 to-primary/30 rounded-2xl shadow-pastel p-7 justify-end"
      data-reveal="bottom-right"
      data-speed="normal"
      data-easing="bounce"
    >
      <header class="h-full flex flex-col justify-end">
        <h3 class="text-2xl font-semibold text-pretty">
          {services[4].title}
        </h3>
        <p class="text-xl">{services[4].description}</p>
      </header>
      <CtaButton />
    </li>
  </ul>
</section>
