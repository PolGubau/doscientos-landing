---
import { Award, Code, Lock, Rocket, Smartphone, Users } from "@lucide/astro";
import { Image } from "astro:assets";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import CtaButton from "../ui/CtaButton.astro";

import imageMobile from "~/assets/media/landing/flatmatch-mobile.webp";
import imageFooter from "~/assets/media/landing/nh-admin.webp";
import imagePhones from "~/assets/media/landing/phones.webp";

const services = [
  {
    title: "Todo tu negocio en una herramienta, no en diez Excel",
    description:
      "Clientes, pedidos, facturas y stock en un sistema hecho exactamente para tu proceso. Sin licencias por usuario, sin adaptar cómo trabajas a Salesforce o HubSpot.",
  },
  {
    title: "De idea a producción en 6 semanas",
    description:
      "Marketplaces, herramientas B2B, apps de reservas, gestión interna. Lanzamos lo mínimo viable con usuarios reales mientras tu competencia sigue en Figma.",
  },
  {
    title: "El trabajo que tu equipo repite cada semana, hecho solo",
    description:
      "Conectamos tienda, ERP y contabilidad. Los pedidos entran solos, las facturas salen cumpliendo VeriFactu y el informe llega sin que nadie lo prepare. ROI en 2-3 meses.",
  },
  {
    title: "Ese Access o Excel de hace 10 años te cuesta dinero cada semana",
    description:
      "Lo sustituimos sin parar la operativa. Mientras construimos el nuevo, el antiguo sigue funcionando. Tus clientes no notan nada, tú sí.",
  },
  {
    title: "Preparado para cuando crezcas ×10",
    description:
      "Arquitectura que no te frena cuando llegas a 10.000 usuarios.",
  },
];

const benefits = [
  {
    label: "Precio fijo desde día 1",
    icon: Lock,
  },
  {
    label: "En producción en 6 semanas",
    icon: Rocket,
  },
  {
    label: "Demo semanal",
    icon: Smartphone,
  },
  {
    label: "El código es tuyo",
    icon: Code,
  },
  {
    label: "Sin cuotas por usuario",
    icon: Users,
  },
  {
    label: "Ingenieros senior",
    icon: Award,
  },
];
---

<section class="landing-section">
  <SectionHeader
    title="Menos tareas manuales,"
    subtitle="más negocio."
    description="Backoffices, CRMs y automatizaciones a medida para PYMEs. Sin cuotas mensuales, sin adaptar tu proceso a ninguna plantilla, en producción en semanas."
  />

  <!-- bento con stagger -->
  <ul
    class="bento flex flex-col lg:grid grid-cols-3 gap-4 w-full"
    data-stagger="120"
  >
    <li
      class="row-span-2 panel gap-4 grid grid-rows-[auto_1fr]"
      data-reveal="top-left"
      data-speed="normal"
      data-easing="smooth"
    >
      <header class="flex flex-col gap-4">
        <h3 class="text-pretty">{services[0].title}</h3>
        <p>{services[0].description}</p>
      </header>
      <div class="relative w-full h-full overflow-hidden max-h-[360px]">
        <Image
          src={imagePhones}
          alt="Apps móviles a medida desarrolladas por doscientos para gestión de clientes y pedidos"
          widths={[400, 800]}
          sizes="(min-width: 1024px) 33vw, 100vw"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover object-top"
        />

        <div
          class="absolute bottom-0 left-0 w-full h-12 bg-gradient-to-t from-accent"
        >
        </div>
      </div>
    </li>
    <li
      class="col-span-2 panel flex flex-col justify-between gap-4"
      data-reveal="top-right"
      data-speed="normal"
      data-easing="smooth"
    >
      <header class="flex flex-col gap-4">
        <h3 class="text-pretty">{services[1].title}</h3>
        <p>{services[1].description}</p>
      </header>
      {
        benefits.length > 0 && (
          <ul class="flex gap-2 flex-wrap max-w-md">
            {benefits.map((step) => {
              const IconComponent = step.icon;
              return (
                <li class="py-1.5 px-3 bg-muted text-sm rounded-full flex gap-2 items-center text-foreground">
                  <IconComponent class="size-3.5" />
                  {step.label}
                </li>
              );
            })}
          </ul>
        )
      }
    </li>
    <li
      class="col-span-2 col-start-2 row-start-2 panel"
      data-reveal="right"
      data-speed="normal"
      data-easing="smooth"
    >
      <div class="grid lg:grid-cols-[2fr_1fr] gap-4 h-full">
        <div class="flex flex-col justify-between gap-6">
          <header class="flex flex-col gap-4">
            <h3 class="text-pretty">{services[2].title}</h3>
            <p>{services[2].description}</p>
          </header>
          <CtaButton size="sm" />
        </div>
        <div class="relative w-full flex items-end justify-end">
          <Image
            width={500}
            height={900}
            src={imageMobile}
            alt="App móvil de Flatmatch mostrando el flujo de búsqueda y reserva de piso"
            loading="lazy"
            decoding="async"
            class="w-full max-h-[200px] border-4 border-b-0 border-primary bg-[#c7c7c7] p-1 rounded-t-[32px] object-cover object-top"
          />

          <div
            class="absolute bottom-0 left-0 w-full h-12 bg-gradient-to-t from-accent"
          >
          </div>
        </div>
      </div>
    </li>
    <li
      class="col-span-2 row-start-3 panel"
      data-reveal="bottom-left"
      data-speed="normal"
      data-easing="smooth"
    >
      <h3 class="text-pretty">{services[3].title}</h3>
      <p>{services[3].description}</p>
      <div class="relative w-full h-full">
        <Image
          src={imageFooter}
          alt="Panel de administración a medida tras migrar un sistema legacy a arquitectura moderna"
          widths={[400, 700, 900]}
          sizes="(min-width: 1024px) 66vw, 100vw"
          loading="lazy"
          decoding="async"
          class="w-full max-w-[700px] h-[110px] mt-4 border border-muted p-2 rounded-2xl object-cover object-top"
        />

        <div
          class="absolute bottom-0 left-0 w-full h-12 bg-gradient-to-t from-accent"
        >
        </div>
      </div>
    </li>
    <li
      class="panel bg-linear-60 from-primary/20 to-primary/30 justify-end"
      data-reveal="bottom-right"
      data-speed="normal"
      data-easing="bounce"
    >
      <header class="h-full flex flex-col justify-end">
        <h3 class="text-pretty">{services[4].title}</h3>
        <p>{services[4].description}</p>
      </header>
      <CtaButton />
    </li>
  </ul>
</section>
