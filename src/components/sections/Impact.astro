---
import { Image } from "astro:assets";
import { getProjects } from "~/shared/lib/collections";

const projects = await getProjects();
const projectById = new Map(projects.map((project) => [project.id, project]));

const highlights = [
  {
    id: "flatmatch",
    eyebrow: "Producto digital",
    result: "500+",
    resultLabel: "usuarios orgánicos en 3 meses",
    title: "Una experiencia que hizo crecer el producto",
    description:
      "Diseñamos y desarrollamos una plataforma de alojamiento temporal que convirtió encontrar piso en una experiencia mucho más sencilla",
  },
  {
    id: "bitacora",
    eyebrow: "Automatización",
    result: "-90%",
    resultLabel: "de tiempo en procesos manuales",
    title: "De tres horas de trabajo a quince minutos",
    description:
      "Conectamos facturación, generación de documentos y contabilidad dentro de un ERP de logística y aduanas",
  },
  {
    id: "ifco",
    eyebrow: "Modernización",
    result: "0 min",
    resultLabel: "de interrupción durante la migración",
    title: "Modernización sin parar la operación",
    description:
      "Migramos más de un millón de registros manteniendo el negocio activo durante todo el proceso",
  },
];

const featured = highlights[0];
const secondary = highlights.slice(1);
const featuredProject = projectById.get(featured.id);
---

<section class="impact-section-new" aria-labelledby="impact-title">
  <div class="impact-section-new__inner">
    <header class="impact-section-new__header">
      <div>
        <h2 id="impact-title">Trabajo que ya está cambiando negocios.</h2>
      </div>
      <div class="impact-section-new__intro">
        <p>
          Sistemas, productos y automatizaciones que están en producción y
          resuelven problemas reales todos los días.
        </p>
        <a href="/projects"
          >Ver todos los proyectos <span aria-hidden="true">↗</span></a
        >
      </div>
    </header>

    {
      featuredProject && (
        <a href={`/projects/${featuredProject.id}`} class="impact-featured">
          <div class="impact-featured__media">
            <Image
              src={featuredProject.data.cover}
              alt={`Vista previa de ${featuredProject.data.title}`}
              widths={[600, 1000, 1400]}
              sizes="(min-width: 1024px) 58vw, 100vw"
              loading="lazy"
              decoding="async"
            />
            <span class="impact-featured__media-label">
              Caso destacado · 01
            </span>
          </div>
          <div class="impact-featured__content">
            <div class="impact-featured__topline">
              <span>{featured.eyebrow}</span>
              <span>{featuredProject.data.client}</span>
            </div>
            <h3>{featured.title}</h3>
            <p>{featured.description}</p>
            <div class="impact-featured__result">
              <strong>{featured.result}</strong>
              <span>{featured.resultLabel}</span>
            </div>
            <span class="impact-link">
              Ver caso <span aria-hidden="true">↗</span>
            </span>
          </div>
        </a>
      )
    }

    <div class="impact-secondary">
      {
        secondary.map((item, index) => {
          const project = projectById.get(item.id);
          if (!project) return null;

          return (
            <a href={`/projects/${project.id}`} class="impact-secondary__item">
              <div class="impact-secondary__number">0{index + 2}</div>
              <div class="impact-secondary__content">
                <div class="impact-secondary__topline">
                  <span>{item.eyebrow}</span>
                  <span>{project.data.client}</span>
                </div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="impact-link">
                  Ver caso <span aria-hidden="true">↗</span>
                </span>
              </div>
              <div class="impact-secondary__result">
                <strong>{item.result}</strong>
                <span>{item.resultLabel}</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .impact-section-new {
    width: 100%;
    padding: 3rem 1.5rem;
  }

  .impact-section-new__inner {
    width: min(75rem, 100%);
    margin: 0 auto;
  }

  .impact-section-new__header {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    align-items: end;
    gap: 4rem;
    margin-bottom: 3.5rem;
  }

  .impact-section-new__eyebrow,
  .impact-featured__topline,
  .impact-secondary__topline {
    color: var(--primary);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .impact-section-new__eyebrow {
    margin-bottom: 1.25rem;
  }

  .impact-section-new h2 {
    max-width: 48rem;
    margin: 0;
    color: var(--foreground);
    font-size: clamp(2.25rem, 4.25vw, 4.25rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.07em;
    text-wrap: balance;
  }

  .impact-section-new__intro {
    max-width: 22rem;
    padding-bottom: 0.2rem;
  }

  .impact-section-new__intro p {
    margin: 0 0 1.25rem;
    color: var(--muted-foreground);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .impact-section-new__intro a,
  .impact-link {
    color: var(--primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: underline;
    text-decoration-color: color-mix(
      in srgb,
      var(--brand-lime) 85%,
      var(--primary)
    );
    text-underline-offset: 0.3rem;
  }

  .impact-section-new a span {
    display: inline-block;
    transition: transform 200ms ease;
  }

  .impact-section-new a:hover > span,
  .impact-section-new a:hover .impact-link span {
    transform: translate(0.15rem, -0.15rem);
  }

  .impact-featured {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(20rem, 0.8fr);
    min-height: 30rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--primary) 16%, var(--muted));
    border-radius: 2rem;
    background: var(--foreground);
    color: var(--background);
    box-shadow: var(--shadow-pastel-sm);
    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
  }

  .impact-featured:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-pastel);
  }

  .impact-featured__media {
    position: relative;
    min-height: 23rem;
    overflow: hidden;
    background: var(--muted);
  }

  .impact-featured__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgb(12 17 11 / 0.15), transparent 60%);
  }

  .impact-featured__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .impact-featured:hover .impact-featured__media :global(img) {
    transform: scale(1.035);
  }

  .impact-featured__media-label {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    z-index: 1;
    padding: 0.45rem 0.7rem;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 9999px;
    background: rgb(12 17 11 / 0.38);
    color: white;
    font-size: 0.68rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
  }

  .impact-featured__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 3rem;
  }

  .impact-featured__topline,
  .impact-secondary__topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    margin-bottom: 1.5rem;
    color: var(--brand-lime);
  }

  .impact-featured__topline span:last-child,
  .impact-secondary__topline span:last-child {
    color: inherit;
    opacity: 0.58;
  }

  .impact-featured h3 {
    max-width: 25rem;
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 3.25rem);
    font-weight: 750;
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .impact-featured__content > p {
    max-width: 25rem;
    margin: 1.25rem 0 2rem;
    color: rgb(246 247 249 / 0.68);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .impact-featured__result,
  .impact-secondary__result {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .impact-featured__result {
    margin-bottom: 2.5rem;
  }

  .impact-featured__result strong,
  .impact-secondary__result strong {
    color: var(--brand-lime);
    font-size: clamp(2.8rem, 5vw, 5rem);
    font-weight: 850;
    line-height: 0.85;
    letter-spacing: -0.08em;
  }

  .impact-featured__result span,
  .impact-secondary__result span {
    max-width: 11rem;
    color: rgb(246 247 249 / 0.56);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .impact-featured .impact-link {
    color: var(--background);
    text-decoration-color: var(--brand-lime);
  }

  .impact-secondary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .impact-secondary__item {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) 7rem;
    align-items: start;
    gap: 1.25rem;
    min-height: 19rem;
    padding: 1.75rem;
    border-radius: 1.5rem;
    background: var(--muted);
    transition:
      transform 250ms ease,
      background 250ms ease;
  }

  .impact-secondary__item:hover {
    transform: translateY(-3px);
    background: color-mix(in srgb, var(--muted) 92%, var(--foreground));
  }

  .impact-secondary__number {
    color: var(--muted-foreground);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .impact-secondary__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    height: 100%;
  }

  .impact-secondary__topline {
    margin-bottom: 1.25rem;
    color: var(--primary);
  }

  .impact-secondary__content h3 {
    margin: 0;
    color: var(--foreground);
    font-size: clamp(1.35rem, 2.2vw, 2rem);
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .impact-secondary__content p {
    margin: 0.9rem 0 1.25rem;
    color: var(--muted-foreground);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .impact-secondary__content .impact-link {
    margin-top: auto;
  }

  .impact-secondary__result {
    align-self: end;
  }

  .impact-secondary__result strong {
    color: var(--primary);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
  }

  .impact-secondary__result span {
    color: var(--muted-foreground);
  }

  @media (max-width: 900px) {
    .impact-section-new__header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .impact-section-new__intro {
      max-width: 30rem;
    }

    .impact-featured {
      grid-template-columns: 1fr;
    }

    .impact-featured__media {
      min-height: 20rem;
    }
  }

  @media (max-width: 640px) {
    .impact-section-new {
      padding: 2rem 1rem;
    }

    .impact-section-new__header {
      margin-bottom: 2rem;
    }

    .impact-section-new h2 {
      font-size: clamp(2.5rem, 12vw, 4rem);
    }

    .impact-featured,
    .impact-secondary__item {
      border-radius: 1.25rem;
    }

    .impact-featured__media {
      min-height: 15rem;
    }

    .impact-featured__content {
      padding: 1.5rem;
    }

    .impact-featured__content > p {
      margin-bottom: 1.5rem;
    }

    .impact-featured__result {
      margin-bottom: 1.75rem;
    }

    .impact-secondary {
      grid-template-columns: 1fr;
    }

    .impact-secondary__item {
      grid-template-columns: 1.75rem minmax(0, 1fr);
      min-height: auto;
      padding: 1.5rem;
    }

    .impact-secondary__result {
      grid-column: 2;
      align-self: start;
      margin-top: 0.5rem;
    }
  }
</style>
