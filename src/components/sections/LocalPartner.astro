---
import { MapPin } from "@lucide/astro";
import { branding } from "~/config/branding";
---

<section
  class="mx-auto w-full max-w-6xl px-6 md:px-10"
  aria-label="Equipo local"
>
  <div
    class="flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-muted pt-6 text-sm"
  >
    <MapPin class="size-4 shrink-0 text-primary" aria-hidden="true" />
    <p class="text-muted-foreground">
      Base en Premià de Mar · reuniones presenciales en {
        branding.location.serviceArea
      } cuando el proyecto lo necesita.
    </p>
  </div>
</section>
