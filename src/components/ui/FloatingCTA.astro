---
/**
 * FloatingCTA - CTA flotante que aparece al hacer scroll
 * Mejora conversión mostrando CTA siempre visible
 */
import UpRightArrow from "./UpRightArrow.astro";
---

<div
  id="floating-cta"
  class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 opacity-0 translate-y-4 transition-all duration-300 pointer-events-none"
>
  <a
    href="/diagnostico?ref=floating-cta"
    id="floating-cta-link"
    class="flex items-center gap-2 px-4 py-3 sm:gap-3 sm:px-6 sm:py-4 bg-primary text-background rounded-full shadow-2xl hover:shadow-primary/50 hover:scale-105 transition-all duration-300 pointer-events-auto group"
  >
    <span class="font-semibold hidden sm:inline">Hablemos de tu proyecto</span>
    <span class="font-semibold sm:hidden text-sm">Diagnóstico</span>
    <UpRightArrow inverted />
  </a>
</div>

<script>
  let cleanupFloatingCta: (() => void) | undefined;

  function initFloatingCta() {
    cleanupFloatingCta?.();
    const controller = new AbortController();
    const { signal } = controller;
    let lastScroll = 0;
    let animationFrame: number | undefined;
    const floatingCTA = document.getElementById("floating-cta");
    if (!floatingCTA) return;

    const updateVisibility = () => {
      const currentScroll = window.scrollY;
      if (currentScroll > 500 && currentScroll > lastScroll) {
        floatingCTA.classList.remove("opacity-0", "translate-y-4");
        floatingCTA.classList.add("opacity-100", "translate-y-0");
      } else if (currentScroll < 300) {
        floatingCTA.classList.add("opacity-0", "translate-y-4");
        floatingCTA.classList.remove("opacity-100", "translate-y-0");
      }

      lastScroll = currentScroll;
    };

    const onScroll = () => {
      if (animationFrame) return;
      animationFrame = requestAnimationFrame(() => {
        animationFrame = undefined;
        updateVisibility();
      });
    };

    window.addEventListener("scroll", onScroll, { passive: true, signal });
    updateVisibility();

    document.getElementById("floating-cta-link")?.addEventListener(
      "click",
      () => {
        if ("gtag" in window) {
          // @ts-ignore
          window.gtag("event", "cta_click", {
            event_category: "engagement",
            event_label: "floating_cta",
          });
        }
      },
      { signal },
    );

    cleanupFloatingCta = () => {
      controller.abort();
      if (animationFrame) cancelAnimationFrame(animationFrame);
    };
  }

  initFloatingCta();
  document.addEventListener("astro:page-load", initFloatingCta);
</script>
