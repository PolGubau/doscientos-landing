---
import { Image } from "astro:assets";
import type { Project } from "~/content.config";
import UpRightArrow from "./UpRightArrow.astro";

type ProjectProps = Pick<
  Project,
  "title" | "summary" | "services_provided" | "color" | "cover"
>;

type Props = {
  id: string;
} & ProjectProps;

const { id, title, services_provided, cover } = Astro.props;
const imageResolution = 800;
---

<a href={`/projects/${id}`} class="w-full">
  <article
    class="group h-full flex flex-col gap-4 rounded-4xl bg-accent shadow-pastel overflow-hidden p-3 transition-all duration-500 ease-out hover:-translate-y-1 hover:shadow-xl"
  >
    <header class="w-full aspect-[1.5] rounded-3xl overflow-hidden">
      <div
        class="w-full h-full bg-gradient-to-br from-muted to-primary/20 flex items-center justify-center relative overflow-hidden"
      >
        <Image
          width={imageResolution * 1.5}
          height={imageResolution}
          src={cover}
          alt={`Imagen de portada del proyecto ${title}, mostrando una vista previa visual del trabajo realizado para el cliente. La imagen refleja el estilo y la esencia del proyecto, utilizando colores y elementos gráficos relacionados con ${title}.`}
          class="w-full h-full object-cover object-center transition-transform duration-700 ease-out motion-safe:group-hover:scale-[1.04]"
        />
      </div>
    </header>

    <footer class="flex items-center gap-4 justify-between px-3 pb-2 pt-1">
      <div class="flex flex-col gap-1.5 min-w-0">
        <span
          class="text-[10px] uppercase tracking-[0.12em] font-medium text-muted-foreground/70 truncate"
        >
          {
            services_provided?.length > 0 &&
              services_provided
                .slice(0, 3)
                .map((cat) => cat.trim())
                .join(" · ")
          }
        </span>
        <h3
          class="text-xl font-semibold truncate transition-colors duration-300 group-hover:text-primary"
        >
          {title}
        </h3>
      </div>

      <UpRightArrow class="p-2 shrink-0" />
    </footer>
  </article>
</a>
