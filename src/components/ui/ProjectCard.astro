---
import { Image } from "astro:assets";
import type { Project } from "~/content.config";

type ProjectProps = Pick<
  Project,
  "title" | "summary" | "services_provided" | "color" | "cover"
>;

type Props = {
  id: string;
  client: string;
  timeline: number;
  timelineUnit?: "semana" | "mes";
} & ProjectProps;

const {
  id,
  title,
  summary,
  services_provided,
  cover,
  client,
  timeline,
  timelineUnit = "mes",
  color,
} = Astro.props;
---

<a
  href={`/projects/${id}`}
  class="project-card-link group block h-full w-full focus-visible:outline-none"
  style={`--project-color: ${color}`}
>
  <article class="project-card flex h-full flex-col">
    <header
      class="project-card-media relative aspect-[16/10] w-full overflow-hidden"
    >
      <Image
        src={cover}
        alt={`Vista previa del proyecto ${title}`}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-center"
      />
    </header>

    <footer class="project-card-content flex grow flex-col">
      <div class="project-card-meta">
        <span class="project-card-client">{client}</span>
        <span class="project-card-timeline">
          {timeline}
          {
            timelineUnit === "semana"
              ? timeline === 1
                ? "semana"
                : "semanas"
              : timeline === 1
                ? "mes"
                : "meses"
          }
        </span>
      </div>

      <div class="project-card-heading">
        <h3>{title}</h3>
        <span class="project-card-arrow" aria-hidden="true">↗</span>
      </div>

      <p class="project-card-summary">{summary}</p>

      <p class="project-card-services">
        {
          services_provided?.length > 0 &&
            services_provided
              .slice(0, 3)
              .map((service) => service.trim())
              .join(" · ")
        }
      </p>
    </footer>
  </article>
</a>

<style>
  .project-card {
    color: var(--foreground);
  }

  .project-card-media {
    border: 1px solid color-mix(in srgb, var(--foreground) 10%, transparent);
    border-radius: 0.75rem;
    background: var(--muted);
  }

  .project-card-media :global(img) {
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card-link:hover .project-card-media :global(img) {
    transform: scale(1.02);
  }

  .project-card-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    color: var(--muted-foreground);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .project-card-timeline {
    flex: none;
  }

  .project-card-client {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .project-card-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.7rem;
  }

  .project-card-heading h3 {
    margin: 0;
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .project-card-summary {
    display: -webkit-box;
    overflow: hidden;
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .project-card-services {
    margin-top: auto;
    padding-top: 1rem;
    color: var(--muted-foreground);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .project-card-arrow {
    flex: none;
    color: var(--muted-foreground);
    font-size: 1.15rem;
    line-height: 1;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .project-card-link:hover .project-card-arrow {
    color: var(--primary);
    transform: translate(0.15rem, -0.15rem);
  }

  .project-card-link:focus-visible .project-card-media {
    outline: 2px solid
      color-mix(in srgb, var(--project-color) 70%, var(--primary));
    outline-offset: 3px;
  }
</style>
