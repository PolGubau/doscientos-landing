---
import { Image } from "astro:assets";
import type { Project } from "~/content.config";
import UpRightArrow from "./UpRightArrow.astro";

type ProjectProps = Pick<
  Project,
  "title" | "summary" | "services_provided" | "color" | "cover"
>;

type Props = {
  id: string;
  client: string;
  timeline: number;
  featured?: boolean;
} & ProjectProps;

const {
  id,
  title,
  summary,
  services_provided,
  cover,
  client,
  timeline,
  color,
  featured = false,
} = Astro.props;
---

<a
  href={`/projects/${id}`}
  class:list={["project-card-link w-full", featured && "project-card-link--featured"]}
>
  <article
    class="project-card group h-full flex flex-col rounded-[1.75rem] overflow-hidden transition-all duration-500 ease-out hover:-translate-y-1 [will-change:transform]"
    style={`--project-color: ${color}`}
  >
    <header
      class:list={[
        "project-card-media relative w-full aspect-[1.5] max-h-80 overflow-hidden",
        featured && "project-card-media--featured",
      ]}
    >
      <div
        class="w-full h-full bg-gradient-to-br from-muted to-primary/20 flex items-center justify-center relative overflow-hidden"
        data-parallax="6"
      >
        <Image
          src={cover}
          alt={`Imagen de portada del proyecto ${title}, mostrando una vista previa visual del trabajo realizado para el cliente. La imagen refleja el estilo y la esencia del proyecto, utilizando colores y elementos gráficos relacionados con ${title}.`}
          widths={[400, 800, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover object-center transition-transform duration-700 ease-out motion-safe:group-hover:scale-[1.04] [will-change:transform]"
        />
        <div class="project-card-media-shade"></div>
        <span class="project-card-client">{client}</span>
        <span class="project-card-timeline">{timeline} {timeline === 1 ? "mes" : "meses"}</span>
      </div>
    </header>

    <footer class="project-card-content flex flex-col gap-4">
      <div class="flex flex-col gap-2 min-w-0">
        <span
          class="project-card-services text-[10px] uppercase tracking-[0.12em] font-bold truncate"
        >
          {
            services_provided?.length > 0 &&
              services_provided
                .slice(0, 3)
                .map((cat) => cat.trim())
                .join(" · ")
          }
        </span>
        <h3
          class="text-2xl font-bold tracking-tight transition-colors duration-300 group-hover:text-primary"
        >
          {title}
        </h3>
      </div>

      <p class="project-card-summary text-sm leading-relaxed text-muted-foreground">
        {summary}
      </p>

      <span class="project-card-cta inline-flex items-center gap-2 text-sm font-bold text-primary">
        Ver caso
        <UpRightArrow class="project-card-arrow p-2 shrink-0" />
      </span>
    </footer>
  </article>
</a>

<style>
  .project-card {
    background: color-mix(in srgb, var(--project-color) 11%, var(--background));
    border: 1px solid color-mix(in srgb, var(--project-color) 28%, var(--muted));
    box-shadow: var(--shadow-pastel-sm);
  }

  .project-card:hover {
    border-color: color-mix(in srgb, var(--project-color) 58%, var(--primary));
    box-shadow: var(--shadow-pastel);
  }

  .project-card-media {
    background: color-mix(in srgb, var(--project-color) 42%, var(--muted));
  }

  .project-card-media--featured {
    aspect-ratio: 2.15;
    max-height: 30rem;
  }

  .project-card-media-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgb(12 17 11 / 0.08), transparent 45%, rgb(12 17 11 / 0.5));
  }

  .project-card-client,
  .project-card-timeline {
    position: absolute;
    top: 1rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 9999px;
    background: rgb(12 17 11 / 0.35);
    color: white;
    font-size: 0.68rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
  }

  .project-card-client {
    left: 1rem;
  }

  .project-card-timeline {
    right: 1rem;
  }

  .project-card-content {
    padding: 1.25rem 1.35rem 1.4rem;
  }

  .project-card-services {
    color: color-mix(in srgb, var(--project-color) 80%, var(--primary));
  }

  .project-card-summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .project-card-arrow {
    transition: transform 220ms ease;
  }

  .project-card:hover .project-card-arrow {
    transform: translate(0.15rem, -0.15rem);
  }

  @media (max-width: 767px) {
    .project-card-media--featured {
      aspect-ratio: 1.45;
    }
  }
</style>
