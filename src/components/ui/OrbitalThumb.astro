---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  cover: ImageMetadata;
  logo?: ImageMetadata;
  title: string;
  /** First few thumbnails load eagerly so the ring appears without flash */
  eager?: boolean;
};

const { cover, logo, title, eager = false } = Astro.props;
const loading = eager ? "eager" : "lazy";
---

<div class="ot-root">
  <!-- Phone/device mockup frame -->
  <div class="ot-phone">
    <Image
      src={cover}
      alt={title}
      widths={[240, 720]}
      sizes="(max-width: 767px) 240px, 720px"
      format="webp"
      quality={70}
      loading={loading}
      decoding="async"
      class="ot-screen"
    />
  </div>

  <!-- Logo badge -->
  {
    logo && (
      <div class="ot-badge">
        <Image
          src={logo}
          alt={`${title} logo`}
          width={80}
          height={16}
          loading={loading}
          decoding="async"
          class="ot-logo"
        />
      </div>
    )
  }
</div>

<style>
  /* ── Container ── */
  .ot-root {
    /* Sizing driven by CSS vars set on #orbital-ring by orbital.ts */
    width: var(--thumb-w, 64px);
    height: var(--thumb-h, 96px);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Clip shadows/overflow inside the parent orbital-thumb border-radius */
    overflow: hidden;
  }

  /* ── Phone frame ── */
  .ot-phone {
    width: 62%;
    aspect-ratio: 9 / 16;
    border-radius: 14%;
    border: 2px solid rgba(255, 255, 255, 0.45);
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.1),
      0 6px 20px rgba(0, 0, 0, 0.32);
    flex-shrink: 0;
    transition: border-color 0.28s ease;
  }

  .ot-root:hover .ot-phone {
    border-color: rgba(255, 255, 255, 0.9);
  }

  /* ── Screen image ── */
  .ot-screen {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.45s ease;
  }

  .ot-root:hover .ot-screen {
    transform: scale(1.07);
  }

  /* ── Logo badge ── */
  .ot-badge {
    position: absolute;
    bottom: 9%;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.93);
    border-radius: 999px;
    padding: 3px 8px;
    display: flex;
    align-items: center;
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.18);
    opacity: 0.8;
    transition:
      opacity 0.28s ease,
      transform 0.28s ease;
    white-space: nowrap;
  }

  .ot-root:hover .ot-badge {
    opacity: 1;
    transform: translateX(-50%) translateY(-3px);
  }

  .ot-logo {
    height: 11px;
    width: auto;
    max-width: 50px;
    display: block;
    object-fit: contain;
  }

  /* ── Mobile horizontal strip ── */
  @media (max-width: 767px) {
    .ot-root {
      width: 8rem;
      height: 10.5rem;
    }

    .ot-logo {
      height: 14px;
      max-width: 62px;
    }
  }
</style>
