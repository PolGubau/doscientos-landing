---
interface Props {
  number: string;
  label: string;
  description: string;
}

const { number, label, description } = Astro.props;

// Extract numeric value, prefix and suffix for GSAP counter
const numericValue = number.replace(/[^0-9.-]/g, "");
const prefix = number.match(/^[^0-9]+/)?.[0] || "";
const suffix = number.match(/[0-9]([^0-9]+)$/)?.[1] || "";
---

<div
  class="p-8 md:p-12 rounded-3xl bg-accent flex flex-col gap-4 h-full"
  data-reveal="scale"
  data-speed="normal"
  data-easing="soft"
>
  <!-- Number -->
  <div
    class="text-5xl font-semibold"
    data-count={numericValue}
    data-count-prefix={prefix}
    data-count-suffix={suffix}
  >
    {number}
  </div>

  <!-- Label -->
  <h3 class="text-lg text-balance font-semibold text-muted-foreground">
    {label}
  </h3>

  <!-- Description -->
  <p class="text-muted-foreground">
    {description}
  </p>
</div>
