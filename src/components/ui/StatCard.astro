---
import { ArrowUpRight } from "@lucide/astro";

interface Props {
  number: string;
  label: string;
  description: string;
  href?: string;
  linkText?: string;
}

const { number, label, description, href, linkText = "Ver caso" } = Astro.props;

// Extract numeric value, prefix and suffix for GSAP counter
const numericValue = number.replace(/[^0-9.-]/g, "");
const prefix = number.match(/^[^0-9]+/)?.[0] || "";
const suffix = number.match(/[0-9]([^0-9]+)$/)?.[1] || "";

const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class:list={[
    "p-7 md:p-9 rounded-3xl bg-accent border border-primary/10 flex flex-col gap-4 h-full min-h-[19rem] shadow-pastel-sm",
    href &&
      "group transition-all duration-300 hover:-translate-y-1 hover:shadow-pastel",
  ]}
  data-reveal="scale"
  data-speed="normal"
  data-easing="soft"
  data-spotlight
>
  <!-- Number -->
  <div
    class="text-6xl md:text-7xl font-black tracking-[-0.08em] text-primary"
    data-count={numericValue}
    data-count-prefix={prefix}
    data-count-suffix={suffix}
  >
    {number}
  </div>

  <!-- Label -->
  <h3 class="text-lg text-balance font-bold text-foreground max-w-[18rem]">
    {label}
  </h3>

  <!-- Description -->
  <p class="text-sm leading-relaxed text-muted-foreground max-w-[28rem]">
    {description}
  </p>

  {
    href && (
      <span class="mt-auto pt-2 inline-flex items-center gap-1 text-sm font-semibold text-primary">
        {linkText}
        <ArrowUpRight class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </span>
    )
  }
</Tag>
