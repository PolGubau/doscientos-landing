---
import { ArrowUpRight } from "@lucide/astro";
import { cn } from "~/shared/lib/utils";

type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<div
  aria-hidden="true"
  class={cn(
    "rounded-full p-1 bg-background border border-muted-foreground/15 flex items-center justify-center transition-colors duration-300 ease-out group-hover:border-primary/60",
    className,
  )}
>
  <ArrowUpRight
    class="size-4 text-muted-foreground transform-gpu will-change-transform transition-all duration-300 ease-out group-hover:text-primary group-hover:rotate-45"
  />
</div>
