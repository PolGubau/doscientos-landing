---
import { copy } from "~/shared/lib/copy";
---

<div
  class="relative z-20 max-w-5xl mx-auto px-6 pt-8 pb-10 md:pt-10 md:pb-12"
  data-reveal="bottom"
  data-speed="normal"
  data-easing="soft"
  data-delay="700"
>
  <div class="trust-proof-row" aria-label="Pruebas de confianza">
    <div class="trust-proof-item">
      <strong>+30</strong>
      <span>proyectos entregados</span>
    </div>
    <span class="trust-proof-divider" aria-hidden="true"></span>
    <div class="trust-proof-item">
      <strong>6 sem</strong>
      <span>plazo habitual MVP</span>
    </div>
    <span class="trust-proof-divider" aria-hidden="true"></span>
    <div class="trust-proof-item">
      <strong>3</strong>
      <span>casos con métricas públicas</span>
    </div>
  </div>
  <ul class="trust-conditions" aria-label="Condiciones de trabajo">
    {copy.hero.highlights.map((highlight) => <li>{highlight}</li>)}
  </ul>
</div>

<style>
  .trust-proof-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    padding: 0.8rem 0;
    border-top: 1px solid color-mix(in srgb, var(--foreground) 10%, transparent);
    border-bottom: 1px solid
      color-mix(in srgb, var(--foreground) 10%, transparent);
    color: var(--muted-foreground);
  }

  .trust-proof-item {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    white-space: nowrap;
  }

  .trust-proof-item strong {
    color: var(--foreground);
    font-size: 1.1rem;
    line-height: 1;
  }

  .trust-proof-item span {
    font-size: 0.72rem;
    line-height: 1.25;
  }

  .trust-proof-divider {
    width: 1px;
    height: 1.1rem;
    background: color-mix(in srgb, var(--foreground) 14%, transparent);
  }

  .trust-proof-item--stars {
    align-items: center;
  }

  .trust-proof-item--stars strong {
    color: #d59a16;
    letter-spacing: 0.04em;
    font-size: 0.85rem;
  }

  .trust-conditions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.1rem;
    margin-top: 0.9rem;
    color: var(--muted-foreground);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .trust-conditions li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .trust-conditions li::before {
    content: "";
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 9999px;
    background: var(--primary);
  }

  @media (max-width: 639px) {
    .trust-proof-row {
      gap: 0.7rem;
      width: 100%;
      justify-content: space-between;
    }

    .trust-proof-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      white-space: normal;
      text-align: center;
    }

    .trust-proof-item span {
      max-width: 6.5rem;
    }

    .trust-conditions {
      flex-direction: column;
      align-items: center;
      gap: 0.45rem;
    }
  }
</style>
