---
import { cn } from "~/shared/lib/utils";
import Link from "./Link.astro";

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  linkText?: string;
  linkHref?: string;
  descriptionClass?: string;
  align?: "left" | "center";
}

const {
  title,
  subtitle,
  description,
  linkText,
  linkHref,
  descriptionClass,
  align = "left",
} = Astro.props;

const aligns = {
  center: "text-center mx-auto items-center",
  left: "text-left items-start",
};

const alignClass = aligns[align] || "";
---

<header class:list={["flex justify-between gap-6 w-full"]}>
  <div class={`flex flex-col gap-4 max-w-2xl ${alignClass}`} data-stagger="80">
    <div
      class:list={[
        "max-w-2xl flex-col text-3xl md:text-5xl font-bold tracking-tight",
        alignClass,
      ]}
      data-reveal="left"
      data-speed="normal"
      data-easing="smooth"
    >
      <h2 class="text-balance flex flex-col" data-scrub-text>
        <span>{title}</span>
        {
          subtitle && (
            <span class="text-primary/70 text-pretty">{subtitle}</span>
          )
        }
      </h2>
    </div>
    {
      description && (
        <p
          class={cn(
            "text-base text-muted-foreground max-w-md text-pretty leading-relaxed",
            descriptionClass,
          )}
          data-reveal="bottom"
          data-speed="normal"
          data-easing="soft"
          data-distance="small"
        >
          {description}
        </p>
      )
    }
  </div>
  {
    linkText && linkHref && (
      <div data-reveal="right" data-speed="fast" data-easing="smooth">
        <Link href={linkHref} label={linkText} />
      </div>
    )
  }
</header>
