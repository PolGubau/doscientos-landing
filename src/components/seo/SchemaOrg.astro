---
import type { BlogPosting, CreativeWork, FAQPage, Organization, ProfessionalService, Service, WebSite, WithContext } from "schema-dts";
import { branding } from "~/config/branding";
import { company } from "~/config/company";
import { absoluteUrl, serializeJsonLd, type JsonLdSchema } from "~/shared/lib/schema/jsonLd";

interface Props {
  type?: "organization" | "website" | "article" | "service" | "project";
  article?: { title?: string; description?: string; image?: string; datePublished?: string; dateModified?: string; author?: string };
  service?: { name: string; description: string; image?: string; url?: string; serviceType?: string; price?: number; priceCurrency?: string };
  project?: { name: string; description: string; image?: string; client?: string; datePublished?: string; url?: string; services?: string[] };
  faqs?: { question: string; answer: string }[];
}

const { type = "organization", article, service, project, faqs } = Astro.props;
const base = new URL(Astro.site?.toString() ?? branding.url);
const baseUrl = base.toString().replace(/\/$/, "");
const organizationId = `${baseUrl}/#organization`;
const addressId = `${baseUrl}/#address`;
const websiteId = `${baseUrl}/#website`;
const currentUrl = new URL(Astro.url.pathname, base).toString();

const address = {
  "@type": "PostalAddress",
  "@id": addressId,
  ...company.address,
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": organizationId,
  name: branding.name,
  legalName: branding.legalName,
  taxID: branding.legal.nif,
  url: baseUrl,
  logo: absoluteUrl(branding.assets.logo, base),
  image: absoluteUrl(branding.assets.thumbnail, base),
  description: branding.slogan,
  email: branding.contact.email,
  telephone: branding.contact.whatsapp.displayNumber,
  address: { "@id": addressId },
  sameAs: Object.values(branding.social),
} satisfies WithContext<Organization>;

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${baseUrl}/#professional-service`,
  name: branding.name,
  url: baseUrl,
  provider: { "@id": organizationId },
  address,
  geo: { "@type": "GeoCoordinates", latitude: company.geo.latitude, longitude: company.geo.longitude },
  hasMap: "https://www.google.com/maps/search/?api=1&query=Premi%C3%A0+de+Mar",
  areaServed: company.serviceAreas.map((name) => ({ "@type": name === "España" ? "Country" : "Place", name })),
      contactPoint: company.contactPoints.map((point) => ({
        "@type": "ContactPoint",
        ...point,
      })),
  openingHoursSpecification: company.openingHours.map((hours) => ({
    "@type": "OpeningHoursSpecification",
    ...hours,
  })),
} as unknown as WithContext<ProfessionalService>;

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  name: branding.name,
  url: baseUrl,
  description: branding.slogan,
  publisher: { "@id": organizationId },
} satisfies WithContext<WebSite>;

const schemas: JsonLdSchema[] = [organizationSchema, professionalServiceSchema as WithContext<ProfessionalService>];
if (type === "website") schemas.push(websiteSchema);

if (article) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": `${currentUrl}#article`,
    headline: article.title,
    description: article.description,
    image: absoluteUrl(article.image, base),
    datePublished: article.datePublished,
    dateModified: article.dateModified || article.datePublished,
    inLanguage: "es-ES",
    author: article.author ? { "@type": "Person", name: article.author } : { "@id": organizationId },
    publisher: { "@id": organizationId },
    mainEntityOfPage: { "@id": currentUrl },
  } satisfies WithContext<BlogPosting>);
}

if (service) {
  const serviceUrl = absoluteUrl(service.url || Astro.url.pathname, base) as string;
  schemas.push({
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${serviceUrl}#service`,
    name: service.name,
    description: service.description,
    image: absoluteUrl(service.image, base),
    serviceType: service.serviceType,
    url: serviceUrl,
    provider: { "@id": organizationId },
    areaServed: { "@type": "Country", name: "España" },
    ...(service.price !== undefined ? { offers: { "@type": "Offer", price: service.price, priceCurrency: service.priceCurrency || "EUR", url: serviceUrl } } : {}),
  } satisfies WithContext<Service>);
}

if (project) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "@id": `${absoluteUrl(project.url || Astro.url.pathname, base)}#project`,
    name: project.name,
    description: project.description,
    image: absoluteUrl(project.image, base),
    datePublished: project.datePublished,
    url: absoluteUrl(project.url || Astro.url.pathname, base),
    inLanguage: "es-ES",
    creator: { "@id": organizationId },
    ...(project.client ? { funder: { "@type": "Organization", name: project.client } } : {}),
    ...(project.services?.length ? { keywords: project.services.join(", ") } : {}),
  } satisfies WithContext<CreativeWork>);
}

if (faqs?.length) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
  } satisfies WithContext<FAQPage>);
}
---

{schemas.map((schema) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(schema)} />)}
