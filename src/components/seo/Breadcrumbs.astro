---
import { serializeJsonLd } from "~/shared/lib/schema/jsonLd";
import { cn } from "~/shared/lib/utils";

/**
 * Breadcrumbs Schema.org para mejorar SEO y navegación
 * Google muestra breadcrumbs en los resultados de búsqueda
 */

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
  className?: string;
}

const { items, className } = Astro.props;
const baseUrl = (Astro.site?.toString() || "https://doscientos.es").replace(/\/$/, "");
const showVisualBreadcrumbs = items.length > 1;

// Siempre incluir Home como primer item
const breadcrumbItems = [{ name: "Inicio", url: baseUrl }, ...items];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: new URL(item.url, baseUrl).toString(),
  })),
};
---

<!-- Breadcrumb Schema -->
<script
  type="application/ld+json"
  is:inline
  set:html={serializeJsonLd(breadcrumbSchema)}
/>

<!-- Ocultamos la miga visual si solo hay Inicio + una página, pero mantenemos el Schema. -->{
  showVisualBreadcrumbs && (
    <nav
      aria-label="Breadcrumb"
      class={cn(`text-sm text-muted-foreground mb-8`, className)}
    >
      <ol class="flex items-center gap-2">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && (
              <svg
                class="size-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            )}
            {index === breadcrumbItems.length - 1 ? (
              <span class="text-foreground font-medium">{item.name}</span>
            ) : (
              <a href={item.url} class="hover:text-primary transition-colors">
                {item.name}
              </a>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
