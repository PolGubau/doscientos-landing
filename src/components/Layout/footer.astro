---
import { Mail, MapPin } from "@lucide/astro";
import { Icon } from "astro-icon/components";
import { branding } from "~/config/branding";
import { footerLinkColumns } from "~/data/commercialRoutes";
import { copy } from "~/shared/lib/copy";
import { buildTrackedWhatsappUrl } from "~/shared/lib/attribution";
import FinalCTA from "../sections/FinalCTA.astro";

interface Props {
  showCta?: boolean;
}

const { showCta = true } = Astro.props;
const currentYear = new Date().getFullYear();
const linkColumns = footerLinkColumns;
const whatsappHref = buildTrackedWhatsappUrl({
  phone: branding.contact.whatsapp.number,
  text: branding.contact.whatsapp.defaultMessage,
  conversionStep: "whatsapp_footer",
  landingRef: "footer",
});

const socialLinks = [
  {
    label: "LinkedIn",
    href: branding.social.linkedin,
    icon: "simple-icons:linkedin",
  },
  {
    label: "X / Twitter",
    href: branding.social.twitter,
    icon: "simple-icons:x",
  },
  {
    label: "GitHub",
    href: branding.social.github,
    icon: "simple-icons:github",
  },
  {
    label: "Instagram",
    href: branding.social.instagram,
    icon: "simple-icons:instagram",
  },
  {
    label: "Brandfetch",
    href: branding.social.brandfetch,
    icon: "simple-icons:brandfetch",
  },
];
---

<section class="bg-foreground text-background">
  {
    showCta && (
      <div class="bg-background rounded-b-[5vw] py-16">
        <FinalCTA />
      </div>
    )
  }

  <footer class="bg-foreground text-background py-20 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-6 lg:grid-cols-12 gap-12">
        <div class="md:col-span-6 lg:col-span-4 space-y-8">
          <div class="space-y-4">
            <div class="flex items-center gap-2.5">
              <img
                src="/iso.svg"
                alt=""
                aria-hidden="true"
                class="h-7 w-auto object-contain brightness-0 invert opacity-90"
              />
              <h3 class="text-3xl font-semibold lowercase">
                {branding.name}
              </h3>
            </div>
            <p class="text-background/70 text-lg max-w-md text-balance">
              {copy.footer.tagline}
            </p>
            <div class="flex flex-col gap-3 pt-2">
              <a
                href={`mailto:${branding.contact.email}`}
                class="group flex items-center gap-3 text-sm text-background/70 hover:text-background transition-colors"
              >
                <Mail
                  class="size-4 text-background/50 group-hover:text-background transition-colors"
                />
                {branding.contact.email}
              </a>
              <a
                href={whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-3 text-sm text-background/70 hover:text-background transition-colors"
              >
                <Icon
                  name="simple-icons:whatsapp"
                  class="size-4 text-background/50 group-hover:text-background transition-colors"
                />
                WhatsApp: {branding.contact.whatsapp.displayNumber}
              </a>
              <p class="flex items-center gap-3 text-sm text-background/70">
                <MapPin class="size-4 text-background/50" />
                {branding.location.city}, {branding.location.country}
              </p>
            </div>
          </div>

          <div class="flex items-center gap-3 pt-2">
            {
              socialLinks.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="group size-11 overflow-hidden rounded-full bg-background/10 border border-background/15 flex items-center justify-center transition-colors hover:bg-background/20"
                >
                  <Icon
                    name={social.icon}
                    class="size-6 shrink-0 text-background/80 group-hover:text-background duration-300 ease-[cubic-bezier(.34,1.56,.64,1)]"
                  />
                </a>
              ))
            }
          </div>
        </div>

        <div
          class="md:col-span-6 lg:col-span-8 grid grid-cols-1 sm:grid-cols-3 gap-8"
        >
          {
            linkColumns.map((column) => (
              <div class="space-y-6">
                <h4 class="text-sm font-medium text-background/50 uppercase tracking-wider">
                  {column.title}
                </h4>
                <ul class="space-y-3">
                  {column.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="inline-block text-sm tracking-tight text-background/70 hover:text-background hover:translate-x-1 transition-all"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="mt-16 pt-8 border-t border-background/10 flex flex-col md:flex-row justify-between items-center gap-6"
      >
        <p class="text-sm text-background/50">
          {copy.footer.copyright.replace("2026", currentYear.toString())}
        </p>
        <div
          class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-background/50"
        >
          <a href="/legal" class="hover:text-background transition-colors">
            Aviso legal
          </a>
          <a href="/terminos" class="hover:text-background transition-colors">
            Terminos
          </a>
          <a href="/privacy" class="hover:text-background transition-colors">
            Privacidad
          </a>
          <a href="/cookies" class="hover:text-background transition-colors">
            Cookies
          </a>
          <button
            type="button"
            onclick="window.__openCookieSettings?.()"
            class="hover:text-background transition-colors cursor-pointer"
          >
            Preferencias
          </button>
        </div>
      </div>
    </div>
  </footer>
</section>
