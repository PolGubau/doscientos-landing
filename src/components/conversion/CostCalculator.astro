---
interface Props {
  compact?: boolean;
  /** Base path for the CTA link. Defaults to "/diagnostico".
   *  Pass "" to stay on the current page (diagnostico itself). */
  ctaBase?: string;
}

const { compact = false, ctaBase = "/diagnostico" } = Astro.props;
---

<section
  id="calculadora-coste"
  class:list={[
    "scroll-mt-28 rounded-3xl border border-muted bg-accent/60 p-6 md:p-8 space-y-6",
    compact ? "" : "max-w-5xl mx-auto",
  ]}
>
  <article class="grid lg:grid-cols-[0.9fr_1.1fr] gap-8 items-start">
    <header class="space-y-4">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground">
        Calcula cuanto cuesta seguir haciendolo a mano.
      </h2>
      <p class="text-muted-foreground leading-relaxed">
        No todas las tareas merecen software. Pero si se repiten cada semana,
        afectan a varias personas y tienen riesgo de error, conviene ponerles un
        numero.
      </p>
    </header>

    <form class="space-y-4" data-cost-calculator>
      <div class="grid sm:grid-cols-2 gap-4">
        <label class="space-y-1.5">
          <span class="text-sm font-medium text-foreground"
            >Minutos por vez</span
          >
          <input
            name="minutes"
            type="number"
            min="1"
            value="20"
            class="h-12 w-full rounded-xl border border-muted-foreground/30 bg-background px-4 text-foreground"
          />
        </label>
        <label class="space-y-1.5">
          <span class="text-sm font-medium text-foreground"
            >Veces por semana</span
          >
          <input
            name="weekly"
            type="number"
            min="1"
            value="5"
            class="h-12 w-full rounded-xl border border-muted-foreground/30 bg-background px-4 text-foreground"
          />
        </label>
        <label class="space-y-1.5">
          <span class="text-sm font-medium text-foreground"
            >Personas implicadas</span
          >
          <input
            name="people"
            type="number"
            min="1"
            value="2"
            class="h-12 w-full rounded-xl border border-muted-foreground/30 bg-background px-4 text-foreground"
          />
        </label>
        <label class="space-y-1.5">
          <span class="text-sm font-medium text-foreground"
            >Coste/hora estimado</span
          >
          <input
            name="hourly"
            type="number"
            min="1"
            value="25"
            class="h-12 w-full rounded-xl border border-muted-foreground/30 bg-background px-4 text-foreground"
          />
        </label>
      </div>

      <div class="rounded-2xl bg-background border border-muted p-5 space-y-4">
        <div class="grid sm:grid-cols-3 gap-4">
          <div>
            <p class="text-sm text-muted-foreground">Horas al año</p>
            <p class="text-2xl font-bold text-foreground" data-cost-hours>0</p>
          </div>
          <div>
            <p class="text-sm text-muted-foreground">Coste anual</p>
            <p class="text-2xl font-bold text-primary" data-cost-year>0 EUR</p>
          </div>
          <div>
            <p class="text-sm text-muted-foreground">Riesgo</p>
            <p class="text-2xl font-bold text-foreground" data-cost-risk>
              Medio
            </p>
          </div>
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed" data-cost-note>
          Si este coste supera varios miles de euros al año, merece revisar si
          una automatización pequeña puede pagarse sola.
        </p>
        <a
          href="/diagnostico?ref=calculadora-coste"
          class="inline-flex rounded-full bg-primary px-5 py-3 font-semibold text-background hover:opacity-90 transition-opacity"
          data-calculator-cta
          data-cta-base={ctaBase}
        >
          Recibir resumen y revisar proceso
        </a>
      </div>
    </form>
  </article>
</section>

<script>
  import { trackEvent } from "~/shared/lib/attribution";

  const formatEuro = new Intl.NumberFormat("es-ES", {
    style: "currency",
    currency: "EUR",
    maximumFractionDigits: 0,
  });

  document.querySelectorAll("[data-cost-calculator]").forEach((form) => {
    const inputs = form.querySelectorAll("input");
    const hoursEl = form.querySelector("[data-cost-hours]");
    const yearEl = form.querySelector("[data-cost-year]");
    const riskEl = form.querySelector("[data-cost-risk]");
    const noteEl = form.querySelector("[data-cost-note]");
    const cta = form.querySelector("[data-calculator-cta]");

    const calculate = () => {
      const data = new FormData(form as HTMLFormElement);
      const minutes = Number(data.get("minutes") || 0);
      const weekly = Number(data.get("weekly") || 0);
      const people = Number(data.get("people") || 0);
      const hourly = Number(data.get("hourly") || 0);
      const yearlyHours = Math.round((minutes * weekly * people * 52) / 60);
      const yearlyCost = Math.round(yearlyHours * hourly);
      const risk =
        yearlyCost >= 10000 ? "Alto" : yearlyCost >= 4000 ? "Medio" : "Bajo";

      if (hoursEl) hoursEl.textContent = `${yearlyHours} h`;
      if (yearEl) yearEl.textContent = formatEuro.format(yearlyCost);
      if (riskEl) riskEl.textContent = risk;
      if (noteEl) {
        noteEl.textContent =
          yearlyCost >= 4000
            ? "Este proceso ya tiene tamaño suficiente para revisarlo: puede haber ahorro, menos errores y más control."
            : "El coste directo parece moderado. Revisaríamos si el mayor problema está en los errores, los retrasos o las oportunidades perdidas.";
      }
      if (cta instanceof HTMLAnchorElement) {
        const base = cta.dataset.ctaBase ?? "/diagnostico";
        cta.href = `${base}?ref=calculadora-coste&coste=${yearlyCost}&horas=${yearlyHours}#formulario`;
      }

      if ("gtag" in window) {
        // @ts-ignore
        window.gtag("event", "calculator_used", {
          event_category: "conversion",
          event_label: "cost_calculator",
          yearly_cost: yearlyCost,
          yearly_hours: yearlyHours,
        });
      }

      return { yearlyCost, yearlyHours };
    };

    // El evento de negocio se registra una sola vez por visita: cada tecla
    // recalcula, pero solo la primera interacción real cuenta como uso.
    let usageTracked = false;
    inputs.forEach((input) =>
      input.addEventListener("input", () => {
        const result = calculate();
        if (usageTracked) return;
        usageTracked = true;
        trackEvent("calculator_used", {
          conversionStep: "calculator",
          payload: {
            calculator: "cost",
            yearly_cost: result.yearlyCost,
            yearly_hours: result.yearlyHours,
          },
        });
      }),
    );
    cta?.addEventListener("click", () => {
      if ("gtag" in window) {
        // @ts-ignore
        window.gtag("event", "cta_click", {
          event_category: "conversion",
          event_label: "calculator_review_process",
        });
      }
      trackEvent("cta_click", {
        conversionStep: "calculator",
        payload: { cta: "calculator_review_process" },
      });
    });
    calculate();
  });
</script>
