---

---

<section
  id="calculadora-coste"
  class="scroll-mt-28 w-full overflow-hidden rounded-[2rem] border border-muted bg-background shadow-[0_24px_70px_rgb(18_43_25_/_0.08)]"
>
  <div class="grid lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)]">
    <header
      class="relative overflow-hidden bg-foreground px-7 py-9 text-background sm:px-10 sm:py-12 lg:min-h-full"
    >
      <div
        class="absolute -right-24 -top-24 size-72 rounded-full bg-primary/20 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative flex h-full flex-col">
        <h2
          class="text-3xl font-bold tracking-tight text-background md:text-4xl lg:text-[2.65rem] lg:leading-[1.04] text-balance"
        >
          ¿Cuánto os cuesta seguir haciéndolo a mano?
        </h2>
        <p class="mt-5 max-w-sm leading-relaxed text-background/70">
          Cuéntanos la tarea tal como ocurre. Verás una estimación antes de
          dejarnos el correo.
        </p>
        <div class="mt-10 border-t border-background/15 pt-5 lg:mt-auto">
          <p class="text-sm font-semibold text-background">Lo que vas a ver</p>
          <ul class="mt-4 space-y-3 text-sm text-background/65">
            <li class="flex gap-3">
              <span class="text-primary">•</span>Horas que consume el equipo
              cada mes
            </li>
            <li class="flex gap-3">
              <span class="text-primary">•</span>Coste anual aproximado de
              mantenerlo igual
            </li>
            <li class="flex gap-3">
              <span class="text-primary">•</span>Una señal clara para decidir si
              priorizarlo
            </li>
          </ul>
        </div>
      </div>
    </header>

    <div class="min-w-0 bg-background p-7 sm:p-10 lg:p-12">
      <form data-diagnostic-calculator class="mx-auto max-w-xl space-y-8">
        <div class="space-y-2" aria-live="polite">
          <div
            class="flex items-center justify-between text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground"
          >
            <span data-diagnostic-step-label>Paso 1 de 3</span>
            <span data-diagnostic-progress-percent>33%</span>
          </div>
          <div
            class="h-2 overflow-hidden rounded-full bg-muted"
            aria-hidden="true"
          >
            <div
              data-diagnostic-progress
              class="h-full w-1/3 rounded-full bg-primary transition-all duration-300"
            >
            </div>
          </div>
        </div>

        <section data-diagnostic-step="1" class="space-y-6">
          <div class="space-y-2">
            <h3
              data-diagnostic-step-heading
              tabindex="-1"
              class="text-2xl font-bold tracking-tight text-foreground md:text-3xl"
            >
              Empecemos por la tarea que más se repite
            </h3>
            <p class="leading-relaxed text-muted-foreground">
              No hace falta saber de procesos: cuéntanoslo como se lo contarías
              a un compañero.
            </p>
          </div>
          <label class="block space-y-2">
            <span class="text-sm font-semibold text-foreground"
              >¿Qué tarea quieres quitarte de encima?</span
            >
            <input
              name="process"
              required
              placeholder="Ej. Pasar pedidos de email a Excel"
              autocomplete="off"
              class="h-14 w-full rounded-2xl border border-muted-foreground/25 bg-muted/30 px-4 text-base text-foreground transition placeholder:text-muted-foreground/70 focus:border-primary focus:bg-background focus:ring-2 focus:ring-primary/15"
            />
            <span class="block text-xs text-muted-foreground"
              >Puede ser copiar datos, perseguir documentos, preparar informes…</span
            >
          </label>
          <label class="block max-w-md space-y-2">
            <span class="text-sm font-semibold text-foreground"
              >¿Cuántas personas la hacen habitualmente?</span
            >
            <input
              name="people"
              type="number"
              min="1"
              value="2"
              required
              inputmode="numeric"
              class="h-14 w-full rounded-2xl border border-muted-foreground/25 bg-muted/30 px-4 text-base text-foreground transition focus:border-primary focus:bg-background focus:ring-2 focus:ring-primary/15"
            />
            <span class="block text-xs text-muted-foreground"
              >Inclúyete si también participas.</span
            >
          </label>
          <button
            type="button"
            data-diagnostic-next
            class="inline-flex min-w-44 w-full items-center justify-center gap-2 rounded-full bg-primary px-6 py-4 font-semibold text-background transition hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/20 sm:w-auto"
            >Continuar <span aria-hidden="true">→</span></button
          >
        </section>

        <section data-diagnostic-step="2" class="hidden space-y-7">
          <div class="space-y-2">
            <h3
              data-diagnostic-step-heading
              tabindex="-1"
              class="text-2xl font-bold tracking-tight text-foreground md:text-3xl"
            >
              Ahora piensa en una semana normal
            </h3>
            <p class="leading-relaxed text-muted-foreground">
              Elige una aproximación. No buscamos una cifra perfecta.
            </p>
          </div>

          <fieldset class="space-y-3">
            <legend class="text-sm font-semibold text-foreground"
              >¿Con qué frecuencia ocurre?</legend
            >
            <div class="grid gap-3 sm:grid-cols-3">
              <label
                class="min-h-28 cursor-pointer rounded-2xl border border-primary bg-primary/5 p-4 text-sm transition duration-200 hover:-translate-y-0.5 hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary/10 has-[:checked]:shadow-sm"
              >
                <input
                  class="sr-only"
                  type="radio"
                  name="frequency"
                  value="daily"
                  checked
                />
                <strong class="block text-foreground">Cada día laboral</strong
                ><span class="mt-1 block text-muted-foreground"
                  >Lo habitual</span
                >
              </label>
              <label
                class="min-h-28 cursor-pointer rounded-2xl border border-muted-foreground/25 bg-muted/20 p-4 text-sm transition duration-200 hover:-translate-y-0.5 hover:border-primary/60 hover:bg-background has-[:checked]:border-primary has-[:checked]:bg-primary/10 has-[:checked]:shadow-sm"
              >
                <input
                  class="sr-only"
                  type="radio"
                  name="frequency"
                  value="weekly"
                />
                <strong class="block text-foreground"
                  >Algunas veces por semana</strong
                ><span class="mt-1 block text-muted-foreground"
                  >No todos los días</span
                >
              </label>
              <label
                class="min-h-28 cursor-pointer rounded-2xl border border-muted-foreground/25 bg-muted/20 p-4 text-sm transition duration-200 hover:-translate-y-0.5 hover:border-primary/60 hover:bg-background has-[:checked]:border-primary has-[:checked]:bg-primary/10 has-[:checked]:shadow-sm"
              >
                <input
                  class="sr-only"
                  type="radio"
                  name="frequency"
                  value="monthly"
                />
                <strong class="block text-foreground"
                  >Algunas veces al mes</strong
                ><span class="mt-1 block text-muted-foreground"
                  >Puntualmente</span
                >
              </label>
            </div>
          </fieldset>

          <label class="block max-w-md space-y-2">
            <span
              data-diagnostic-frequency-question
              class="text-sm font-semibold text-foreground"
              >En un día normal, ¿cuántas veces ocurre?</span
            >
            <input
              data-diagnostic-times
              name="times"
              type="number"
              min="1"
              value="1"
              required
              inputmode="numeric"
              class="h-14 w-full rounded-2xl border border-muted-foreground/25 bg-muted/30 px-4 text-base text-foreground transition focus:border-primary focus:bg-background focus:ring-2 focus:ring-primary/15"
            />
            <span
              data-diagnostic-frequency-hint
              class="block text-xs text-muted-foreground"
              >Calcularemos 5 días laborables por semana.</span
            >
          </label>

          <fieldset class="space-y-3">
            <legend class="text-sm font-semibold text-foreground"
              >Cuando ocurre, suele llevaros…</legend
            >
            <input
              type="hidden"
              name="minutes"
              value="15"
              data-diagnostic-minutes
            />
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              <button
                type="button"
                data-diagnostic-duration="5"
                aria-pressed="false"
                class="min-h-28 rounded-2xl border border-muted-foreground/25 bg-muted/20 p-4 text-left text-sm transition duration-200 hover:-translate-y-0.5 hover:border-primary/60 hover:bg-background"
                ><strong class="block text-foreground">Menos de 5 min</strong
                ><span class="text-muted-foreground">Una gestión rápida</span
                ></button
              >
              <button
                type="button"
                data-diagnostic-duration="15"
                aria-pressed="true"
                class="min-h-28 rounded-2xl border border-primary bg-primary/10 p-4 text-left text-sm shadow-sm transition duration-200"
                ><strong class="block text-foreground">10–20 min</strong><span
                  class="text-muted-foreground">Lo normal</span
                ></button
              >
              <button
                type="button"
                data-diagnostic-duration="30"
                aria-pressed="false"
                class="min-h-28 rounded-2xl border border-muted-foreground/25 bg-muted/20 p-4 text-left text-sm transition duration-200 hover:-translate-y-0.5 hover:border-primary/60 hover:bg-background"
                ><strong class="block text-foreground">20–45 min</strong><span
                  class="text-muted-foreground">Requiere atención</span
                ></button
              >
              <button
                type="button"
                data-diagnostic-duration="60"
                aria-pressed="false"
                class="min-h-28 rounded-2xl border border-muted-foreground/25 bg-muted/20 p-4 text-left text-sm transition duration-200 hover:-translate-y-0.5 hover:border-primary/60 hover:bg-background"
                ><strong class="block text-foreground">Más de una hora</strong
                ><span class="text-muted-foreground">Trabajo profundo</span
                ></button
              >
            </div>
          </fieldset>

          <div
            class="space-y-5 rounded-3xl bg-foreground p-6 text-background shadow-lg shadow-foreground/10"
          >
            <div class="flex items-end justify-between gap-4">
              <div>
                <p class="text-sm text-background/60">
                  Tiempo que se va cada mes
                </p><p
                  class="text-4xl font-bold tracking-tight text-background"
                  data-diagnostic-hours
                >
                  0 h/mes
                </p>
              </div>
              <p class="text-right text-sm text-background/60">
                Coste anual estimado<br /><strong
                  class="text-xl text-background"
                  data-diagnostic-cost>0 €</strong
                >
              </p>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-background/15">
              <div
                data-diagnostic-meter
                class="h-full rounded-full bg-[var(--brand-lime)] transition-all duration-500"
                style="width: 12%"
              >
              </div>
            </div>
            <p
              class="text-sm leading-relaxed text-background/70"
              data-diagnostic-note
            >
              Tu estimación aparecerá aquí.
            </p>
          </div>

          <div
            class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-between"
          >
            <button
              type="button"
              data-diagnostic-back
              class="rounded-full px-4 py-3 text-sm font-semibold text-muted-foreground transition hover:bg-muted hover:text-foreground"
              >Volver</button
            >
            <button
              type="button"
              data-diagnostic-next
              class="inline-flex min-w-56 items-center justify-center gap-2 rounded-full bg-primary px-6 py-4 font-semibold text-background transition hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/20"
              >Ver el diagnóstico completo <span aria-hidden="true">→</span
              ></button
            >
          </div>
        </section>

        <section data-diagnostic-step="3" class="hidden space-y-6">
          <div class="space-y-2">
            <h3
              data-diagnostic-step-heading
              tabindex="-1"
              class="text-2xl font-bold tracking-tight text-foreground md:text-3xl"
            >
              Tu estimación ya está lista
            </h3><p class="leading-relaxed text-muted-foreground">
              Déjanos un email y te enviamos la lectura completa, con próximos
              pasos prácticos.
            </p>
          </div>
          <div
            class="rounded-3xl bg-foreground p-6 text-background shadow-lg shadow-foreground/10"
          >
            <p class="text-sm text-background/60">
              En este proceso se van aproximadamente
            </p><p
              class="mt-1 text-3xl font-bold tracking-tight text-background sm:text-4xl"
            >
              <span data-diagnostic-hours>0 h/mes</span> · <span
                class="text-[var(--brand-lime)]"
                data-diagnostic-cost>0 €</span
              ><span class="text-base font-medium text-background/60">/año</span
              >
            </p>
          </div>
          <fieldset class="space-y-3">
            <legend class="text-sm font-semibold text-foreground"
              >Para afinar el coste, ¿qué encaja mejor?</legend
            ><div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              <label
                class="cursor-pointer rounded-2xl border border-muted-foreground/25 bg-muted/20 p-4 text-center text-sm font-semibold transition hover:border-primary/60 hover:bg-background has-[:checked]:border-primary has-[:checked]:bg-primary/10 has-[:checked]:shadow-sm"
                ><input
                  class="sr-only"
                  type="radio"
                  name="hourly"
                  value="20"
                />20 €/h</label
              ><label
                class="cursor-pointer rounded-2xl border border-primary bg-primary/10 p-4 text-center text-sm font-semibold shadow-sm transition has-[:checked]:border-primary has-[:checked]:bg-primary/10"
                ><input
                  class="sr-only"
                  type="radio"
                  name="hourly"
                  value="25"
                  checked
                />25 €/h</label
              ><label
                class="cursor-pointer rounded-2xl border border-muted-foreground/25 bg-muted/20 p-4 text-center text-sm font-semibold transition hover:border-primary/60 hover:bg-background has-[:checked]:border-primary has-[:checked]:bg-primary/10 has-[:checked]:shadow-sm"
                ><input
                  class="sr-only"
                  type="radio"
                  name="hourly"
                  value="40"
                />40 €/h</label
              ><label
                class="cursor-pointer rounded-2xl border border-muted-foreground/25 bg-muted/20 p-4 text-center text-sm font-semibold transition hover:border-primary/60 hover:bg-background has-[:checked]:border-primary has-[:checked]:bg-primary/10 has-[:checked]:shadow-sm"
                ><input
                  class="sr-only"
                  type="radio"
                  name="hourly"
                  value="25"
                />No lo sé</label
              >
            </div>
          </fieldset>
          <fieldset class="space-y-3">
            <legend class="text-sm font-semibold text-foreground"
              >Si esta tarea falla, ¿qué suele pasar?</legend
            ><div class="grid gap-3 sm:grid-cols-2">
              <label
                class="cursor-pointer rounded-2xl border border-primary bg-primary/10 p-4 text-sm font-semibold shadow-sm has-[:checked]:border-primary"
                ><input
                  class="sr-only"
                  type="radio"
                  name="impact"
                  value="Retrasos y seguimiento manual"
                  checked
                />Retrasos y seguimiento manual</label
              ><label
                class="cursor-pointer rounded-2xl border border-muted-foreground/25 bg-muted/20 p-4 text-sm font-semibold transition hover:border-primary/60 hover:bg-background has-[:checked]:border-primary has-[:checked]:bg-primary/10 has-[:checked]:shadow-sm"
                ><input
                  class="sr-only"
                  type="radio"
                  name="impact"
                  value="Errores o datos duplicados"
                />Errores o datos duplicados</label
              ><label
                class="cursor-pointer rounded-2xl border border-muted-foreground/25 bg-muted/20 p-4 text-sm font-semibold transition hover:border-primary/60 hover:bg-background has-[:checked]:border-primary has-[:checked]:bg-primary/10 has-[:checked]:shadow-sm"
                ><input
                  class="sr-only"
                  type="radio"
                  name="impact"
                  value="Se pierden oportunidades"
                />Se pierden oportunidades</label
              ><label
                class="cursor-pointer rounded-2xl border border-muted-foreground/25 bg-muted/20 p-4 text-sm font-semibold transition hover:border-primary/60 hover:bg-background has-[:checked]:border-primary has-[:checked]:bg-primary/10 has-[:checked]:shadow-sm"
                ><input
                  class="sr-only"
                  type="radio"
                  name="impact"
                  value="Un poco de todo"
                />Un poco de todo</label
              >
            </div>
          </fieldset>
          <div class="grid gap-4 md:grid-cols-2">
            <input
              name="name"
              placeholder="Tu nombre (opcional)"
              autocomplete="name"
              class="h-14 rounded-2xl border border-muted-foreground/25 bg-muted/30 px-4 text-base text-foreground placeholder:text-muted-foreground/70 transition focus:border-primary focus:bg-background focus:ring-2 focus:ring-primary/15"
            /><input
              name="company"
              placeholder="Empresa (opcional)"
              autocomplete="organization"
              class="h-14 rounded-2xl border border-muted-foreground/25 bg-muted/30 px-4 text-base text-foreground placeholder:text-muted-foreground/70 transition focus:border-primary focus:bg-background focus:ring-2 focus:ring-primary/15"
            /><input
              name="email"
              type="email"
              required
              placeholder="Tu email profesional"
              autocomplete="email"
              class="h-14 rounded-2xl border border-muted-foreground/25 bg-muted/30 px-4 text-base text-foreground placeholder:text-muted-foreground/70 transition focus:border-primary focus:bg-background focus:ring-2 focus:ring-primary/15 md:col-span-2"
            />
          </div>
          <label class="flex items-start gap-3 text-xs text-muted-foreground"
            ><input
              type="checkbox"
              name="consent"
              required
              class="mt-0.5 accent-primary"
            /><span
              >Acepto recibir este diagnóstico y comunicaciones relacionadas con
              mi solicitud. Puedo darme de baja cuando quiera.</span
            ></label
          >
          <div
            class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-between"
          >
            <button
              type="button"
              data-diagnostic-back
              class="rounded-full px-4 py-3 text-sm font-semibold text-muted-foreground transition hover:bg-muted hover:text-foreground"
              >Volver</button
            ><button
              type="submit"
              class="inline-flex min-w-60 items-center justify-center gap-2 rounded-full bg-primary px-6 py-4 font-semibold text-background transition hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/20"
              data-diagnostic-submit
              >Enviarme el diagnóstico completo <span aria-hidden="true">→</span
              ></button
            >
          </div>
          <p
            class="hidden text-sm text-red-600"
            data-diagnostic-error
            role="alert"
          >
          </p>
          <div
            class="hidden rounded-xl border border-primary/20 bg-primary/5 p-4 text-sm text-foreground space-y-3"
            data-diagnostic-fallback
          >
            <p>
              Para que no se pierda tu solicitud, puedes continuar con el
              formulario de contacto.
            </p>
            <a
              data-diagnostic-contact
              href="/contact?ref=diagnostico-error"
              class="inline-flex rounded-full bg-primary px-4 py-2 font-semibold text-background transition-opacity hover:opacity-90"
              >Continuar con el formulario de contacto</a
            >
          </div>
        </section>
      </form>
      <div
        class="hidden space-y-4 rounded-3xl border border-primary/20 bg-primary/5 p-7"
        data-diagnostic-success
      >
        <p
          class="text-xs font-semibold uppercase tracking-[0.18em] text-primary"
        >
          Listo
        </p><h3 class="text-2xl font-bold text-foreground">
          Tu diagnóstico va de camino.
        </h3><p class="text-muted-foreground">
          Revisa tu bandeja de entrada. También puedes descargarlo desde el
          enlace que te hemos enviado.
        </p><a
          data-diagnostic-report
          href="#"
          class="inline-flex rounded-full bg-primary px-5 py-3 font-semibold text-background"
          >Ver mi diagnóstico online</a
        >
      </div>
    </div>
  </div>
</section>

<script>
  import {
    buildAttributionPayload,
    trackEvent,
  } from "~/shared/lib/attribution";
  const endpoint =
    import.meta.env.PUBLIC_DIAGNOSTIC_ENDPOINT ||
    (import.meta.env.DEV
      ? "http://localhost:3000/api/public/diagnostics"
      : "https://app.doscientos.es/api/public/diagnostics");
  const euro = new Intl.NumberFormat("es-ES", {
    style: "currency",
    currency: "EUR",
    maximumFractionDigits: 0,
  });
  document
    .querySelectorAll<HTMLFormElement>("[data-diagnostic-calculator]")
    .forEach((form) => {
      const totalSteps = 3;
      let currentStep = 1;
      const stepEls = form.querySelectorAll<HTMLElement>(
        "[data-diagnostic-step]",
      );
      const hoursEls = form.querySelectorAll<HTMLElement>(
        "[data-diagnostic-hours]",
      );
      const costEls = form.querySelectorAll<HTMLElement>(
        "[data-diagnostic-cost]",
      );
      const noteEl = form.querySelector<HTMLElement>("[data-diagnostic-note]");
      const meterEl = form.querySelector<HTMLElement>(
        "[data-diagnostic-meter]",
      );
      const stepLabelEl = form.querySelector<HTMLElement>(
        "[data-diagnostic-step-label]",
      );
      const progressEl = form.querySelector<HTMLElement>(
        "[data-diagnostic-progress]",
      );
      const progressPercentEl = form.querySelector<HTMLElement>(
        "[data-diagnostic-progress-percent]",
      );
      const minutesEl = form.querySelector<HTMLInputElement>(
        "[data-diagnostic-minutes]",
      );
      const frequencyQuestionEl = form.querySelector<HTMLElement>(
        "[data-diagnostic-frequency-question]",
      );
      const frequencyHintEl = form.querySelector<HTMLElement>(
        "[data-diagnostic-frequency-hint]",
      );
      const errorEl = form.querySelector<HTMLElement>(
        "[data-diagnostic-error]",
      );
      const fallbackEl = form.querySelector<HTMLElement>(
        "[data-diagnostic-fallback]",
      );
      const contactEl = form.querySelector<HTMLAnchorElement>(
        "[data-diagnostic-contact]",
      );
      const successEl = form.parentElement?.querySelector<HTMLElement>(
        "[data-diagnostic-success]",
      );
      const reportEl = successEl?.querySelector<HTMLAnchorElement>(
        "[data-diagnostic-report]",
      );
      const weeklyFrequency = (d: FormData) => {
        const times = Number(d.get("times") || 0);
        switch (d.get("frequency")) {
          case "daily":
            return times * 5;
          case "monthly":
            return Math.round((times / 4.33) * 10) / 10;
          default:
            return times;
        }
      };
      const values = () => {
        const d = new FormData(form);
        const minutes = Number(d.get("minutes") || 0);
        const weekly = weeklyFrequency(d);
        const people = Number(d.get("people") || 0);
        const hourly = Number(d.get("hourly") || 0);
        const monthlyHours = Math.round(
          (minutes * weekly * people * 52) / 12 / 60,
        );
        const yearlyHours = Math.round((minutes * weekly * people * 52) / 60);
        const yearlyCost = Math.round(yearlyHours * hourly);
        return {
          d,
          minutes,
          weekly,
          people,
          hourly,
          monthlyHours,
          yearlyHours,
          yearlyCost,
          risk:
            yearlyCost >= 10000
              ? "Alta"
              : yearlyCost >= 4000
                ? "Media"
                : "Inicial",
        };
      };
      const calculate = () => {
        const m = values();
        hoursEls.forEach((el) => (el.textContent = `${m.monthlyHours} h/mes`));
        costEls.forEach((el) => (el.textContent = euro.format(m.yearlyCost)));
        if (meterEl)
          meterEl.style.width = `${Math.min(100, Math.max(12, m.yearlyCost / 150))}%`;
        if (noteEl)
          noteEl.textContent =
            m.yearlyCost >= 4000
              ? "Ya hay una oportunidad suficiente para revisar este proceso con números y decidir qué automatizar primero."
              : "La cifra directa es moderada; también conviene valorar errores, retrasos y oportunidades perdidas.";
        return m;
      };
      const updateFrequencyCopy = () => {
        const frequency = new FormData(form).get("frequency");
        const copy =
          frequency === "monthly"
            ? [
                "En un mes normal, ¿cuántas veces ocurre?",
                "Lo convertiremos a una media semanal.",
              ]
            : frequency === "weekly"
              ? [
                  "En una semana normal, ¿cuántas veces ocurre?",
                  "Una aproximación es suficiente.",
                ]
              : [
                  "En un día normal, ¿cuántas veces ocurre?",
                  "Calcularemos 5 días laborables por semana.",
                ];
        if (frequencyQuestionEl) frequencyQuestionEl.textContent = copy[0];
        if (frequencyHintEl) frequencyHintEl.textContent = copy[1];
      };
      const setStep = (step: number) => {
        currentStep = step;
        stepEls.forEach((stepEl) => {
          stepEl.classList.toggle(
            "hidden",
            Number(stepEl.dataset.diagnosticStep) !== currentStep,
          );
        });
        const percent = Math.round((currentStep / totalSteps) * 100);
        if (stepLabelEl)
          stepLabelEl.textContent = `Paso ${currentStep} de ${totalSteps}`;
        if (progressPercentEl) progressPercentEl.textContent = `${percent}%`;
        if (progressEl) progressEl.style.width = `${percent}%`;
        const heading = form.querySelector<HTMLElement>(
          `[data-diagnostic-step="${currentStep}"] [data-diagnostic-step-heading]`,
        );
        requestAnimationFrame(() => heading?.focus());
      };
      const validStep = (step: number) => {
        const stepEl = form.querySelector<HTMLElement>(
          `[data-diagnostic-step="${step}"]`,
        );
        if (!stepEl) return true;
        const controls = stepEl.querySelectorAll<
          HTMLInputElement | HTMLSelectElement
        >("input[required], select[required]");
        for (const control of controls) {
          if (!control.checkValidity()) {
            control.reportValidity();
            control.focus();
            return false;
          }
        }
        return true;
      };
      const showSubmissionFallback = (m: ReturnType<typeof values>) => {
        if (errorEl) {
          errorEl.textContent =
            "Ha habido un error técnico al preparar tu diagnóstico. Si la solicitud se ha registrado, te lo enviaremos en cuanto esté listo.";
          errorEl.classList.remove("hidden");
        }
        if (contactEl) {
          const url = new URL("/contact", window.location.origin);
          url.searchParams.set("subject", "Necesito mi diagnóstico");
          url.searchParams.set("ref", "diagnostico-error");
          url.searchParams.set("coste", String(m.yearlyCost));
          url.searchParams.set("horas", String(m.yearlyHours));
          contactEl.href = `${url.pathname}${url.search}`;
        }
        fallbackEl?.classList.remove("hidden");
      };
      // Solo la primera interacción real cuenta como diagnóstico iniciado;
      // el resto de pulsaciones se limitan a recalcular.
      let startTracked = false;
      form.querySelectorAll("input, select").forEach((input) =>
        input.addEventListener("input", () => {
          const m = calculate();
          if (startTracked) return;
          startTracked = true;
          trackEvent("diagnostic_started", {
            conversionStep: "diagnostic_form",
            payload: {
              monthly_hours: m.monthlyHours,
              yearly_cost: m.yearlyCost,
            },
          });
        }),
      );
      form.querySelectorAll("[data-diagnostic-duration]").forEach((button) =>
        button.addEventListener("click", () => {
          const duration = button.getAttribute("data-diagnostic-duration");
          if (minutesEl && duration) minutesEl.value = duration;
          form
            .querySelectorAll<HTMLElement>("[data-diagnostic-duration]")
            .forEach((option) => {
              const selected = option === button;
              option.setAttribute("aria-pressed", String(selected));
              option.classList.toggle("border-primary", selected);
              option.classList.toggle("bg-primary/10", selected);
              option.classList.toggle("border-muted-foreground/30", !selected);
              option.classList.toggle("bg-muted/20", !selected);
            });
          calculate();
        }),
      );
      form
        .querySelectorAll<HTMLInputElement>('input[name="frequency"]')
        .forEach((input) =>
          input.addEventListener("change", () => {
            updateFrequencyCopy();
            calculate();
          }),
        );
      form
        .querySelectorAll<HTMLButtonElement>("[data-diagnostic-next]")
        .forEach((button) =>
          button.addEventListener("click", () => {
            if (!validStep(currentStep)) return;
            const completed = currentStep;
            setStep(Math.min(totalSteps, currentStep + 1));
            trackEvent("diagnostic_step_completed", {
              conversionStep: "diagnostic_form",
              payload: { step: completed },
            });
          }),
        );
      form
        .querySelectorAll<HTMLButtonElement>("[data-diagnostic-back]")
        .forEach((button) =>
          button.addEventListener("click", () =>
            setStep(Math.max(1, currentStep - 1)),
          ),
        );
      updateFrequencyCopy();
      calculate();
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!validStep(currentStep)) return;
        const m = calculate();
        const button = form.querySelector<HTMLButtonElement>(
          "[data-diagnostic-submit]",
        );
        if (button) {
          button.disabled = true;
          button.textContent = "Preparando tu diagnóstico…";
        }
        if (errorEl) errorEl.classList.add("hidden");
        fallbackEl?.classList.add("hidden");
        const d = m.d;
        const process = String(d.get("process") || "");
        const impact = String(d.get("impact") || "");
        const payload = {
          name: String(d.get("name") || ""),
          company: String(d.get("company") || "") || null,
          email: String(d.get("email") || ""),
          answers: {
            proceso: process,
            personas: m.people,
            minutos_por_vez: m.minutes,
            veces_por_semana: m.weekly,
            coste_hora: m.hourly,
            impacto: impact,
          },
          metrics: {
            monthlyHours: m.monthlyHours,
            yearlyHours: m.yearlyHours,
            yearlyCost: m.yearlyCost,
            risk: m.risk,
            primaryOpportunity: process
              ? `Revisar y automatizar el proceso de «${process}» para reducir trabajo repetitivo y errores.`
              : "Revisar el proceso repetitivo con mayor volumen y riesgo.",
          },
          attribution: buildAttributionPayload("diagnostic_completed"),
        };
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 15_000);
        try {
          const response = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
            signal: controller.signal,
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok)
            throw new Error(
              result.error || "No se pudo preparar el diagnóstico",
            );
          form.classList.add("hidden");
          successEl?.classList.remove("hidden");
          if (reportEl && result.reportUrl) reportEl.href = result.reportUrl;
          trackEvent("diagnostic_completed", {
            conversionStep: "diagnostic_form",
            payload: {
              monthly_hours: m.monthlyHours,
              yearly_cost: m.yearlyCost,
              risk: m.risk,
            },
          });
          const browserWindow = window as Window & {
            fbq?: (...args: unknown[]) => void;
          };
          browserWindow.fbq?.("track", "CompleteRegistration", {
            content_name: "diagnostic_completed",
          });
        } catch {
          showSubmissionFallback(m);
          if (button) {
            button.disabled = false;
            button.textContent = "Enviarme el diagnóstico completo";
          }
        } finally {
          window.clearTimeout(timeout);
        }
      });
    });
</script>
