---
import { ArrowUpRight, Check, Code, ShieldCheck } from "@lucide/astro";
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import npmDownloads from "~/data/npm-downloads.json";
import MainLayout from "~/layouts/MainLayout.astro";

const downloads = new Intl.NumberFormat("es-ES").format(
  npmDownloads.totals.downloads,
);
const updatedAt = new Intl.DateTimeFormat("es-ES", {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(npmDownloads.generatedAt));

const foundations = [
  {
    name: "@doscientos/verifactu",
    category: "Facturación y VeriFactu",
    description:
      "Registros de facturación, validación de esquemas oficiales, cadena hash y QR tributario para aplicaciones Node.js.",
    href: "https://github.com/doscientos-es/verifactu",
  },
  {
    name: "@doscientos/billing",
    category: "Lógica de facturación",
    description:
      "Cálculos de impuestos y totales en céntimos, descuentos y snapshots inmutables para productos con cobros recurrentes.",
    href: "https://github.com/doscientos-es/billing",
  },
  {
    name: "@doscientos/pwa",
    category: "Productos preparados para móvil",
    description:
      "Primitivas seguras para instalación y registro de service worker, sin imponer una estrategia de caché a cada producto.",
    href: "https://github.com/doscientos-es/pwa",
  },
  {
    name: "@doscientos/ui",
    category: "Interfaz accesible",
    description:
      "Componentes React accesibles y temables para formularios, datos, navegación y patrones de aplicación consistentes.",
    href: "https://github.com/doscientos-es/ui",
  },
  {
    name: "@doscientos/configs",
    category: "Calidad de ingeniería",
    description:
      "Estándares compartidos de tipado, arquitectura, pruebas y formato para mantener proyectos comprensibles al crecer.",
    href: "https://github.com/doscientos-es/configs",
  },
];
---

<MainLayout
  title="Código abierto y bases técnicas | doscientos"
  description="Las bases técnicas abiertas que mantenemos para construir software de negocio auditable, mantenible y hecho a medida."
>
  <main class="open-source-page">
    <Breadcrumbs
      items={[{ name: "Código abierto", url: "/open-source" }]}
      className="open-source-breadcrumbs"
    />

    <header class="open-source-hero" data-stagger="100">
      <span data-reveal="bottom" class="open-source-eyebrow"
        >CÓDIGO ABIERTO</span
      >
      <h1 data-reveal="bottom" data-speed="normal" data-easing="smooth">
        Una base abierta. <span>Un sistema hecho para tu negocio.</span>
      </h1>
      <p data-reveal="bottom" data-speed="normal" data-easing="soft">
        Publicamos y mantenemos las piezas generales que no deberían ser una
        caja negra. Lo que construimos contigo sigue respondiendo a tu
        operativa, tus datos y tus objetivos.
      </p>
      <p class="open-source-downloads" data-reveal="bottom" data-speed="fast">
        <strong>{downloads}</strong>
        <span>descargas históricas de {npmDownloads.totals.packages} paquetes públicos</span>
      </p>
    </header>

    <section class="open-source-boundary" aria-labelledby="boundary-title">
      <div>
        <span>LO QUE ABRIMOS</span>
        <h2 id="boundary-title">Las bases que compartimos</h2>
        <p>
          Componentes genéricos, auditables y reutilizables que mantenemos en
          público.
        </p>
      </div>
      <div>
        <span>LO QUE CONSTRUIMOS CONTIGO</span>
        <h2>La ventaja de tu negocio</h2>
        <p>
          Procesos, integraciones, datos y experiencia adaptados a la forma real
          en que trabaja tu equipo.
        </p>
      </div>
    </section>

    <section class="open-source-downloads-explained" aria-labelledby="downloads-title">
      <span class="open-source-eyebrow">USO REAL</span>
      <h2 id="downloads-title">Software abierto que se usa.</h2>
      <p>
        La cifra reúne las descargas históricas de los paquetes públicos que
        mantenemos en npm. Es una señal de que las bases que compartimos se
        reutilizan más allá de un único proyecto.
      </p>
      <p class="open-source-downloads-note">
        Una descarga no equivale a una persona usuaria única: puede venir de
        desarrollo, automatizaciones o producción. Instantánea actualizada en {updatedAt}.
      </p>
    </section>

    <section
      class="open-source-foundations"
      aria-labelledby="foundations-title"
    >
      <header>
        <div>
          <span class="open-source-eyebrow">ECOSISTEMA</span>
          <h2 id="foundations-title">Piezas que mantenemos en abierto</h2>
        </div>
        <p>
          No son plantillas que se enchufan sin pensar. Son bases técnicas sobre
          las que diseñamos cada solución con criterio.
        </p>
      </header>

      <ul data-stagger="90">
        {
          foundations.map((foundation) => (
            <li data-reveal="bottom" data-speed="normal" data-easing="soft">
              <Code class="open-source-card-icon" aria-hidden="true" />
              <p>{foundation.category}</p>
              <h3>{foundation.name}</h3>
              <span>{foundation.description}</span>
              <a
                href={foundation.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                Ver código <ArrowUpRight class="size-4" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      class="open-source-assurance"
      data-reveal="bottom"
      data-easing="smooth"
    >
      <ShieldCheck class="size-7" aria-hidden="true" />
      <div>
        <h2>El resultado no es genérico.</h2>
        <p>
          Usamos una base común para reducir riesgo, pero no vendemos software
          estándar disfrazado de proyecto a medida. El código de negocio, las
          integraciones y los datos de tu empresa siguen siendo tuyos.
        </p>
      </div>
      <a href="/contact">
        Hablar de mi proyecto <ArrowUpRight class="size-4" aria-hidden="true" />
      </a>
    </section>

    <p class="open-source-footnote">
      <Check class="size-4" aria-hidden="true" /> Para equipos técnicos: cada paquete
      incluye su documentación en el repositorio.
    </p>
  </main>
</MainLayout>

<style>
  .open-source-page {
    width: min(72rem, 100%);
    min-height: 100vh;
    margin: 0 auto;
    padding: 7rem 1.5rem 6rem;
  }
  .open-source-breadcrumbs {
    margin-bottom: clamp(3rem, 8vw, 6rem);
  }
  .open-source-hero {
    max-width: 52rem;
    margin: 0 auto;
    text-align: center;
  }
  .open-source-eyebrow,
  .open-source-boundary span {
    color: var(--primary);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.13em;
  }
  .open-source-hero h1 {
    margin: 0.9rem auto 1.35rem;
    color: var(--foreground);
    font-size: clamp(2.75rem, 7vw, 6rem);
    font-weight: 800;
    line-height: 0.91;
    letter-spacing: -0.075em;
    text-wrap: balance;
  }
  .open-source-hero h1 span {
    color: var(--primary);
  }
  .open-source-hero p {
    max-width: 39rem;
    margin: 0 auto;
    color: var(--muted-foreground);
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    line-height: 1.65;
    text-wrap: balance;
  }
  .open-source-downloads {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.7rem;
    margin: 1.75rem 0 0;
  }
  .open-source-downloads strong {
    color: var(--primary);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.07em;
  }
  .open-source-downloads span {
    max-width: 13rem;
    color: var(--muted-foreground);
    font-size: 0.76rem;
    font-weight: 750;
    line-height: 1.35;
    text-align: left;
  }
  .open-source-boundary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(4rem, 10vw, 8rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--foreground) 12%, transparent);
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--foreground) 12%, transparent);
  }
  .open-source-boundary > div {
    padding: clamp(1.5rem, 4vw, 2.75rem);
    background: var(--background);
  }
  .open-source-boundary > div:last-child {
    background: var(--foreground);
  }
  .open-source-boundary h2 {
    margin: 0.65rem 0;
    color: var(--foreground);
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    letter-spacing: -0.04em;
  }
  .open-source-boundary p {
    max-width: 28rem;
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .open-source-boundary > div:last-child h2 {
    color: var(--background);
  }
  .open-source-boundary > div:last-child p {
    color: color-mix(in srgb, var(--background) 67%, transparent);
  }
  .open-source-boundary > div:last-child span {
    color: color-mix(in srgb, var(--primary) 80%, var(--background));
  }
  .open-source-foundations {
    margin-top: clamp(5rem, 12vw, 10rem);
  }
  .open-source-foundations > header {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: end;
    margin-bottom: 2.5rem;
  }
  .open-source-foundations h2 {
    max-width: 13ch;
    margin: 0.7rem 0 0;
    color: var(--foreground);
    font-size: clamp(2.2rem, 4vw, 4.25rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }
  .open-source-foundations > header > p {
    max-width: 28rem;
    margin: 0;
    color: var(--muted-foreground);
    line-height: 1.65;
  }
  .open-source-foundations ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .open-source-foundations li {
    display: flex;
    min-height: 16rem;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.4rem, 3vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--foreground) 12%, transparent);
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--foreground) 3%, var(--background));
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease;
  }
  .open-source-foundations li:hover {
    border-color: color-mix(in srgb, var(--primary) 65%, var(--foreground));
    background: color-mix(in srgb, var(--primary) 7%, var(--background));
    transform: translateY(-0.2rem);
  }
  .open-source-card-icon {
    color: var(--primary);
  }
  .open-source-foundations li > p {
    margin: 1.5rem 0 0.45rem;
    color: var(--primary);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .open-source-foundations h3 {
    margin: 0;
    color: var(--foreground);
    font-size: 1.1rem;
    letter-spacing: -0.025em;
  }
  .open-source-foundations li > span {
    margin-top: 0.8rem;
    color: var(--muted-foreground);
    font-size: 0.85rem;
    line-height: 1.55;
  }
  .open-source-foundations li > a,
  .open-source-assurance a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1.4rem;
    color: var(--foreground);
    font-size: 0.8rem;
    font-weight: 750;
    text-decoration: underline;
    text-decoration-color: var(--primary);
    text-underline-offset: 0.3rem;
  }
  .open-source-downloads-explained {
    max-width: 48rem;
    margin: clamp(4rem, 9vw, 7rem) auto 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid color-mix(in srgb, var(--foreground) 12%, transparent);
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--foreground) 3%, var(--background));
    text-align: center;
  }
  .open-source-downloads-explained h2 {
    margin: 0.7rem 0;
    color: var(--foreground);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    letter-spacing: -0.055em;
  }
  .open-source-downloads-explained > p {
    max-width: 38rem;
    margin: 0 auto;
    color: var(--muted-foreground);
    line-height: 1.65;
  }
  .open-source-downloads-explained .open-source-downloads-note {
    margin-top: 1rem;
    font-size: 0.78rem;
  }
  .open-source-assurance {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: center;
    margin-top: clamp(4rem, 9vw, 7rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--primary) 12%, var(--background));
  }
  .open-source-assurance > svg {
    color: var(--primary);
  }
  .open-source-assurance h2 {
    margin: 0;
    color: var(--foreground);
    font-size: 1.3rem;
    letter-spacing: -0.03em;
  }
  .open-source-assurance p {
    max-width: 43rem;
    margin: 0.4rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .open-source-assurance a {
    margin: 0;
    padding: 0.85rem 1rem;
    border-radius: 999px;
    background: var(--foreground);
    color: var(--background);
    text-decoration: none;
    white-space: nowrap;
  }
  .open-source-footnote {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 2rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.78rem;
    text-align: center;
  }
  .open-source-footnote :global(svg) {
    color: var(--primary);
  }
  @media (max-width: 720px) {
    .open-source-page {
      padding-inline: 1rem;
    }
    .open-source-boundary,
    .open-source-foundations > header,
    .open-source-assurance {
      grid-template-columns: 1fr;
    }
    .open-source-foundations ul {
      grid-template-columns: 1fr;
    }
    .open-source-assurance {
      gap: 1rem;
    }
    .open-source-assurance a {
      width: fit-content;
    }
    .open-source-downloads {
      align-items: center;
      flex-direction: column;
    }
    .open-source-downloads span {
      text-align: center;
    }
  }
</style>
