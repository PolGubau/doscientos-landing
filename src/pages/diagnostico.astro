---
import { ArrowRight, CircleCheck } from "@lucide/astro";
import List from "@lucide/astro/icons/list";
import DiagnosticCalculator from "~/components/conversion/DiagnosticCalculator.astro";
import ContactForm from "~/components/forms/ContactForm";
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import Button from "~/components/ui/Button.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import SectionTag from "~/components/ui/SectionTag.astro";
import { branding } from "~/config/branding";
import MainLayout from "~/layouts/MainLayout.astro";

const title = "Diagnóstico de procesos para pymes | doscientos";
const description =
  "Diagnóstico gratis en 20 minutos: revisamos tu proceso, calculamos el coste oculto y te decimos qué automatizar primero o si no merece la pena construir.";

const steps = [
  {
    title: "Nos cuentas el proceso real",
    description:
      "El que pasa un martes cualquiera: herramientas, personas, pasos y dónde se bloquea.",
  },
  {
    title: "Calculamos coste y riesgo",
    description:
      "Tiempo repetido, errores, retrasos y oportunidades perdidas. Con números.",
  },
  {
    title: "Salimos con una decisión",
    description: "Construir, simplificar o no tocarlo todavía. Sin ambigüedad.",
  },
];

const examples = [
  "Copiar datos de emails a Excel",
  "Revisar contratos o renovaciones a mano",
  "Generar informes recurrentes",
  "Perseguir documentos por WhatsApp",
  "Gestionar incidencias sin estados claros",
  "Crear presupuestos o partes repetidos",
];

const deliverables = [
  {
    title: "Prioridad clara",
    description:
      "Te diremos qué proceso atacar primero y cuál dejar para más adelante.",
  },
  {
    title: "Estimación de impacto",
    description:
      "Calculamos horas, coste de error y señales de retorno antes de hablar de construir.",
  },
  {
    title: "Primer módulo recomendado",
    description:
      "Si tiene sentido avanzar, salimos con un alcance inicial pequeño y medible.",
  },
];

const fitSignals = [
  "Hay una tarea que se repite cada semana y depende de copiar datos.",
  "Una hoja, chat o email decide el estado real del negocio.",
  "Hay errores caros, retrasos o oportunidades que aparecen tarde.",
  "El proceso ya tiene responsables, aunque las reglas vivan en la cabeza del equipo.",
];

const proofCases = [
  {
    title: "Optinergia",
    description:
      "CRM operativo para una asesoría energética con contratos, clientes y seguimiento comercial.",
    href: "/projects/optinergia",
  },
  {
    title: "Bitácora ERP",
    description:
      "Sistema interno para ordenar operaciones, trazabilidad y reporting sin depender de hojas sueltas.",
    href: "/projects/bitacora-erp",
  },
  {
    title: "Flatmatch",
    description:
      "Validación de producto con alcance cerrado antes de invertir de más en desarrollo.",
    href: "/projects/flatmatch",
  },
];

const faqs = [
  {
    question: "¿El diagnóstico es realmente gratis?",
    answer:
      "Sí. Es una llamada corta para entender si hay un problema claro y si tiene sentido automatizarlo. Si no compensa, te lo diremos.",
  },
  {
    question: "¿Tengo que tener claro qué quiero construir?",
    answer:
      "No. De hecho, lo normal es llegar con un proceso que duele, no con una especificación técnica.",
  },
  {
    question: "¿Qué recibo después de la llamada?",
    answer:
      "Una recomendación concreta: qué automatizar primero, qué evitar y cuál sería el primer módulo si decidimos construir.",
  },
];
---

<MainLayout
  title={title}
  description={description}
  type="service"
  service={{
    name: "Diagnóstico de procesos para pymes",
    description,
    serviceType: "Business Process Automation",
    url: "/diagnostico",
  }}
  faqs={faqs}
>
  <div class="px-6 max-w-7xl mx-auto pt-24 pb-32 space-y-32 md:space-y-40">
    <Breadcrumbs
      items={[{ name: "Diagnóstico de procesos", url: "/diagnostico" }]}
    />

    {/* ── HERO ─────────────────────────────────────────────────────── */}
    <header class="space-y-16">
      <div class="space-y-8" data-reveal="bottom" data-speed="normal">
        <div class="space-y-5">
          <h1
            class="text-3xl md:text-4xl font-bold tracking-tight text-foreground text-balance leading-[1.05]"
          >
            Te decimos qué proceso automatizar primero
            <span class="text-primary"> y cuánto te está costando.</span>
          </h1>
          <p
            class="text-lg md:text-xl text-muted-foreground max-w-xl leading-relaxed"
          >
            Revisamos un proceso real, ponemos números al coste oculto y salimos
            con una recomendación concreta. Sin venderte una app innecesaria.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="#formulario">
            <Button size="lg" withArrow>Quiero el diagnóstico</Button>
          </a>
          <a href="#calculadora-coste">
            <Button size="lg" variant="outline">Calcular coste primero</Button>
          </a>
        </div>
        <p class="text-sm text-muted-foreground">
          Si no merece la pena automatizarlo, te lo decimos. Sin presión.
        </p>
      </div>

      <aside
        class="rounded-3xl bg-foreground text-background p-7 md:p-9 space-y-7"
        data-reveal="right"
        data-speed="normal"
      >
        <p
          class="text-xs font-semibold text-background/50"
        >
          Lo que te llevas
        </p>
        <ul class="space-y-6">
          {
            steps.map((step, index) => (
              <li class="flex gap-4 items-start">
                <span class="shrink-0 size-8 rounded-full border border-background/20 bg-background/10 flex items-center justify-center text-sm font-bold">
                  {index + 1}
                </span>
                <div class="space-y-0.5">
                  <strong class="block text-background leading-snug">
                    {step.title}
                  </strong>
                  <span class="text-sm text-background/60 leading-relaxed">
                    {step.description}
                  </span>
                </div>
              </li>
            ))
          }
        </ul>
        <div class="border-t border-background/10 pt-5">
          <p class="text-xs text-background/40">
            Sin compromiso de compra. La decisión es tuya.
          </p>
        </div>
      </aside>
    </header>

    {/* ── CALCULADORA ──────────────────────────────────────────────── */}
    <DiagnosticCalculator />

    {/* ── QUE OBTIENES ─────────────────────────────────────────────── */}
    <section class="space-y-12">
      <div class="max-w-2xl space-y-4" data-reveal="bottom">
        <SectionTag>Decisión, no demo genérica</SectionTag>
        <h2
          class="text-3xl md:text-5xl font-bold tracking-tight text-foreground"
        >
          Sales con una recomendación accionable.
        </h2>
        <p class="text-muted-foreground leading-relaxed">
          El objetivo no es venderte una app. Es decidir si hay una
          automatización rentable, cuál sería el primer paso y qué deberías
          evitar para no construir de más.
        </p>
      </div>
      <div class="grid sm:grid-cols-3 gap-5" data-stagger="100">
        <article
          class="panel space-y-4 border-t-4 border-t-primary/30"
          data-reveal="bottom"
        >
          <div class="flex items-start justify-between">
            <List class="size-6 text-primary" />
            <span class="text-xs font-mono text-muted-foreground">01</span>
          </div>
          <div class="space-y-2">
            <h3 class="text-lg font-bold text-foreground">
              {deliverables[0].title}
            </h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              {deliverables[0].description}
            </p>
          </div>
        </article>
        <article
          class="panel space-y-4 border-t-4 border-t-primary/30"
          data-reveal="bottom"
        >
          <div class="flex items-start justify-between">
            <CircleCheck class="size-6 text-primary" />
            <span class="text-xs font-mono text-muted-foreground">02</span>
          </div>
          <div class="space-y-2">
            <h3 class="text-lg font-bold text-foreground">
              {deliverables[1].title}
            </h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              {deliverables[1].description}
            </p>
          </div>
        </article>
        <article
          class="panel space-y-4 border-t-4 border-t-primary/30"
          data-reveal="bottom"
        >
          <div class="flex items-start justify-between">
            <ArrowRight class="size-6 text-primary" />
            <span class="text-xs font-mono text-muted-foreground">03</span>
          </div>
          <div class="space-y-2">
            <h3 class="text-lg font-bold text-foreground">
              {deliverables[2].title}
            </h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              {deliverables[2].description}
            </p>
          </div>
        </article>
      </div>
    </section>

    {/* ── EJEMPLOS DE PROCESOS ─────────────────────────────────────── */}
    <section class="space-y-10">
      <SectionHeader
        title="Procesos que solemos revisar"
        subtitle="en empresas que ya operan a mano"
        description="No hace falta cambiarlo todo. La oportunidad suele estar en una tarea concreta que se repite demasiado."
        align="center"
      />
      <div class="flex flex-wrap gap-3 justify-center" data-stagger="80">
        {
          examples.map((example) => (
            <span
              class="inline-flex items-center gap-2 rounded-full border border-muted bg-background px-4 py-2.5 text-sm font-medium text-foreground shadow-pastel-sm"
              data-reveal="scale"
              data-speed="fast"
            >
              <CircleCheck class="size-4 text-primary shrink-0" />
              {example}
            </span>
          ))
        }
      </div>
    </section>

    {/* ── ENCAJE + CASOS ───────────────────────────────────────────── */}
    <section class="grid lg:grid-cols-2 gap-6">
      <article class="panel space-y-6" data-reveal="left">
        <div class="space-y-2">
          <SectionTag>Buen encaje</SectionTag>
          <h2
            class="text-2xl md:text-3xl font-bold tracking-tight text-foreground text-balance"
          >
            Merece revisarlo si reconoces dos o mas senales.
          </h2>
        </div>
        <ul class="space-y-4">
          {
            fitSignals.map((signal) => (
              <li class="flex gap-3 items-start text-sm text-muted-foreground leading-relaxed">
                <CircleCheck
                  class="size-4 text-primary shrink-0 mt-0.5"
                  aria-hidden="true"
                />
                <span>{signal}</span>
              </li>
            ))
          }
        </ul>
        <div class="border-t border-muted pt-4">
          <p class="text-xs text-muted-foreground">
            Si no encajamos, te decimos a quien acudir. Sin rodeos.
          </p>
        </div>
      </article>

      <article
        class="flex flex-col gap-4 rounded-3xl p-7 space-y-6 bg-foreground text-background"
        data-reveal="right"
      >
        <div class="space-y-2">
          <span
            class="text-xs font-semibold text-background/50"
          >
            Casos cercanos
          </span>
          <h2
            class="text-2xl md:text-3xl font-bold tracking-tight text-background text-balance"
          >
            Ya hemos resuelto problemas parecidos.
          </h2>
        </div>
        <div class="space-y-3">
          {
            proofCases.map((project) => (
              <a
                href={project.href}
                class="group flex items-start justify-between gap-3 rounded-2xl border border-background/10 bg-background/5 hover:bg-background/10 p-4 transition-colors"
              >
                <div class="space-y-0.5">
                  <h3 class="font-semibold text-background text-sm">
                    {project.title}
                  </h3>
                  <p class="text-xs text-background/60 leading-relaxed">
                    {project.description}
                  </p>
                </div>
                <ArrowRight class="size-4 text-background/40 group-hover:text-background shrink-0 mt-0.5 transition-colors" />
              </a>
            ))
          }
        </div>
      </article>
    </section>

    {/* ── FORMULARIO ───────────────────────────────────────────────── */}
    <section
      id="formulario"
      class="scroll-mt-28 grid lg:grid-cols-[1fr_1.2fr] gap-10 lg:gap-16 items-start"
    >
      <div class="space-y-7" data-reveal="bottom">
        <div class="space-y-3">
          <SectionTag>Siguiente paso</SectionTag>
          <h2
            class="text-3xl md:text-5xl font-bold tracking-tight text-foreground"
          >
            Agenda el diagnostico.
          </h2>
          <p class="text-muted-foreground leading-relaxed text-balance">
            Responde el formulario y en menos de 24h te confirmamos horario para
            la llamada.
          </p>
        </div>
        <ul class="space-y-3">
          {
            [
              "Completamente gratis, sin compromiso",
              "20 minutos, sin pitch de venta",
              "Recomendacion concreta al final",
            ].map((item) => (
              <li class="flex items-center gap-2.5 text-sm text-muted-foreground">
                <CircleCheck class="size-4 text-primary shrink-0" />
                {item}
              </li>
            ))
          }
        </ul>
        <div class="border-t border-muted pt-6">
          <p class="text-sm text-muted-foreground mb-3">
            ¿Prefieres algo mas directo?
          </p>
          <a
            href={`https://wa.me/${branding.contact.whatsapp.number}?text=${encodeURIComponent(
              "Hola, quiero hacer un diagnostico de procesos. El proceso que quiero revisar es: ",
            )}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border-2 border-muted px-5 py-3 text-sm font-semibold text-foreground hover:border-primary transition-colors"
          >
            Escribir por WhatsApp
          </a>
        </div>
      </div>

      <article
        class="bg-accent rounded-3xl border border-muted/60 shadow-pastel px-6 py-8 md:px-8 md:py-10"
      >
        <ContactForm client:load />
      </article>
    </section>
  </div>
</MainLayout>
