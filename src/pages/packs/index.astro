---
import {
  BriefcaseBusiness,
  Check,
  Dumbbell,
  Globe,
  HeartPulse,
  Scissors,
  ShieldCheck,
  Utensils,
} from "@lucide/astro";
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import Button from "~/components/ui/Button.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { branding } from "~/config/branding";
import { basePlan, getPackPricing, packs } from "~/data/packs";
import MainLayout from "~/layouts/MainLayout.astro";

const title =
  "Webs para negocios locales desde 200€ | Packs por sector | doscientos";
const description =
  "Packs de páginas web profesionales para barberías, restaurantes, gimnasios, clínicas y profesionales. Desde 200€ + 20€/mes con dominio, hosting, seguridad y soporte incluidos.";

const iconMap: Record<string, typeof Scissors> = {
  Scissors,
  Utensils,
  Dumbbell,
  BriefcaseBusiness,
  HeartPulse,
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Packs de webs para negocios locales",
  itemListElement: packs.map((pack, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: pack.title,
    url: `${branding.url}/packs/${pack.slug}`,
  })),
};
---

<MainLayout title={title} description={description}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(itemListSchema)}
  />

  <section class="landing-section pt-10 lg:pt-20">
    <Breadcrumbs items={[{ name: "Packs", url: "/packs" }]} />
    <SectionHeader
      title="Una web profesional para tu negocio,"
      subtitle="rápida y sin complicaciones."
      description="Packs cerrados por sector con todo incluido: diseño, dominio, hosting, seguridad y soporte. Eliges el tuyo y nos encargamos del resto."
      align="center"
    />
    <div class="flex flex-col sm:flex-row gap-4">
      <a href="/contact?subject=Interés en Packs&ref=packs-index">
        <Button size="lg" withArrow>Solicitar mi web</Button>
      </a>
      <a href="#packs">
        <Button size="lg" variant="outline">Ver packs</Button>
      </a>
    </div>
  </section>

  <section id="packs" class="landing-section scroll-mt-28">
    <div
      class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 w-full"
      data-stagger="80"
    >
      {
        packs.map((pack) => {
          const Icon = iconMap[pack.icon] ?? Globe;
          const pricing = getPackPricing(pack);
          return (
            <a
              href={`/packs/${pack.slug}`}
              class="group panel shadow-pastel justify-between transition-all duration-300 hover:-translate-y-1 hover:shadow-pastel-sm"
              data-reveal="bottom"
              data-speed="normal"
              data-easing="smooth"
            >
              <div class="space-y-4">
                <div class="size-11 rounded-2xl bg-primary/10 text-primary flex items-center justify-center">
                  <Icon class="size-5" />
                </div>
                <div class="space-y-2">
                  <h2 class="text-2xl font-bold text-pretty">{pack.title}</h2>
                  <p class="text-sm text-muted-foreground leading-relaxed text-pretty">
                    {pack.tagline}
                  </p>
                </div>
                {pricing.savingsInstall > 0 && (
                  <p class="inline-flex w-fit rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
                    Ahorras {pricing.savingsInstall}€ + {pricing.savingsMonthly}
                    €/mes
                  </p>
                )}
              </div>
              <div class="flex items-center justify-between pt-4 mt-2 border-t border-muted/60">
                <div>
                  <p class="text-xs text-muted-foreground">Desde</p>
                  <p class="font-bold">{pack.install}</p>
                </div>
                <span class="text-sm font-semibold text-primary underline-offset-4 group-hover:underline">
                  Ver detalles
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="landing-section">
    <SectionHeader
      title="Todo lo técnico,"
      subtitle="incluido en una cuota clara."
      description="Cualquier pack parte del mismo plan base: una instalación baja y un mantenimiento mensual que cubre dominio, hosting, seguridad y soporte."
      align="center"
    />
    <article
      class="w-full max-w-4xl rounded-3xl bg-accent border border-muted/60 shadow-pastel p-5 md:p-8 grid sm:grid-cols-2 gap-6"
    >
      <div class="rounded-2xl bg-foreground text-background p-5">
        <p class="text-sm text-background/70">Instalación desde</p>
        <p class="text-4xl font-bold">{basePlan.install.price}</p>
      </div>
      <div class="rounded-2xl bg-primary text-background p-5">
        <p class="text-sm text-background/70">Mantenimiento</p>
        <p class="text-4xl font-bold">{basePlan.maintenance.price}</p>
      </div>
      <ul class="sm:col-span-2 grid sm:grid-cols-2 gap-3">
        {
          basePlan.install.features.map((feature) => (
            <li class="flex items-center gap-3 text-sm">
              <Check class="size-4 text-primary shrink-0" />
              <span>{feature}</span>
            </li>
          ))
        }
      </ul>
    </article>
  </section>

  <section class="landing-section">
    <div
      class="max-w-3xl w-full bg-foreground text-background rounded-3xl p-8 md:p-12 text-center flex flex-col items-center gap-6 shadow-pastel"
      data-reveal="bottom"
      data-speed="normal"
      data-easing="smooth"
    >
      <div
        class="size-12 rounded-2xl bg-background/10 flex items-center justify-center"
      >
        <ShieldCheck class="size-6" />
      </div>
      <div class="space-y-4">
        <h2 class="text-3xl md:text-5xl font-bold text-balance">
          ¿No sabes qué pack encaja con tu negocio?
        </h2>
        <p class="text-background/70 max-w-2xl text-pretty text-lg">
          Cuéntanos a qué te dedicas y te recomendamos la mejor opción, sin
          compromiso.
        </p>
      </div>
      <a href="/contact?subject=Duda sobre Packs&ref=packs-index">
        <Button
          size="lg"
          withArrow
          arrowInverted={false}
          class="bg-background text-foreground hover:bg-background/90"
        >
          Hablar con nosotros
        </Button>
      </a>
    </div>
  </section>
</MainLayout>
