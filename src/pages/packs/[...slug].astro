---
import {
  BriefcaseBusiness,
  CalendarCheck,
  Check,
  CircleDollarSign,
  Dumbbell,
  FileText,
  Globe,
  Headphones,
  HeartPulse,
  MapPin,
  Scissors,
  ShieldCheck,
  Sparkles,
  Utensils,
} from "@lucide/astro";
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import SchemaOrg from "~/components/seo/SchemaOrg.astro";
import Button from "~/components/ui/Button.astro";
import { branding } from "~/config/branding";
import { getPackPricing, packs } from "~/data/packs";
import type { Pack } from "~/data/packs";
import MainLayout from "~/layouts/MainLayout.astro";

export function getStaticPaths() {
  return packs.map((pack) => ({
    params: { slug: pack.slug },
    props: { pack },
  }));
}

const { pack } = Astro.props as { pack: Pack };
const url = `${branding.url}/packs/${pack.slug}`;
const pricing = getPackPricing(pack);

// biome-ignore lint/suspicious/noExplicitAny: mapa de iconos lucide
const iconMap: Record<string, any> = {
  Scissors,
  Utensils,
  Dumbbell,
  BriefcaseBusiness,
  HeartPulse,
  CalendarCheck,
  Sparkles,
  MapPin,
  FileText,
  Headphones,
  CircleDollarSign,
  ShieldCheck,
};
const SectorIcon = iconMap[pack.icon] ?? Globe;
---

<MainLayout
  title={pack.metaTitle}
  description={pack.metaDescription}
>
  <SchemaOrg
    type="service"
    service={{
      name: pack.title,
      description: pack.metaDescription,
      url,
      serviceType: `Diseño web para ${pack.sector.toLowerCase()}`,
      price: pack.installAmount,
      priceCurrency: "EUR",
    }}
    faqs={pack.faqs}
  />

  <section class="landing-section pt-24 lg:pt-24">
    <Breadcrumbs
      items={[
        { name: "Packs", url: "/packs" },
        { name: pack.title, url: `/packs/${pack.slug}` },
      ]}
    />
    <div class="grid lg:grid-cols-2 gap-10 w-full items-center">
      <header class="space-y-6">
        <div
          class="size-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center"
        >
          <SectorIcon class="size-6" />
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-balance">
          {pack.heroTitle}
        </h1>
        <p class="text-lg text-muted-foreground text-pretty max-w-xl">
          {pack.heroSubtitle}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={`/contact?subject=Pack ${pack.title}&ref=${pack.slug}`}
            ><Button size="lg" withArrow>{pack.cta}</Button></a
          >
          <a href="/packs">
            <Button size="lg" variant="outline">Ver todos los packs</Button>
          </a>
        </div>
      </header>
      <div class="grid grid-cols-2 gap-3">
        <div class="rounded-2xl bg-foreground text-background p-5">
          <p class="text-sm text-background/70">Instalación</p>
          <p class="text-4xl font-bold">{pack.install}</p>
        </div>
        <div class="rounded-2xl bg-primary text-background p-5">
          <p class="text-sm text-background/70">Mantenimiento</p>
          <p class="text-4xl font-bold">{pack.monthly}</p>
        </div>
        {
          pricing.savingsInstall > 0 && (
            <p class="col-span-2 inline-flex w-fit rounded-full bg-primary/10 px-4 py-1.5 text-sm font-semibold text-primary">
              Ahorras {pricing.savingsInstall}€ de instalación y{" "}
              {pricing.savingsMonthly}€/mes frente a contratar los extras por
              separado
            </p>
          )
        }
        <ul
          class="col-span-2 grid gap-3 rounded-2xl bg-accent border border-muted/60 p-5"
        >
          {
            pack.features.map((feature) => (
              <li class="flex items-center gap-3 text-sm">
                <Check class="size-4 text-primary shrink-0" />
                <span>{feature}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="landing-section">
    <div class="w-full max-w-3xl mx-auto space-y-12">
      <p class="text-lg text-muted-foreground leading-relaxed text-pretty">
        {pack.intro}
      </p>
      <div class="space-y-4">
        <h2 class="text-3xl font-bold">El problema</h2>
        <p class="text-muted-foreground leading-relaxed text-pretty">
          {pack.problem}
        </p>
      </div>
      <div class="space-y-4">
        <h2 class="text-3xl font-bold">La solución</h2>
        <p class="text-muted-foreground leading-relaxed text-pretty">
          {pack.solution}
        </p>
      </div>
    </div>
  </section>

  <section class="landing-section">
    <div class="grid sm:grid-cols-3 gap-4 w-full" data-stagger="80">
      {
        pack.benefits.map((benefit) => {
          const BenefitIcon = iconMap[benefit.icon] ?? Globe;
          return (
            <article
              class="panel shadow-pastel space-y-4"
              data-reveal="bottom"
              data-speed="normal"
              data-easing="smooth"
            >
              <div class="size-11 rounded-2xl bg-primary/10 text-primary flex items-center justify-center">
                <BenefitIcon class="size-5" />
              </div>
              <h3 class="text-xl font-bold text-pretty">{benefit.title}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed text-pretty">
                {benefit.description}
              </p>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="landing-section">
    <div class="w-full max-w-3xl mx-auto space-y-6">
      <h2 class="text-3xl font-bold text-center">Preguntas frecuentes</h2>
      <div class="space-y-3">
        {
          pack.faqs.map((faq) => (
            <details class="group rounded-2xl bg-accent border border-muted/60 p-5">
              <summary class="flex items-center justify-between cursor-pointer font-semibold list-none">
                <span class="text-pretty pr-4">{faq.question}</span>
                <span class="text-primary text-xl transition-transform group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="text-sm text-muted-foreground leading-relaxed text-pretty mt-3">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="landing-section">
    <div
      class="max-w-3xl w-full bg-foreground text-background rounded-3xl p-8 md:p-12 text-center flex flex-col items-center gap-6 shadow-pastel"
      data-reveal="bottom"
      data-speed="normal"
      data-easing="smooth"
    >
      <div class="space-y-4">
        <h2 class="text-3xl md:text-5xl font-bold text-balance">
          ¿Lanzamos la web de tu {pack.sector.toLowerCase()}?
        </h2>
        <p class="text-background/70 max-w-2xl text-pretty text-lg">
          Cuéntanos cómo es tu negocio y te preparamos una propuesta a medida,
          sin compromiso.
        </p>
      </div>
      <a href={`/contact?subject=Pack ${pack.title}&ref=${pack.slug}`}>
        <Button
          size="lg"
          withArrow
          arrowInverted={false}
          class="bg-background text-foreground hover:bg-background/90"
        >
          {pack.cta}
        </Button>
      </a>
    </div>
  </section>
</MainLayout>
