---
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import Button from "~/components/ui/Button.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import SectionTag from "~/components/ui/SectionTag.astro";
import StatCard from "~/components/ui/StatCard.astro";
import MainLayout from "~/layouts/MainLayout.astro";
import { getProjects } from "~/shared/lib/collections";

const projects = await getProjects(3);

const stats = [
  {
    number: "6 sem",
    label: "De idea a producto lanzado",
    description: "MVPs y sistemas a medida validados con usuarios reales.",
  },
  {
    number: "100%",
    label: "Código en propiedad del cliente",
    description:
      "Sin lock-in, sin licencias. El código es tuyo desde el día 1.",
  },
  {
    number: "5/5 ⭐",
    label: "Valoración media de clientes",
    description:
      "Proyectos entregados a precio fijo en Canarias y toda España.",
  },
];

const benefits = [
  {
    title: "IGIC y fiscalidad canaria desde el primer día",
    description:
      "Conocemos el régimen fiscal canario. Los sistemas que construimos contemplan IGIC, ZEC y las particularidades del archipiélago desde el diseño.",
  },
  {
    title: "Trabajo 100% en remoto con empresas canarias",
    description:
      "Videollamadas semanales, canal Slack y demos cada viernes. La distancia peninsular no cambia la calidad ni los plazos.",
  },
  {
    title: "Precio fijo, sin presupuestos variables",
    description:
      "Acordamos el alcance y el precio antes de empezar. Sin sorpresas.",
  },
];

const faqs = [
  {
    question: "¿Trabajáis con empresas de Canarias desde la península?",
    answer:
      "Sí. Tenemos clientes en Las Palmas, Tenerife y otras islas. Trabajamos 100% en remoto con videollamadas, demos semanales y canal de comunicación directo. La distancia no afecta a los plazos ni a la calidad.",
  },
  {
    question: "¿Entendéis la fiscalidad canaria (IGIC)?",
    answer:
      "Sí. En proyectos como CashMóvil Canarias implementamos lógica fiscal que distingue entre IVA peninsular e IGIC canario. Lo contemplamos desde el diseño del sistema, no como un parche posterior.",
  },
  {
    question: "¿Cuánto cuesta un ecommerce o sistema a medida en Canarias?",
    answer:
      "Depende del alcance. Un ecommerce a medida parte desde 15.000 €. Un CRM o backoffice propio puede ir desde 8.000 €. Siempre precio fijo acordado antes de empezar. Te damos un presupuesto en 48h.",
  },
  {
    question: "¿Cuánto tiempo tarda en estar listo el sistema?",
    answer:
      "MVPs y sistemas básicos en 4-6 semanas. Proyectos más complejos con integraciones en 8-12 semanas. CashMóvil Canarias — ecommerce + backoffice completo — se entregó en 4 semanas.",
  },
];
---

<MainLayout
  title="Desarrollo Web Canarias - Ecommerce y software a medida | doscientos"
  description="Agencia de desarrollo web y software a medida para empresas de Canarias. Ecommerce, CRM y backoffice con IGIC. Precio fijo, código en propiedad. Clientes en Las Palmas y Tenerife."
  localBusiness={{
    name: "doscientos - Desarrollo Web Canarias",
    description:
      "Agencia de desarrollo web y software a medida para empresas de Canarias. Ecommerce, CRM, backoffice con IGIC. Precio fijo.",
    address: {
      addressLocality: "Las Palmas de Gran Canaria",
      addressRegion: "Canarias",
      postalCode: "35001",
      addressCountry: "ES",
    },
    geo: { latitude: "28.1235", longitude: "-15.4366" },
  }}
  service={{
    name: "Desarrollo Web y Software a medida para empresas de Canarias",
    description:
      "Ecommerce, CRM y backoffice a medida para empresas canarias. Contemplamos IGIC y la operativa del archipiélago desde el diseño del sistema.",
    serviceType: "Software Development",
  }}
  faqs={faqs}
  type="website"
>
  <section class="px-6 max-w-7xl mx-auto pt-32 space-y-12">
    <Breadcrumbs
      items={[{ name: "Canarias", url: "/desarrollo-web-canarias" }]}
    />

    <header class="max-w-3xl mx-auto text-center space-y-8" data-stagger="100">
      <div data-reveal="top" data-speed="fast" data-easing="smooth">
        <SectionTag>Canarias</SectionTag>
      </div>
      <h1
        class="text-4xl md:text-6xl font-bold text-foreground"
        data-reveal="scale"
        data-speed="normal"
        data-easing="bounce"
      >
        Desarrollo Web en Canarias
        <span class="block text-primary mt-2">Software a medida con IGIC.</span>
      </h1>
      <p
        class="text-xl text-muted-foreground max-w-2xl mx-auto"
        data-reveal="bottom"
        data-speed="normal"
        data-easing="soft"
      >
        Construimos ecommerce, CRM y backoffice para empresas de Las Palmas,
        Tenerife y el resto del archipiélago. Entendemos la fiscalidad canaria y
        la operativa de tiendas y negocios en las islas.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/contact">
          <Button size="lg" withArrow>Hablar con el equipo</Button>
        </a>
        <a href="/projects">
          <Button size="lg">Ver proyectos</Button>
        </a>
      </div>
    </header>

    <div class="grid md:grid-cols-3 gap-6" data-stagger="150">
      {
        stats.map((stat) => (
          <StatCard
            number={stat.number}
            label={stat.label}
            description={stat.description}
          />
        ))
      }
    </div>

    <section class="space-y-8 max-w-3xl mx-auto">
      <SectionHeader
        title="Caso real en Canarias"
        subtitle="CashMóvil Canarias"
        description="Ecommerce y backoffice a medida para una tienda de móviles en Las Palmas."
        align="center"
      />
      <div class="p-8 rounded-2xl bg-accent space-y-4" data-reveal="bottom">
        <p class="text-muted-foreground">
          CashMóvil Canarias llevaba años con un PrestaShop parcheado: stock
          desincronizado entre tienda física y web, fichas de cliente
          inexistentes y cero datos sobre qué productos dejaban margen. Cada
          dispositivo es único — con IMEI, batería y estado propios — y
          PrestaShop no estaba pensado para eso.
        </p>
        <p class="text-muted-foreground">
          En 4 semanas entregamos el sistema completo: ecommerce con inventario
          por IMEI, backoffice con historial de cliente (compras, garantías,
          reparaciones), módulo de servicio técnico integrado y dashboard con
          márgenes reales. <strong class="text-foreground"
            >Por primera vez, visibilidad real del negocio.</strong
          >
        </p>
        <a
          href="/projects/cash-movil-canarias"
          class="inline-flex items-center gap-1 text-primary font-medium hover:underline"
        >
          Ver el caso completo →
        </a>
      </div>
    </section>

    <section class="space-y-12">
      <SectionHeader
        title="Por qué empresas canarias"
        subtitle="trabajan con nosotros"
        description="Entendemos las particularidades de operar en el archipiélago."
        align="center"
      />
      <div class="grid md:grid-cols-3 gap-8" data-stagger="100">
        {
          benefits.map((benefit) => (
            <div
              class="p-8 rounded-2xl bg-accent space-y-4"
              data-reveal="bottom"
              data-speed="normal"
              data-easing="soft"
            >
              <h3 class="text-xl font-semibold text-foreground">
                {benefit.title}
              </h3>
              <p class="text-muted-foreground">{benefit.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="space-y-12">
      <SectionHeader
        title="Proyectos entregados"
        subtitle="con resultados medibles"
        description="Casos de éxito reales. Métricas concretas."
        align="center"
      />
      <div class="grid md:grid-cols-3 gap-6">
        {
          projects.map((project) => (
            <a
              href={`/projects/${project.id}`}
              class="group block p-6 rounded-2xl bg-accent hover:bg-muted transition-colors"
            >
              <h3 class="text-xl font-semibold text-foreground group-hover:text-primary transition-colors">
                {project.data.title}
              </h3>
              <p class="text-muted-foreground mt-2">{project.data.summary}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="space-y-12">
      <SectionHeader
        title="Recursos y guías"
        subtitle="para empresas canarias"
        description="Analizamos el coste, los plazos y la rentabilidad del software a medida."
        align="center"
      />
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          [
            {
              title: "PrestaShop vs Ecommerce a medida",
              url: "/blog/prestashop-vs-ecommerce-a-medida",
              desc: "Cuándo dar el salto y qué ganas con un sistema propio. El caso de CashMóvil.",
            },
            {
              title: "Cuánto cuesta un ERP a medida",
              url: "/blog/cuanto-cuesta-erp-a-medida",
              desc: "Guía de precios reales y qué factores determinan la inversión en 2026.",
            },
            {
              title: "Portal de cliente a medida",
              url: "/blog/portal-de-cliente-a-medida",
              desc: "Cómo reducir el soporte y mejorar la confianza de tus clientes.",
            },
          ].map((item) => (
            <a
              href={item.url}
              class="group p-6 rounded-2xl bg-accent hover:bg-muted transition-all border border-transparent hover:border-primary/20"
            >
              <h3 class="text-lg font-semibold group-hover:text-primary transition-colors">
                {item.title}
              </h3>
              <p class="text-sm text-muted-foreground mt-2">{item.desc}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="space-y-8 max-w-3xl mx-auto">
      <SectionHeader
        title="Preguntas frecuentes"
        subtitle="de empresas canarias"
        align="center"
      />
      <dl class="space-y-6">
        {
          faqs.map((faq) => (
            <div class="p-6 rounded-2xl bg-accent space-y-2">
              <dt class="font-semibold text-foreground text-lg">
                {faq.question}
              </dt>
              <dd class="text-muted-foreground">{faq.answer}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section
      class="bg-primary text-background rounded-3xl p-12 text-center space-y-6"
    >
      <h2 class="text-3xl md:text-4xl font-bold">
        ¿Tienes un proyecto en Canarias?
      </h2>
      <p class="text-xl opacity-90 max-w-2xl mx-auto">
        Cuéntanos qué necesitas. Respondemos en menos de 24h con un presupuesto
        real.
      </p>
      <a href="/contact">
        <Button
          size="lg"
          withArrow
          class="bg-background text-primary hover:bg-background/90"
        >
          Pedir presupuesto
        </Button>
      </a>
    </section>
  </section>
</MainLayout>
