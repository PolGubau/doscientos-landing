---
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import Button from "~/components/ui/Button.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import SectionTag from "~/components/ui/SectionTag.astro";
import StatCard from "~/components/ui/StatCard.astro";
import MainLayout from "~/layouts/MainLayout.astro";
import { getProjects } from "~/shared/lib/collections";

const projects = await getProjects(3);

const stats = [
  {
    number: "Premià",
    label: "Nuestra sede está aquí",
    description: "Premià de Mar. Reuniones presenciales en toda la comarca.",
  },
  {
    number: "6 sem",
    label: "De idea a producto",
    description: "MVPs validados y en producción. Sin esperar meses.",
  },
  {
    number: "+30",
    label: "Proyectos entregados",
    description: "Para empresas locales, nacionales e internacionales.",
  },
];

const cities = [
  "Mataró",
  "Premià de Mar",
  "El Masnou",
  "Vilassar de Mar",
  "Arenys de Mar",
  "Calella",
  "Pineda de Mar",
  "Sant Pol de Mar",
];

const benefits = [
  {
    title: "Reuniones presenciales sin coste extra",
    description:
      "Estamos en Premià de Mar. Nos desplazamos por toda la comarca del Maresme.",
  },
  {
    title: "Conocemos el tejido empresarial local",
    description:
      "PYMEs industriales, comercios, hostelería, servicios. Entendemos el negocio antes de escribir código.",
  },
  {
    title: "Soporte directo, sin intermediarios",
    description:
      "Trabajas directamente con los fundadores. No hay cuenta manager ni junior entre tú y el equipo.",
  },
];

const faqs = [
  {
    question: "¿Podéis reuniros en persona en Mataró o Vilassar?",
    answer:
      "Sí. Tenemos la base en Premià de Mar y nos movemos por toda la comarca sin coste adicional: Mataró, El Masnou, Vilassar de Mar, Arenys, Calella y alrededores.",
  },
  {
    question: "¿Qué tipo de empresas del Maresme trabajáis?",
    answer:
      "PYMEs industriales, comercios con procesos manuales, empresas de servicios que quieren automatizar y negocios que necesitan una web profesional rápida. También startups locales que quieren validar su idea.",
  },
  {
    question:
      "¿Cuánto cuesta una web profesional para una empresa del Maresme?",
    answer:
      "Nuestros packs de webs corporativas parten desde 1.500€. Para proyectos más complejos como ERPs, automatizaciones o MVPs, el precio se fija según el alcance antes de empezar.",
  },
];
---

<MainLayout
  title="Agencia Digital Maresme - Desarrollo Web local | doscientos"
  description="Agencia de desarrollo web y digitalización en el Maresme. Sede en Premià de Mar. Reuniones presenciales en Mataró, Vilassar, El Masnou y comarca. Precio fijo."
  service={{
    name: "Desarrollo Web y Digitalización en el Maresme",
    description:
      "Webs profesionales, MVPs, automatizaciones y software a medida para empresas del Maresme. Reuniones presenciales en toda la comarca.",
    serviceType: "Software Development",
  }}
  faqs={faqs}
  type="website"
>
  <section class="px-6 max-w-7xl mx-auto pt-32 space-y-12">
    <Breadcrumbs
      items={[{ name: "Maresme", url: "/agencia-digital-maresme" }]}
    />

    <header class="max-w-3xl mx-auto text-center space-y-8" data-stagger="100">
      <div data-reveal="top" data-speed="fast" data-easing="smooth">
        <SectionTag>Maresme</SectionTag>
      </div>
      <h1
        class="text-4xl md:text-6xl font-bold text-foreground"
        data-reveal="scale"
        data-speed="normal"
        data-easing="bounce"
      >
        Agencia Digital en el Maresme
        <span class="block text-primary mt-2">De Premià a toda la comarca.</span
        >
      </h1>
      <p
        class="text-xl text-muted-foreground max-w-2xl mx-auto"
        data-reveal="bottom"
        data-speed="normal"
        data-easing="soft"
      >
        Somos una agencia de desarrollo web con sede en Premià de Mar.
        Digitalizamos empresas del Maresme: webs, MVPs, automatizaciones y
        software a medida. Reuniones presenciales en toda la comarca, sin coste
        extra.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/contact"
          ><Button size="lg" withArrow>Agendar reunión presencial</Button></a
        >
        <a href="/packs"><Button size="lg">Ver packs de webs</Button></a>
      </div>
    </header>

    <div class="grid md:grid-cols-3 gap-6" data-stagger="150">
      {
        stats.map((stat) => (
          <StatCard
            number={stat.number}
            label={stat.label}
            description={stat.description}
          />
        ))
      }
    </div>

    <!-- Municipios que cubrimos -->
    <section class="space-y-6 text-center">
      <p class="text-sm text-muted-foreground font-semibold">
        Atendemos en persona en toda la comarca
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        {
          cities.map((city) => (
            <span class="px-4 py-2 rounded-full bg-accent text-foreground text-sm font-medium">
              {city}
            </span>
          ))
        }
      </div>
    </section>

    <section class="space-y-12">
      <SectionHeader
        title="Ventajas de trabajar"
        subtitle="con una agencia local"
        description="Cercanía real, no solo en el papel."
        align="center"
      />
      <div class="grid md:grid-cols-3 gap-8" data-stagger="100">
        {
          benefits.map((benefit) => (
            <div
              class="p-8 rounded-2xl bg-accent space-y-4"
              data-reveal="bottom"
              data-speed="normal"
              data-easing="soft"
            >
              <h3 class="text-xl font-semibold text-foreground">
                {benefit.title}
              </h3>
              <p class="text-muted-foreground">{benefit.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="space-y-12">
      <SectionHeader
        title="Proyectos reales"
        subtitle="resultados medibles"
        description="Empresas que confiaron en nosotros."
        align="center"
      />
      <div class="grid md:grid-cols-3 gap-6">
        {
          projects.map((project) => (
            <a
              href={`/projects/${project.id}`}
              class="group block p-6 rounded-2xl bg-accent hover:bg-muted transition-colors"
            >
              <h3 class="text-xl font-semibold text-foreground group-hover:text-primary transition-colors">
                {project.data.title}
              </h3>
              <p class="text-muted-foreground mt-2">{project.data.summary}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="space-y-12">
      <SectionHeader
        title="Recursos y guías"
        subtitle="para empresas del Maresme"
        description="Analizamos el coste, los plazos y la rentabilidad del software a medida."
        align="center"
      />
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          [
            {
              title: "CRM a medida en Barcelona",
              url: "/blog/crm-a-medida-barcelona",
              desc: "Cuándo dejar el genérico y construir el tuyo. Casos locales.",
            },
            {
              title: "Software a medida vs SaaS",
              url: "/blog/software-a-medida-vs-saas",
              desc: "Guía honesta para elegir la mejor opción según tu volumen.",
            },
            {
              title: "Integración de sistemas y APIs",
              url: "/blog/integracion-de-sistemas-apis",
              desc: "Cómo conectar tu ERP, tienda y CRM sin trabajo manual.",
            },
          ].map((item) => (
            <a
              href={item.url}
              class="group p-6 rounded-2xl bg-accent hover:bg-muted transition-all border border-transparent hover:border-primary/20"
            >
              <h3 class="text-lg font-semibold group-hover:text-primary transition-colors">
                {item.title}
              </h3>
              <p class="text-sm text-muted-foreground mt-2">{item.desc}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="space-y-8 max-w-3xl mx-auto">
      <SectionHeader
        title="Preguntas frecuentes"
        subtitle="del Maresme"
        align="center"
      />
      <dl class="space-y-6">
        {
          faqs.map((faq) => (
            <div class="p-6 rounded-2xl bg-accent space-y-2">
              <dt class="font-semibold text-foreground text-lg">
                {faq.question}
              </dt>
              <dd class="text-muted-foreground">{faq.answer}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section
      class="bg-primary text-background rounded-3xl p-12 text-center space-y-6"
    >
      <h2 class="text-3xl md:text-4xl font-bold">
        ¿Tu empresa está en el Maresme?
      </h2>
      <p class="text-xl opacity-90 max-w-2xl mx-auto">
        Quedamos en persona. Sin videollamada ni intermediarios — directamente
        con el equipo que va a hacer el proyecto.
      </p>
      <a href="/contact">
        <Button
          size="lg"
          withArrow
          class="bg-background text-primary hover:bg-background/90"
        >
          Agendar reunión presencial
        </Button>
      </a>
    </section>
  </section>
</MainLayout>
