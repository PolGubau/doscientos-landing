---
import { getCollection } from "astro:content";
import BlogCard from "~/components/blog/BlogCard.astro";
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import SectionTag from "~/components/ui/SectionTag.astro";
import MainLayout from "~/layouts/MainLayout.astro";

const blogPosts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = blogPosts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
---

<MainLayout
  title="Blog de desarrollo web y automatización | doscientos"
  description="Análisis técnicos, comparativas de tecnología, decisiones de arquitectura y aprendizajes de proyectos reales. Escrito y revisado por el equipo de doscientos."
>
  <div class="min-h-screen py-32 px-6">
    <div class="max-w-6xl mx-auto space-y-12">
      <Breadcrumbs items={[{ name: "Blog", url: "/blog" }]} />

      <header class="flex max-w-4xl flex-col items-start gap-6">
        <SectionTag>Nuestro blog</SectionTag>
        <h1
          class="max-w-3xl text-balance text-4xl font-semibold leading-[1.05] text-foreground md:text-6xl"
        >
          Criterio técnico, explicado con contexto
        </h1>
        <p
          class="max-w-2xl text-pretty text-lg leading-relaxed text-muted-foreground"
        >
          Análisis, comparativas y aprendizajes de proyectos reales para decidir
          qué construir, con qué tecnología y por qué.
        </p>
      </header>

      {
        sortedPosts.length > 0 ? (
          <section aria-labelledby="latest-posts" class="space-y-6">
            <div class="flex items-end justify-between gap-6 border-b border-muted pb-4">
              <h2 id="latest-posts" class="text-xl font-semibold">
                Últimas publicaciones
              </h2>
              <p class="text-sm text-muted-foreground">
                {sortedPosts.length} artículos
              </p>
            </div>
            <div class="grid gap-5 md:grid-cols-2">
              {sortedPosts.map((post, index) => (
                <BlogCard post={post} featured={index === 0} />
              ))}
            </div>
          </section>
        ) : (
          <div class="text-center py-20">
            <p class="text-xl text-neutral-500 dark:text-neutral-400">
              Próximamente publicaremos artículos técnicos.
            </p>
          </div>
        )
      }
    </div>
  </div>
</MainLayout>
