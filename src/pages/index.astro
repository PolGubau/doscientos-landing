---
import MainLayout from "~/layouts/MainLayout.astro";

import Authority from "~/components/sections/Authority.astro";
import CaseStudies from "~/components/sections/CaseStudies.astro";
import ClientsCarousel from "~/components/sections/ClientsCarousel.astro";
import Comparison from "~/components/sections/Comparison.astro";
import FAQ from "~/components/sections/FAQ.astro";
import ForWho from "~/components/sections/ForWho.astro";
import Hero from "~/components/sections/Hero.astro";
import Hype from "~/components/sections/Hype.astro";
import Impact from "~/components/sections/Impact.astro";
import Method from "~/components/sections/Method.astro";
import MidCTA from "~/components/sections/MidCTA.astro";
import Services from "~/components/sections/Services.astro";
import SolutionsGrid from "~/components/sections/SolutionsGrid.astro";
import Testimonials from "~/components/sections/Testimonials.astro";
import ProjectsBadge from "~/components/ui/ProjectsBadge.astro";

const title =
  "Backoffice y automatización para PYMEs en Barcelona · Precio fijo | doscientos";
const description =
  "Desarrollamos CRMs, ERPs y automatizaciones a medida para PYMEs. Precio fijo, entrega en 6 semanas, +30 proyectos entregados en Barcelona y toda España.";

const faqs = [
  {
    question: "¿Cuánto cuesta desarrollar un backoffice o ERP a medida?",
    answer:
      "Trabajamos siempre a precio fijo acordado antes de empezar. El coste varía según el alcance, pero el precio no cambia una vez firmado. Sin sorpresas ni presupuestos variables.",
  },
  {
    question: "¿En cuánto tiempo estará en producción mi proyecto?",
    answer:
      "El plazo habitual es de 4 a 6 semanas desde el inicio. Hacemos una demo semanal para que veas el progreso en tiempo real.",
  },
  {
    question: "¿Quién se queda con el código al terminar?",
    answer:
      "El código es 100% tuyo desde el primer commit. Sin lock-in, sin licencias de uso, sin dependencia de nuestra plataforma.",
  },
  {
    question: "¿Trabajáis solo en Barcelona o también en el resto de España?",
    answer:
      "Trabajamos en remoto con clientes de toda España — Barcelona, Madrid, Valencia, Canarias, Castellón y más. La comunicación es vía Slack y demos semanales.",
  },
  {
    question: "¿Qué ocurre si necesito cambios tras el lanzamiento?",
    answer:
      "Incluimos 30 días de soporte post-lanzamiento sin coste. Después ofrecemos mantenimiento y evolución del producto con condiciones acordadas.",
  },
];
---

<MainLayout title={title} description={description} faqs={faqs}>
  <!-- Block-level wrapper so ScrollTrigger's pin-spacer lives in normal flow.
       Pinning a direct flex child of <main> collapses pin-spacing to 0. -->
  <div class="block">
    <Hero />
  </div>
  <div
    class="flex flex-wrap items-center justify-center gap-6 text-sm text-muted-foreground pt-6"
    data-reveal="bottom"
    data-speed="normal"
    data-easing="soft"
    data-delay="700"
  >
    <span
      ><strong class="text-foreground">+30 proyectos</strong> entregados</span
    >
  </div>
  <!-- Clients carousel below the hero, full-width -->
  <div class="relative z-20 w-full">
    <ClientsCarousel />
  </div>
  <Services />
  <section class="px-6 max-w-7xl mx-auto w-full space-y-8">
    <div class="max-w-2xl space-y-4" data-reveal="left">
      <p class="text-sm uppercase tracking-[0.2em] text-primary font-semibold">
        Soluciones por problema
      </p>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-foreground">
        Automatización para procesos que ya duelen.
      </h2>
      <p class="text-muted-foreground leading-relaxed">
        Si tu equipo opera entre Excel, WhatsApp, contratos, incidencias o
        renovaciones, empieza por el diagnóstico o por el caso que más se parece
        a tu negocio.
      </p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4" data-stagger="100">
      {
        commercialProblemLinks.map((landing) => (
          <a
            href={landing.href}
            class="group rounded-2xl border border-muted p-5 hover:border-primary hover:bg-accent transition-colors"
            data-reveal="bottom"
          >
            <h3 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors">
              {landing.label}
            </h3>
            <p class="text-sm text-muted-foreground mt-2 leading-relaxed">
              {landing.description}
            </p>
          </a>
        ))
      }
    </div>
  </section>
  <ForWho />
  <Method />
  <Impact />
  <Testimonials />
  <CaseStudies />
  <Authority />
  <Comparison />

  <!-- Mid-page CTA -->
  <section class="px-6 max-w-4xl mx-auto w-full" data-reveal="bottom">
    <div
      class="bg-foreground text-background rounded-2xl px-8 py-10 flex flex-col sm:flex-row items-center justify-between gap-6"
    >
      <div class="space-y-1 text-center sm:text-left">
        <p class="text-xl font-bold">
          ¿Qué proceso deberías automatizar primero?
        </p>
        <p class="text-background/60 text-sm">
          Revisamos tu caso y te damos una prioridad clara, sin compromiso.
        </p>
      </div>
      <a
        href="/diagnostico-procesos?ref=home-mid"
        class="shrink-0"
        aria-label="Pedir diagnóstico de procesos"
      >
        <Button
          size="lg"
          withArrow
          arrowInverted={false}
          class="bg-background text-foreground hover:bg-background/90 shadow-none"
        >
          Pedir diagnóstico
        </Button>
      </a>
    </div>
  </section>

  <FAQ />
  <Hype />
</MainLayout>
