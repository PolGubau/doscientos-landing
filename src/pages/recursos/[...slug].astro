---
import { ArrowUpRight } from "@lucide/astro";
import { getCollection, render } from "astro:content";
import BlogCTA from "~/components/blog/BlogCTA.astro";
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import {
  commercialBlogCtaBySlug,
  commercialBlogLinks,
  type BlogCtaVariant,
} from "~/data/commercialRoutes";
import MainLayout from "~/layouts/MainLayout.astro";
import { getResourceCategories } from "~/shared/lib/resourceCategories";
import { getBuyerStageLabel, getResourceLabel } from "~/shared/lib/resources";

export async function getStaticPaths() {
  const resources = await getCollection("blog", ({ data }) => !data.draft);
  return resources.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const postCategories = getResourceCategories(post.data.tags);

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .filter((p) =>
    p.data.tags?.some((tag: string) => post.data.tags?.includes(tag)),
  )
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const displayPosts =
  relatedPosts.length > 0
    ? relatedPosts
    : allPosts
        .filter((p) => p.id !== post.id)
        .sort(
          (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
        )
        .slice(0, 3);

const publishedTime =
  post.data.publishDate instanceof Date
    ? post.data.publishDate.toISOString()
    : post.data.publishDate;

const modifiedTime = post.data.updatedDate
  ? post.data.updatedDate instanceof Date
    ? post.data.updatedDate.toISOString()
    : post.data.updatedDate
  : publishedTime;

const ctaVariant: BlogCtaVariant =
  commercialBlogCtaBySlug[post.id] ?? "diagnostic";
---

<MainLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  article={{
    publishedTime,
    modifiedTime,
    author: post.data.author,
    tags: post.data.tags,
  }}
  faqs={post.data.faqs}
>
  <article class="min-h-screen py-20 px-6">
    <div class="max-w-4xl mx-auto space-y-12">
      <Breadcrumbs
        className="pl-4"
        items={[
          { name: "Recursos", url: "/recursos" },
          { name: post.data.title, url: `/recursos/${post.id}` },
        ]}
      />

      <header class="space-y-6">
        <div class="space-y-4">
          <div class="flex flex-wrap gap-2">
            <span
              class="text-xs px-3 py-1 rounded-full bg-primary text-background font-semibold"
            >
              {getResourceLabel(post.data.resourceType)}
            </span>
            <span
              class="text-xs px-3 py-1 rounded-full bg-muted text-foreground"
            >
              {getBuyerStageLabel(post.data.buyerStage)}
            </span>
          </div>

          <h1
            class="text-2xl max-w-xl text-balance md:text-4xl font-bold text-foreground"
          >
            {post.data.title}
          </h1>

          <div
            class="flex items-center gap-4 text-neutral-600 dark:text-neutral-400"
          >
            <time datetime={post.data.publishDate.toISOString()}>
              {
                post.data.publishDate.toLocaleDateString("es-ES", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })
              }
            </time>
            <span>&bull;</span>
            <span>{post.data.author}</span>
          </div>

          {
            postCategories.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {postCategories.map((category) => (
                  <a
                    href={`/recursos/tags/${category.slug}`}
                    class="text-sm px-4 py-2 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors"
                  >
                    {category.label}
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </header>

      <div
        class="px-2
      prose prose-neutral prose-sm w-full
        prose-headings:font-bold prose-headings:text-foreground
        prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6
        prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-4
        prose-h4:text-xl prose-h4:mt-6 prose-h4:mb-3
        prose-p:text-muted-foreground
        prose-p:leading-relaxed
        prose-a:text-foreground
        prose-a:underline
        hover:prose-a:no-underline
        prose-strong:text-foreground
        prose-ul:text-muted-foreground
        prose-ol:text-muted-foreground
        prose-li:marker:text-neutral-500
        prose-blockquote:border-l-4
        prose-blockquote:border-neutral-300
        prose-blockquote:italic
        prose-blockquote:text-neutral-600
        prose-code:text-foreground
        prose-pre:bg-foreground"
      >
        <Content />
      </div>

      <BlogCTA
        variant={ctaVariant}
        headline={post.data.leadMagnet?.title}
        body={post.data.leadMagnet?.description}
        cta={post.data.leadMagnet?.cta}
        href={post.data.leadMagnet?.href}
      />

      <aside
        class="not-prose overflow-hidden rounded-3xl border border-primary/20 bg-accent/40 p-6 md:p-8"
      >
        <div class="mb-6 max-w-2xl space-y-2">
          <p
            class="text-xs font-semibold uppercase tracking-[0.18em] text-primary"
          >
            Siguiente paso
          </p>
          <h2
            class="text-2xl font-bold tracking-tight text-foreground md:text-3xl"
          >
            Convierte lo aprendido en ahorro real
          </h2>
          <p class="text-sm leading-relaxed text-muted-foreground md:text-base">
            Soluciones prácticas para aplicar estas ideas a un proceso concreto
            de tu negocio.
          </p>
        </div>

        <div class="grid gap-3 md:grid-cols-3">
          {
            commercialBlogLinks.map((link) => (
              <a
                href={`${link.href}?ref=recurso-interno-${post.id}`}
                class="group flex min-h-44 flex-col rounded-2xl border border-muted/80 bg-background p-5 shadow-pastel-sm transition-[transform,border-color,box-shadow] duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-pastel focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
              >
                <div class="flex items-start justify-between gap-4">
                  <h3 class="font-semibold leading-tight text-foreground">
                    {link.label}
                  </h3>
                  <span
                    aria-hidden="true"
                    class="flex size-9 shrink-0 items-center justify-center rounded-full bg-secondary text-primary transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  >
                    <ArrowUpRight class="size-4" />
                  </span>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-muted-foreground line-clamp-3">
                  {link.description}
                </p>
                <span class="mt-auto pt-5 text-sm font-semibold text-primary">
                  Ver solución
                </span>
              </a>
            ))
          }
        </div>
      </aside>

      {
        displayPosts.length > 0 && (
          <section class="not-prose mt-20 border-t pt-16 md:pt-20">
            <div class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
              <div class="max-w-2xl space-y-2">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">
                  Sigue explorando
                </p>
                <h2 class="text-3xl font-bold tracking-tight text-foreground">
                  Recursos relacionados
                </h2>
                <p class="text-muted-foreground">
                  Más contexto para tomar mejores decisiones y pasar a la
                  acción.
                </p>
              </div>
              <a
                href="/recursos"
                class="group inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-foreground hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
              >
                Ver todos
                <ArrowUpRight class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </a>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              {displayPosts.map((p) => (
                <article class="group h-full">
                  <a
                    href={`/recursos/${p.id}`}
                    class="relative isolate flex h-full min-h-72 flex-col overflow-hidden rounded-3xl border border-muted/80 bg-background p-6 shadow-pastel-sm transition-[transform,border-color,box-shadow] duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-pastel focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary md:p-7"
                  >
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute -right-20 -top-24 -z-10 size-64 rounded-full bg-accent/70 blur-3xl transition-transform duration-500 group-hover:scale-110"
                    />

                    <header class="flex items-center justify-between gap-4">
                      <span class="rounded-full border border-muted bg-secondary px-3 py-1 text-xs font-semibold text-primary">
                        {getResourceLabel(p.data.resourceType)}
                      </span>
                      <span
                        aria-hidden="true"
                        class="flex size-10 shrink-0 items-center justify-center rounded-full border border-muted bg-secondary text-primary transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                      >
                        <ArrowUpRight class="size-4" />
                      </span>
                    </header>

                    <h3 class="mt-8 text-xl font-bold leading-tight tracking-tight text-foreground transition-colors group-hover:text-primary md:text-2xl">
                      {p.data.title}
                    </h3>
                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground line-clamp-3 md:text-base">
                      {p.data.description}
                    </p>

                    <footer class="mt-auto flex items-center justify-between gap-4 pt-8 text-xs text-muted-foreground">
                      <time datetime={p.data.publishDate.toISOString()}>
                        {p.data.publishDate.toLocaleDateString("es-ES", {
                          month: "short",
                          year: "numeric",
                        })}
                      </time>
                      <span>{getBuyerStageLabel(p.data.buyerStage)}</span>
                    </footer>
                  </a>
                </article>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>
</MainLayout>

<script>
  import mediumZoom from "medium-zoom";
  document.addEventListener("astro:page-load", () => {
    mediumZoom(".prose img", { background: "rgba(12,17,11,0.6)", margin: 24 });
  });
</script>
