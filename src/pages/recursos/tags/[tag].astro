---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import SectionTag from "~/components/ui/SectionTag.astro";
import MainLayout from "~/layouts/MainLayout.astro";
import {
  getResourceCategories,
  resourceCategories,
  type ResourceCategory,
} from "~/shared/lib/resourceCategories";
import { getResourceLabel } from "~/shared/lib/resources";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);

  return resourceCategories.map((category) => ({
    params: { tag: category.slug },
    props: {
      category,
      posts: allPosts
        .filter((post) =>
          getResourceCategories(post.data.tags).some(
            ({ slug }) => slug === category.slug,
          ),
        )
        .sort(
          (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
        ),
    },
  }));
}

const { posts, category } = Astro.props as {
  posts: CollectionEntry<"blog">[];
  category: ResourceCategory;
};
---

<MainLayout
  title={`Recursos sobre ${category.label} | doscientos`}
  description={category.description}
>
  <div class="min-h-screen py-32 px-6">
    <div class="max-w-6xl mx-auto space-y-12">
      <Breadcrumbs
        items={[
          { name: "Recursos", url: "/recursos" },
          { name: category.label, url: Astro.url.pathname },
        ]}
      />

      <header
        class="flex flex-col max-w-2xl items-center justify-center text-center gap-6 mx-auto"
      >
        <SectionTag>Tema: {category.label}</SectionTag>
        <h1
          class="font-semibold text-foreground flex flex-col text-3xl md:text-5xl items-center text-center text-pretty"
        >
          <span>Recursos sobre {category.label}</span>
        </h1>
        <p class="text-muted-foreground max-w-xl text-pretty">
          {category.description}
        </p>
        <p class="text-muted-foreground max-w-md text-pretty">
          {posts.length}
          {posts.length === 1 ? "recurso publicado" : "recursos publicados"} bajo
          esta categoria.
        </p>
        <a
          href="/recursos"
          class="text-sm text-primary hover:underline font-medium"
        >
          Volver a todos los recursos
        </a>
      </header>

      <div class="grid md:grid-cols-2 gap-6">
        {
          posts.map((post) => (
            <article class="group">
              <a
                href={`/recursos/${post.id}`}
                class="flex flex-col h-full p-6 rounded-2xl gap-3 shadow-pastel border border-muted bg-accent hover:border-primary transition-colors"
              >
                <span class="w-fit text-xs px-3 py-1 rounded-full bg-background text-foreground border border-muted font-semibold">
                  {getResourceLabel(post.data.resourceType)}
                </span>
                <time
                  class="text-sm text-muted-foreground"
                  datetime={post.data.publishDate.toISOString()}
                >
                  {post.data.publishDate.toLocaleDateString("es-ES", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>

                <h2 class="text-2xl font-bold text-foreground transition-colors">
                  {post.data.title}
                </h2>

                <p class="text-muted-foreground line-clamp-3">
                  {post.data.description}
                </p>

                <div class="flex items-center gap-2 text-foreground font-medium pt-2">
                  Ver recurso
                  <svg
                    class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 8l4 4m0 0l-4 4m4-4H3"
                    />
                  </svg>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</MainLayout>
