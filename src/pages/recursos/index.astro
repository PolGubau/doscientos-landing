---
import { getCollection } from "astro:content";
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import MainLayout from "~/layouts/MainLayout.astro";
import {
  getResourceCategories,
  resourceCategories,
} from "~/shared/lib/resourceCategories";
import { getBuyerStageLabel, getResourceLabel } from "~/shared/lib/resources";

const resources = await getCollection("blog", ({ data }) => !data.draft);
const sortedResources = resources.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const featuredResources = sortedResources
  .filter((post) => post.data.leadMagnet)
  .slice(0, 3);
const filters = resourceCategories.map((category) => ({
  ...category,
  count: sortedResources.filter((post) =>
    getResourceCategories(post.data.tags).some(
      ({ slug }) => slug === category.slug,
    ),
  ).length,
}));
---

<MainLayout
  title="Recursos gratis sobre automatizacion y software a medida | doscientos"
  description="Guias, checklists, calculadoras y articulos para detectar procesos manuales, priorizar automatizaciones y decidir que construir primero."
>
  <div class="min-h-screen py-32 px-6">
    <div class="max-w-6xl mx-auto space-y-12">
      <Breadcrumbs items={[{ name: "Recursos", url: "/recursos" }]} />

      <header
        class="flex flex-col max-w-3xl items-center justify-center text-center gap-6 mx-auto"
      >
        <h1
          class="font-semibold text-foreground flex flex-col text-3xl md:text-5xl items-center text-center text-pretty"
        >
          <span>Herramientas y guias para decidir que automatizar</span>
        </h1>
        <p class="text-muted-foreground max-w-2xl text-pretty">
          Contenido practico para detectar coste oculto, comparar opciones y
          preparar una decision antes de invertir en software.
        </p>
      </header>

      {
        featuredResources.length > 0 && (
          <section class="grid gap-4 md:grid-cols-3">
            {featuredResources.map((post) => (
              <a
                href={`/recursos/${post.id}?ref=recurso-destacado`}
                class="group rounded-2xl border border-primary/20 bg-primary text-background p-6 space-y-4 shadow-pastel hover:opacity-95 transition-opacity"
              >
                <div class="flex items-center justify-between gap-3">
                  <span class="text-xs font-semibold opacity-80">
                    {getResourceLabel(post.data.resourceType)}
                  </span>
                </div>
                <h2 class="text-xl font-bold leading-tight">
                  {post.data.leadMagnet?.title}
                </h2>
                <p class="text-sm opacity-80 leading-relaxed">
                  {post.data.leadMagnet?.description}
                </p>
                <span class="inline-flex text-sm font-semibold group-hover:underline">
                  {post.data.leadMagnet?.cta ?? "Ver recurso"}
                </span>
              </a>
            ))}
          </section>
        )
      }

      {
        sortedResources.length > 0 ? (
          <section class="space-y-8" aria-labelledby="resources-heading">
            <div class="space-y-4 border-b border-muted pb-6">
              <div class="flex flex-wrap items-end justify-between gap-4">
                <div class="space-y-1">
                  <h2
                    id="resources-heading"
                    class="text-2xl font-semibold text-foreground"
                  >
                    Explora los recursos
                  </h2>
                  <p class="text-sm text-muted-foreground">
                    Filtra por los temas principales sin salir de esta página.
                  </p>
                </div>
                <p
                  id="resource-filter-status"
                  class="text-sm text-muted-foreground"
                  aria-live="polite"
                >
                  {sortedResources.length} recursos
                </p>
              </div>

              <div
                class="flex flex-wrap gap-2"
                data-resource-filters
                aria-label="Filtrar recursos por tema"
              >
                <button
                  type="button"
                  data-resource-filter="all"
                  aria-pressed="true"
                  class="rounded-full border border-primary bg-primary px-4 py-2 text-sm font-semibold text-background transition-colors"
                >
                  Todos
                </button>
                {filters.map((filter) => (
                  <button
                    type="button"
                    data-resource-filter={filter.slug}
                    aria-pressed="false"
                    class="rounded-full border border-muted bg-background px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-primary/40"
                  >
                    {filter.label}{" "}
                    <span class="opacity-70">{filter.count}</span>
                  </button>
                ))}
              </div>
            </div>

            <div class="grid gap-6 md:grid-cols-2" data-resource-grid>
              {sortedResources.map((post) => {
                const postCategories = getResourceCategories(post.data.tags);
                return (
                  <article
                    class="group"
                    data-resource-card
                    data-resource-categories={postCategories
                      .map(({ slug }) => slug)
                      .join(" ")}
                  >
                    <div class="flex flex-col h-full p-6 rounded-2xl gap-3 shadow-pastel border border-muted bg-secondary hover:border-primary transition-colors">
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="text-xs px-3 py-1 rounded-full bg-background text-foreground border border-muted font-semibold">
                          {getResourceLabel(post.data.resourceType)}
                        </span>
                        <span class="text-xs px-3 py-1 rounded-full bg-muted text-foreground">
                          {getBuyerStageLabel(post.data.buyerStage)}
                        </span>
                      </div>

                      <time
                        class="text-sm text-muted-foreground"
                        datetime={post.data.publishDate.toISOString()}
                      >
                        {post.data.publishDate.toLocaleDateString("es-ES", {
                          year: "numeric",
                          month: "long",
                          day: "numeric",
                        })}
                      </time>

                      <a href={`/recursos/${post.id}`} class="group/title">
                        <h2 class="text-2xl font-bold text-foreground group-hover/title:text-primary transition-colors">
                          {post.data.title}
                        </h2>
                      </a>

                      <p class="text-muted-foreground line-clamp-3">
                        {post.data.description}
                      </p>

                      {postCategories.length > 0 && (
                        <div class="flex flex-wrap gap-2 pt-1">
                          {postCategories.slice(0, 2).map((category) => (
                            <span class="text-xs px-3 py-1 rounded-full bg-muted text-foreground">
                              {category.label}
                            </span>
                          ))}
                        </div>
                      )}

                      <div class="mt-auto pt-4">
                        <a
                          href={`/recursos/${post.id}`}
                          class="flex items-center gap-2 text-foreground font-medium"
                        >
                          Ver recurso
                          <svg
                            class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M17 8l4 4m0 0l-4 4m4-4H3"
                            />
                          </svg>
                        </a>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
            <p
              hidden
              class="py-12 text-center text-muted-foreground"
              data-resource-empty
            >
              No hay recursos publicados en esta categoría todavía.
            </p>
          </section>
        ) : (
          <div class="text-center py-20">
            <p class="text-xl text-neutral-500 dark:text-neutral-400">
              Proximamente publicaremos recursos practicos.
            </p>
          </div>
        )
      }
    </div>
  </div>
</MainLayout>

<script>
  const filterBar = document.querySelector<HTMLElement>(
    "[data-resource-filters]",
  );

  if (filterBar && filterBar.dataset.ready !== "true") {
    filterBar.dataset.ready = "true";
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-resource-card]"),
    );
    const status = document.querySelector<HTMLElement>(
      "#resource-filter-status",
    );
    const empty = document.querySelector<HTMLElement>("[data-resource-empty]");

    filterBar.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest<HTMLButtonElement>(
        "[data-resource-filter]",
      );
      const selected = button?.dataset.resourceFilter;
      if (!button || !selected) return;

      let visible = 0;
      cards.forEach((card) => {
        const categories = card.dataset.resourceCategories?.split(" ") ?? [];
        const matches = selected === "all" || categories.includes(selected);
        card.hidden = !matches;
        if (matches) visible += 1;
      });

      filterBar
        .querySelectorAll<HTMLButtonElement>("[data-resource-filter]")
        .forEach((item) => {
          const active = item === button;
          item.setAttribute("aria-pressed", String(active));
          item.classList.toggle("border-primary", active);
          item.classList.toggle("bg-primary", active);
          item.classList.toggle("text-background", active);
          item.classList.toggle("border-muted", !active);
          item.classList.toggle("bg-background", !active);
          item.classList.toggle("text-foreground", !active);
        });

      if (status)
        status.textContent = `${visible} ${visible === 1 ? "recurso" : "recursos"}`;
      if (empty) empty.hidden = visible !== 0;
    });
  }
</script>
