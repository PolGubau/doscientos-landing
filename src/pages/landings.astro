---
import { Image } from "astro:assets";
import {
  Building2,
  CalendarCheck,
  Check,
  CircleX,
  Dumbbell,
  ExternalLink,
  FileText,
  Globe,
  Headphones,
  MonitorSmartphone,
  Palette,
  Scissors,
  Search,
  ShieldCheck,
  Sparkles,
  Store,
  Utensils,
} from "@lucide/astro";
import imgArnau from "~/assets/media/landing/examples-landings/arnaumartinez.avif";
import imgCyber from "~/assets/media/landing/examples-landings/cyberimpulsa.avif";
import imgDoscientos from "~/assets/media/landing/examples-landings/doscientos.jpg";
