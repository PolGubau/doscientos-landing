---

<MainLayout
  title={title}
  description={description}
  robots="noindex,nofollow"
  showFooterCta={false}
>
  <section class="px-6 max-w-7xl mx-auto pt-20 lg:pt-28 w-full">
    <div
      class="grid lg:grid-cols-[1.04fr_0.96fr] gap-10 lg:gap-16 items-center"
    >
      <header class="flex flex-col gap-8" data-stagger="100">
        <div data-reveal="top" data-speed="fast" data-easing="smooth">
          <SectionTag>Webs para pequeños negocios</SectionTag>
        </div>

        <div class="space-y-6">
          <h1
            class="text-4xl sm:text-5xl lg:text-5xl xl:text-7xl font-bold tracking-tight text-balance text-foreground"
            data-reveal="scale"
            data-speed="normal"
            data-easing="bounce"
          >
            Tu web profesional lista en 48 horas
          </h1>
          <p
            class="text-lg lg:text-xl text-muted-foreground max-w-2xl text-pretty leading-relaxed"
            data-reveal="bottom"
            data-speed="normal"
            data-easing="soft"
          >
            Elige el pack de tu negocio y consigue una web diseñada para atraer
            más clientes, reservas y contactos desde el primer día.
          </p>
        </div>

        <div
          class="flex flex-col sm:flex-row gap-4"
          data-reveal="scale"
          data-speed="fast"
          data-easing="elastic"
        >
          <a
            href="/contact?subject=Quiero mi web en 48 horas&ref=landing-general"
          >
            <Button size="lg" withArrow>Quiero mi web en 48h</Button>
          </a>
          <a href="#packs-negocio">
            <Button size="lg" variant="outline">Ver packs por negocio</Button>
          </a>
        </div>

        <ul class="grid sm:grid-cols-2 gap-3 max-w-2xl" data-stagger="60">
          {
            highlights.map((item) => (
              <li
                class="flex items-center gap-3 rounded-full border border-muted/80 bg-accent px-4 py-3 text-sm font-medium text-foreground shadow-pastel-sm"
                data-reveal="bottom"
                data-speed="normal"
                data-easing="soft"
                data-distance="small"
              >
                <Check class="size-4 text-primary shrink-0" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <p
          class="text-sm font-semibold text-foreground max-w-2xl text-pretty"
          data-reveal="bottom"
          data-speed="fast"
          data-easing="soft"
        >
          Precio especial solo para los 10 primeros clientes. Cuando se
          completen las plazas, los precios subirán.
        </p>
      </header>

      <!-- Hero showcase: 3 landing screenshots en capas -->
      <div
        class="hero-showcase relative hidden lg:flex items-center justify-center"
        data-reveal="right"
        data-speed="normal"
        data-easing="smooth"
      >
        <!-- Card trasera izquierda -->
        <div class="showcase-card showcase-card--back-left">
          <div class="browser-chrome">
            <span class="dot dot--red"></span>
            <span class="dot dot--yellow"></span>
            <span class="dot dot--green"></span>
            <span class="browser-url">arnaumartinez.com</span>
          </div>
          <Image
            src={imgArnau}
            alt="Landing page profesional de Arnau Martínez - ejemplo de web personal hecha con doscientos"
            width={640}
            height={420}
            class="w-full object-cover object-top"
            loading="eager"
          />
        </div>

        <!-- Card central (protagonista) -->
        <div class="showcase-card showcase-card--center">
          <div class="browser-chrome">
            <span class="dot dot--red"></span>
            <span class="dot dot--yellow"></span>
            <span class="dot dot--green"></span>
            <span class="browser-url">cyberimpulsa.com</span>
          </div>
          <Image
            src={imgCyber}
            alt="Landing page profesional de Cyberimpulsa - ejemplo de web para negocio hecha con doscientos"
            width={640}
            height={420}
            class="w-full object-cover object-top"
            loading="eager"
          />
        </div>

        <!-- Card trasera derecha -->
        <div class="showcase-card showcase-card--back-right">
          <div class="browser-chrome">
            <span class="dot dot--red"></span>
            <span class="dot dot--yellow"></span>
            <span class="dot dot--green"></span>
            <span class="browser-url">polgubau.com</span>
          </div>
          <Image
            src={imgPol}
            alt="Landing page profesional de Pol Gubau - ejemplo de portfolio web hecho con doscientos"
            width={640}
            height={420}
            class="w-full object-cover object-top"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="px-6 max-w-5xl mx-auto w-full">
    <div
      class="bg-foreground text-background rounded-3xl p-6 md:p-8 shadow-pastel flex flex-col md:flex-row md:items-center md:justify-between gap-6"
      data-reveal="bottom"
      data-speed="normal"
      data-easing="smooth"
    >
      <div class="space-y-3">
        <div data-reveal="top" data-speed="fast" data-easing="smooth">
          <span
            class="rounded-full bg-background/10 text-background px-3 py-1 text-xs font-semibold"
          >
            Oferta de lanzamiento
          </span>
        </div>
        <div class="space-y-2">
          <h2 class="text-2xl md:text-4xl font-bold text-balance">
            Precio especial solo para los 10 primeros clientes
          </h2>
          <p class="text-background/70 text-pretty">
            Estamos lanzando esta oferta para negocios locales que quieren una
            web profesional rápida, clara y preparada para convertir visitas en
            clientes.
          </p>
          <p class="text-sm font-semibold text-background">
            Cuando se completen las 10 plazas, esta promoción desaparecerá y los
            precios aumentarán.
          </p>
        </div>
      </div>
      <div
        class="rounded-2xl bg-background text-foreground p-5 md:min-w-[220px] text-center"
      >
        <p class="text-sm text-muted-foreground">Plazas de lanzamiento</p>
        <p class="text-3xl font-bold">{launchAvailability}</p>
      </div>
    </div>
  </section>

  <section id="packs-negocio" class="landing-section scroll-mt-28">
    <SectionHeader
      title="Soluciones pensadas para tu negocio"
      description="Empieza con el Pack Base o elige una solución diseñada para transformar visitas en reservas, contactos y clientes según las necesidades reales de tu sector."
      align="center"
    />

    <div class="grid lg:grid-cols-2 gap-4 w-full" data-stagger="90">
      {
        landingPacks.map((pack) => {
          const Icon = iconMap[pack.icon] ?? Globe;
          const featured = pack.title === "Pack Base";
          const packFeatures =
            pack.title === "Pack Base" ? basePackFeatures : sharedPackFeatures;

          return (
            <article
              class={`group rounded-3xl border shadow-pastel p-5 md:p-7 flex flex-col gap-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-pastel-sm ${
                featured
                  ? "bg-foreground text-background border-foreground"
                  : "bg-accent text-foreground border-muted/60"
              }`}
              data-reveal="bottom"
              data-speed="normal"
              data-easing="smooth"
            >
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-5">
                <div class="space-y-4">
                  <div
                    class={`size-12 rounded-2xl flex items-center justify-center ${
                      featured
                        ? "bg-background/10 text-background"
                        : "bg-primary/10 text-primary"
                    }`}
                  >
                    <Icon class="size-6" />
                  </div>
                  <div class="space-y-3">
                    <h3 class="text-2xl md:text-3xl font-bold">{pack.title}</h3>
                    <p
                      class={`text-base font-semibold leading-relaxed text-pretty max-w-xl ${
                        featured ? "text-background" : "text-foreground"
                      }`}
                    >
                      {pack.tagline}
                    </p>
                    <p
                      class={`text-sm leading-relaxed text-pretty max-w-xl ${
                        featured
                          ? "text-background/70"
                          : "text-muted-foreground"
                      }`}
                    >
                      {pack.story}
                    </p>
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-2 sm:min-w-[220px]">
                  <div
                    class={`rounded-2xl p-3 ${
                      featured
                        ? "bg-background text-foreground"
                        : "bg-background border border-muted"
                    }`}
                  >
                    <p class="text-xs text-muted-foreground">Instalación</p>
                    <p class="font-bold">{pack.install}</p>
                  </div>
                  <div
                    class={`rounded-2xl p-3 ${
                      featured
                        ? "bg-primary text-background"
                        : "bg-primary/10 text-primary"
                    }`}
                  >
                    <p
                      class={`text-xs ${
                        featured ? "text-background/70" : "text-primary/70"
                      }`}
                    >
                      Mensual
                    </p>
                    <p class="font-bold">{pack.monthly}</p>
                  </div>
                </div>
              </div>

              <div class="flex flex-wrap gap-2">
                {packFeatures.map((feature) => (
                  <span
                    class={`rounded-full px-3 py-1.5 text-xs font-semibold ${
                      featured
                        ? "bg-background/10 text-background"
                        : "bg-primary/10 text-primary"
                    }`}
                  >
                    {feature}
                  </span>
                ))}
              </div>

              <div class="grid md:grid-cols-2 gap-6">
                <div class="space-y-4">
                  <h4 class="font-bold">
                    {pack.title === "Pack Base"
                      ? "Qué incluye"
                      : "Incluye además del pack base"}
                  </h4>
                  <ul class="space-y-3">
                    {pack.extras.map((feature) => (
                      <li class="flex items-start gap-3 text-sm">
                        <Check
                          class={`size-4 mt-0.5 shrink-0 ${
                            featured ? "text-background" : "text-primary"
                          }`}
                        />
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="space-y-4">
                  <h4 class="font-bold">Qué gana tu negocio</h4>
                  <ul class="space-y-3">
                    {pack.gains.map((gain) => (
                      <li class="flex items-start gap-3 text-sm">
                        <Sparkles
                          class={`size-4 mt-0.5 shrink-0 ${
                            featured ? "text-background" : "text-primary"
                          }`}
                        />
                        <span>{gain}</span>
                      </li>
