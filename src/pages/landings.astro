<style>
  /* ─── Hero showcase ────────────────────────────────────────────────────── */
  .hero-showcase {
    /* Fluid sizing so the layered cards always fit inside their grid column
       (avoids overflowing onto the copy on small laptops). */
    --card-w: clamp(220px, 22vw, 300px);
    --spread: clamp(80px, 10vw, 145px);
    --img-h: clamp(180px, 17vw, 240px);
    height: clamp(400px, 32vw, 460px);
    perspective: 1200px;
  }

  /* Browser chrome bar */
  .browser-chrome {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-muted);
    background: var(--color-background);
    flex-shrink: 0;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dot--red {
    background: #ff5f57;
  }
  .dot--yellow {
    background: #febc2e;
  }
  .dot--green {
    background: #28c840;
  }

  .browser-url {
    margin-left: 10px;
    font-size: 11px;
    color: var(--color-muted-foreground);
    font-family: monospace;
    background: var(--color-muted);
    padding: 2px 10px;
    border-radius: 20px;
  }

  /* Base card */
  .showcase-card {
    position: absolute;
    width: var(--card-w);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--color-muted);
    background: var(--color-background);
    display: flex;
    flex-direction: column;
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.07),
      0 20px 40px -8px rgb(0 0 0 / 0.12);
    transition:
      transform 0.4s ease,
      box-shadow 0.4s ease;
  }

  .showcase-card img {
    display: block;
    width: 100%;
    height: var(--img-h);
    object-fit: cover;
    object-position: top;
  }

  /* Card central – protagonist */
  .showcase-card--center {
    z-index: 10;
    transform: translateY(0px) scale(1);
    animation: float-center 6s ease-in-out infinite;
    box-shadow:
      0 8px 12px -2px rgb(0 0 0 / 0.1),
      0 32px 64px -12px rgb(0 0 0 / 0.18);
  }

  /* Card izquierda */
  .showcase-card--back-left {
    z-index: 5;
    transform: translateX(calc(-1 * var(--spread))) translateY(28px)
      rotate(-6deg) scale(0.88);
    animation: float-left 6s ease-in-out infinite;
    animation-delay: -2s;
    opacity: 0.85;
  }

  /* Card derecha */
  .showcase-card--back-right {
    z-index: 5;
    transform: translateX(var(--spread)) translateY(28px) rotate(6deg)
      scale(0.88);
    animation: float-right 6s ease-in-out infinite;
    animation-delay: -4s;
    opacity: 0.85;
  }

  @keyframes float-center {
    0%,
    100% {
      transform: translateY(0px) scale(1);
    }
    50% {
      transform: translateY(-12px) scale(1);
    }
  }

  @keyframes float-left {
    0%,
    100% {
      transform: translateX(calc(-1 * var(--spread))) translateY(28px)
        rotate(-6deg) scale(0.88);
    }
    50% {
      transform: translateX(calc(-1 * var(--spread))) translateY(16px)
        rotate(-6deg) scale(0.88);
    }
  }

  @keyframes float-right {
    0%,
    100% {
      transform: translateX(var(--spread)) translateY(28px) rotate(6deg)
        scale(0.88);
    }
    50% {
      transform: translateX(var(--spread)) translateY(16px) rotate(6deg)
        scale(0.88);
    }
  }

  /* Hover: acercar las laterales */
  .hero-showcase:hover .showcase-card--back-left {
    opacity: 0.95;
    transform: translateX(calc(-1 * var(--spread) - 8px)) translateY(18px)
      rotate(-5deg) scale(0.91);
  }
  .hero-showcase:hover .showcase-card--back-right {
    opacity: 0.95;
    transform: translateX(calc(var(--spread) + 8px)) translateY(18px)
      rotate(5deg) scale(0.91);
  }

  /* Respeta usuarios con movimiento reducido */
  @media (prefers-reduced-motion: reduce) {
    .showcase-card {
      animation: none !important;
    }
  }
</style>
