---
import ContactForm from "~/components/forms/ContactForm";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import MainLayout from "~/layouts/MainLayout.astro";
---

<MainLayout
  title="Contacto - Agenda una llamada gratuita | doscientos"
  description="Llamada de 15 minutos sin compromiso. Respuesta en 24h. Hablemos de tu proyecto y cómo podemos ayudarte a lanzar en 6 semanas."
>
  <section class="px-6 max-w-4xl mx-auto pt-20 lg:pt-36 pb-20">
    <div class="space-y-12 w-full" data-stagger="150">
      <SectionHeader
        title="Hablemos de tu proyecto"
        description="Rellena este breve formulario y agenda tu llamada."
        align="center"
      />

      <article
        class="bg-muted/30 w-full rounded-3xl p-6 md:p-8 max-w-3xl mx-auto"
      >
        <ContactForm client:load />
      </article>
    </div>
  </section>
</MainLayout>
