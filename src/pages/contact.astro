---
import ContactForm from "~/components/forms/ContactForm";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import MainLayout from "~/layouts/MainLayout.astro";
---

<MainLayout
  title="Contacto - Agenda una llamada gratuita | doscientos"
  description="Llamada de 15 minutos sin compromiso. Respuesta en 24h. Hablemos de tu proyecto y cómo podemos ayudarte a lanzar en 6 semanas."
>
  <section class="px-6 max-w-4xl mx-auto pt-20 lg:pt-36 pb-20">
    <div class="space-y-12">
      <SectionHeader
        title="Hablemos de tu proyecto"
        description="Tanto si estás listo para empezar como si solo tienes dudas, estamos aquí para ayudarte. Rellena este breve formulario y agenda tu llamada."
        align="center"
      />

      <article
        class="bg-muted/30 rounded-3xl p-8 md:p-12 border border-muted shadow-sm"
      >
        <div class="max-w-3xl w-full mx-auto">
          <ContactForm client:load />
        </div>
      </article>
    </div>
  </section>
</MainLayout>
