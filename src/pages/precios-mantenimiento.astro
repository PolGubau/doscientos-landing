---
import { Check, ShieldCheck } from "@lucide/astro";
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import Button from "~/components/ui/Button.astro";
import MainLayout from "~/layouts/MainLayout.astro";

const title = "Precios de mantenimiento web | doscientos";
const description =
  "Planes de mantenimiento web para mantener tu sitio seguro, actualizado y en evolución. Elige el nivel de soporte que necesita tu proyecto.";

const plans = [
  { name: "Esencial", price: "80 €", featured: false },
  { name: "Crecimiento", price: "100 €", featured: true },
  { name: "Evolución", price: "450 €", featured: false },
];

const features = [
  { label: "Hosting e infraestructura", values: ["check", "check", "check"] },
  { label: "Monitorización básica", values: ["check", "check", "check"] },
  { label: "Actualizaciones técnicas", values: ["—", "check", "check"] },
  { label: "Backups / seguridad", values: ["—", "check", "check"] },
  { label: "Corrección de errores", values: ["Críticos", "check", "Prioritaria"] },
  { label: "Soporte", values: ["Email", "Email/WhatsApp", "Prioritario"] },
  { label: "Cambios", values: ["—", "1 h/mes", "4 h/mes"] },
  { label: "Mejoras / nuevas funcionalidades", values: ["—", "Pequeñas", "check"] },
  { label: "Revisión periódica", values: ["—", "Trimestral", "Mensual"] },
  { label: "Analítica / rendimiento", values: ["—", "Básica", "check"] },
  { label: "Evolución continua", values: ["—", "Limitada", "check"] },
];
---

<MainLayout title={title} description={description} type="service" service={{ name: "Mantenimiento web", description, serviceType: "Website maintenance", url: "/precios-mantenimiento" }}>
  <section class="px-6 max-w-7xl mx-auto pt-6 md:pt-10 w-full">
    <Breadcrumbs items={[{ name: "Mantenimiento web", url: "/precios-mantenimiento" }]} />

    <header class="max-w-3xl mx-auto text-center pt-14 pb-12 md:pt-20 md:pb-16">
      <p class="inline-flex rounded-full bg-accent px-4 py-2 text-sm font-semibold text-primary">
        Mantenimiento web
      </p>
      <h1 class="mt-6 text-4xl md:text-6xl font-bold text-balance text-foreground">
        Tu web al día, <span class="text-primary">sin sorpresas.</span>
      </h1>
      <p class="mt-5 text-lg md:text-xl leading-relaxed text-muted-foreground text-balance">
        Elige el nivel de acompañamiento que necesita tu proyecto. Nosotros nos ocupamos de que todo siga funcionando.
      </p>
    </header>

    <p class="mb-3 flex items-center gap-2 text-sm text-muted-foreground md:hidden">
      <span aria-hidden="true">←</span> Desliza para comparar todos los planes <span aria-hidden="true">→</span>
    </p>
    <div class="overflow-x-auto rounded-3xl border border-muted bg-background shadow-pastel" data-reveal="bottom">
      <table
        class="w-full min-w-[760px] border-collapse text-left whitespace-normal"
        style="display: table; max-width: none;"
      >
        <caption class="sr-only">Comparativa de planes de mantenimiento web</caption>
        <thead>
          <tr class="border-b border-muted">
            <th scope="col" class="w-[30%] border-r border-muted bg-muted/35 px-6 py-6 align-bottom text-xs font-bold uppercase tracking-wider text-muted-foreground">Qué incluye</th>
            {plans.map((plan) => (
              <th scope="col" class:list={["w-[23.33%] px-5 py-5 align-bottom", plan.featured && "bg-foreground/[0.03]"]}>
                <div class="flex flex-col gap-2">
                  {plan.featured && <span class="w-fit rounded-full bg-accent px-2.5 py-1 text-xs font-semibold text-primary">MÁS ELEGIDO</span>}
                  <span class="text-xl font-bold">{plan.name}</span>
                  <span class="text-sm font-medium text-muted-foreground">Desde</span>
                  <span class="text-2xl font-bold leading-none">{plan.price}<span class="text-sm font-medium">/mes</span></span>
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {features.map((feature, rowIndex) => (
            <tr class:list={["border-b border-muted last:border-b-0", rowIndex % 2 === 0 && "bg-muted/20"]}>
              <th scope="row" class="border-r border-muted bg-background/55 px-6 py-4 text-sm font-semibold text-foreground">{feature.label}</th>
              {feature.values.map((value, index) => (
                <td class:list={["px-5 py-4 text-center text-sm font-medium", index === 1 && "bg-foreground/[0.03]", value === "—" ? "text-muted-foreground" : "text-foreground"]}>
                  {value === "check" ? <Check class="mx-auto size-5 text-primary" stroke-width={3} aria-label="Incluido" /> : value}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <aside class="mt-6 flex gap-3 rounded-2xl border border-primary/15 bg-accent/45 p-5 text-sm leading-relaxed text-primary">
      <ShieldCheck class="size-5 shrink-0 mt-0.5" />
      <p>Todos los planes incluyen una base técnica sólida para que tu web sea segura, estable y esté siempre disponible.</p>
    </aside>

    <section class="my-24 md:my-32 rounded-3xl bg-foreground text-background p-8 md:p-12 text-center flex flex-col items-center gap-6">
      <div class="space-y-3 max-w-2xl">
        <h2 class="text-3xl md:text-5xl font-bold text-balance">¿No tienes claro qué plan necesitas?</h2>
        <p class="text-background/70 text-lg leading-relaxed">Cuéntanos cómo usas tu web y te orientamos hacia el mantenimiento que mejor encaja contigo.</p>
      </div>
      <a href="/contact?subject=Duda sobre mantenimiento&ref=precios-mantenimiento">
        <Button size="lg" withArrow arrowInverted={false} class="bg-background text-foreground hover:bg-background/90">Hablar con nosotros</Button>
      </a>
    </section>
  </section>
</MainLayout>
