---
import { Check, ShieldCheck } from "@lucide/astro";
import Breadcrumbs from "~/components/seo/Breadcrumbs.astro";
import Button from "~/components/ui/Button.astro";
import MainLayout from "~/layouts/MainLayout.astro";

const title = "Precios de mantenimiento web | doscientos";
const description =
  "Planes de mantenimiento web para mantener tu sitio seguro, actualizado y en evolución. Elige el nivel de soporte que necesita tu proyecto.";

const plans = [
  {
    name: "Esencial",
    price: "80 €",
    featured: false,
    audience: "Para una web estable",
    description:
      "La base técnica y una red de seguridad para que siga disponible.",
    cta: "Me interesa Esencial",
  },
  {
    name: "Crecimiento",
    price: "100 €",
    featured: true,
    audience: "Para negocios que actualizan",
    description:
      "Soporte, seguridad y tiempo mensual para mantener la web cuidada.",
    cta: "Me interesa Crecimiento",
  },
  {
    name: "Evolución",
    price: "450 €",
    featured: false,
    audience: "Para productos en movimiento",
    description:
      "Una bolsa de trabajo prioritaria para iterar y mejorar cada mes.",
    cta: "Hablar sobre Evolución",
  },
];

const features = [
  { label: "Hosting e infraestructura", values: ["check", "check", "check"] },
  { label: "Monitorización básica", values: ["check", "check", "check"] },
  { label: "Actualizaciones técnicas", values: ["—", "check", "check"] },
  { label: "Backups / seguridad", values: ["—", "check", "check"] },
  {
    label: "Corrección de errores",
    values: ["Críticos", "check", "Prioritaria"],
  },
  { label: "Soporte", values: ["Email", "Email/WhatsApp", "Prioritario"] },
  { label: "Cambios", values: ["—", "1 h/mes", "4 h/mes"] },
  {
    label: "Mejoras / nuevas funcionalidades",
    values: ["—", "Pequeñas", "check"],
  },
  { label: "Revisión periódica", values: ["—", "Trimestral", "Mensual"] },
  { label: "Analítica / rendimiento", values: ["—", "Básica", "check"] },
  { label: "Evolución continua", values: ["—", "Limitada", "check"] },
];
---

<MainLayout
  title={title}
  description={description}
  type="service"
  service={{
    name: "Mantenimiento web",
    description,
    serviceType: "Website maintenance",
    url: "/precios-mantenimiento",
  }}
>
  <section class="px-6 max-w-7xl mx-auto pt-6 md:pt-10 w-full">
    <Breadcrumbs
      items={[{ name: "Mantenimiento web", url: "/precios-mantenimiento" }]}
    />

    <header class="max-w-3xl mx-auto text-center pt-14 pb-10 md:pt-20 md:pb-12">
      <p
        class="inline-flex rounded-full bg-accent px-4 py-2 text-sm font-semibold text-primary"
      >
        Mantenimiento web
      </p>
      <h1
        class="mt-6 text-4xl md:text-6xl font-bold text-balance text-foreground"
      >
        Tu web al día, <span class="text-primary">sin sorpresas.</span>
      </h1>
      <p
        class="mt-5 text-lg md:text-xl leading-relaxed text-muted-foreground text-balance"
      >
        Seguridad, soporte y mejoras con un alcance claro. Elige cuánto quieres
        que nos impliquemos en el día a día de tu web.
      </p>
    </header>

    <section
      class="mb-8 grid gap-3 sm:grid-cols-3"
      aria-label="Incluido en todos los planes"
    >
      <div class="rounded-2xl border border-muted bg-accent/45 p-4">
        <p class="text-xs font-bold uppercase tracking-wider text-primary">
          Siempre incluido
        </p>
        <p class="mt-1 text-sm font-semibold text-foreground">
          Hosting e infraestructura
        </p>
      </div>
      <div class="rounded-2xl border border-muted bg-accent/45 p-4">
        <p class="text-xs font-bold uppercase tracking-wider text-primary">
          Siempre incluido
        </p>
        <p class="mt-1 text-sm font-semibold text-foreground">
          Monitorización de la web
        </p>
      </div>
      <div class="rounded-2xl border border-muted bg-accent/45 p-4">
        <p class="text-xs font-bold uppercase tracking-wider text-primary">
          A tu medida
        </p>
        <p class="mt-1 text-sm font-semibold text-foreground">
          Más soporte cuando lo necesitas
        </p>
      </div>
    </section>

    <p
      class="mb-3 flex items-center gap-2 text-sm text-muted-foreground md:hidden"
    >
      <span aria-hidden="true">←</span> Desliza para comparar todos los planes <span
        aria-hidden="true">→</span
      >
    </p>
    <div
      class="overflow-x-auto rounded-3xl border border-muted bg-background shadow-pastel"
      data-reveal="bottom"
    >
      <table
        class="w-full min-w-[760px] table-fixed border-collapse text-left whitespace-normal"
        style="display: table; max-width: none;"
      >
        <caption class="sr-only"
          >Comparativa de planes de mantenimiento web</caption
        >
        <thead>
          <tr class="border-b border-muted">
            <th
              scope="col"
              class="w-[30%] border-r border-muted bg-muted/35 px-6 py-6 align-bottom"
            >
              <span
                class="text-xs font-bold uppercase tracking-wider text-muted-foreground"
                >Qué necesitas</span
              >
              <p
                class="mt-2 text-sm font-medium normal-case tracking-normal text-foreground"
              >
                Compara el nivel de cobertura.
              </p>
            </th>
            {
              plans.map((plan) => (
                <th
                  scope="col"
                  class:list={[
                    "w-[23.33%] px-5 py-6 align-top",
                    plan.featured &&
                      "bg-primary/[0.06] border-x border-primary/15",
                  ]}
                >
                  <div class="flex min-h-48 flex-col items-start">
                    {plan.featured && (
                      <span class="mb-3 w-fit rounded-full bg-primary px-2.5 py-1 text-xs font-bold text-background">
                        MÁS ELEGIDO
                      </span>
                    )}
                    <span class="text-xl font-bold">{plan.name}</span>
                    <span class="mt-1 text-xs font-semibold uppercase tracking-wide text-primary">
                      {plan.audience}
                    </span>
                    <span class="mt-3 text-3xl font-bold leading-none">
                      {plan.price}
                      <span class="text-sm font-medium text-muted-foreground">
                        /mes
                      </span>
                    </span>
                    <p class="mt-3 min-h-10 text-sm font-normal leading-snug text-muted-foreground">
                      {plan.description}
                    </p>
                    <a
                      href={`/contact?subject=${encodeURIComponent(plan.cta)}&ref=precios-mantenimiento-${plan.name.toLowerCase()}`}
                      class:list={[
                        "mt-4 text-sm font-bold text-primary underline-offset-4 hover:underline focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2",
                        plan.featured && "text-foreground",
                      ]}
                    >
                      {plan.cta} <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            features.map((feature, rowIndex) => (
              <tr
                class:list={[
                  "border-b border-muted last:border-b-0",
                  rowIndex % 2 === 0 && "bg-muted/20",
                ]}
              >
                <th
                  scope="row"
                  class="border-r border-muted bg-background/55 px-6 py-4 text-sm font-semibold text-foreground"
                >
                  {feature.label}
                </th>
                {feature.values.map((value, index) => (
                  <td
                    class:list={[
                      "px-5 py-4 text-center text-sm font-medium",
                      index === 1 && "bg-primary/[0.06]",
                      value === "—"
                        ? "text-muted-foreground"
                        : "text-foreground",
                    ]}
                  >
                    {value === "check" ? (
                      <Check
                        class="mx-auto size-5 text-primary"
                        stroke-width={3}
                        aria-label="Incluido"
                      />
                    ) : (
                      value
                    )}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <aside
      class="mt-6 flex gap-3 rounded-2xl border border-primary/15 bg-accent/45 p-5 text-sm leading-relaxed text-primary"
    >
      <ShieldCheck class="size-5 shrink-0 mt-0.5" />
      <p>
        <strong>¿Tienes un caso que no encaja en la tabla?</strong> Cuéntanos cómo
        usas tu web y ajustamos el alcance antes de empezar. Sin pagar por un plan
        que no necesitas.
      </p>
    </aside>

    <section
      class="my-24 md:my-32 rounded-3xl bg-foreground text-background p-8 md:p-12 text-center flex flex-col items-center gap-6"
    >
      <div class="space-y-3 max-w-2xl">
        <h2 class="text-3xl md:text-5xl font-bold text-balance">
          ¿No tienes claro qué plan necesitas?
        </h2>
        <p class="text-background/70 text-lg leading-relaxed">
          Cuéntanos cómo usas tu web y te recomendaremos el nivel de soporte que
          realmente necesitas.
        </p>
      </div>
      <a
        href="/contact?subject=Duda sobre mantenimiento&ref=precios-mantenimiento"
      >
        <Button
          size="lg"
          withArrow
          arrowInverted={false}
          class="bg-background text-foreground hover:bg-background/90"
          >Hablar con nosotros</Button
        >
      </a>
    </section>
  </section>
</MainLayout>
