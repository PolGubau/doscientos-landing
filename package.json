{
  "name": "doscientos-landing",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "dev:fast": "astro dev --host --no-sync",
    "prebuild": "node scripts/sync-brand-tokens.mjs",
    "build": "astro build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "preview": "astro preview",
    "clean": "rimraf .astro node_modules/.vite dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "astro check",
    "typecheck": "astro check",
    "format": "oxfmt -c node_modules/@doscientos/configs/oxfmt.json --write .",
    "format:check": "oxfmt -c node_modules/@doscientos/configs/oxfmt.json --check .",
    "format:prettier": "prettier --write .",
    "format:oxfmt": "oxfmt -c node_modules/@doscientos/configs/oxfmt.json --write .",
    "format:oxfmt:check": "oxfmt -c node_modules/@doscientos/configs/oxfmt.json --check .",
    "lint:common": "oxlint",
    "lint:common:fix": "oxlint --fix --fix-suggestions",
    "quality:common": "pnpm format:oxfmt:check && pnpm lint:common && pnpm check && pnpm test",
    "seo:check": "node scripts/seo-check.mjs",
    "npm:downloads": "node scripts/npm-downloads-report.mjs",
    "npm:downloads:sync": "node scripts/sync-npm-downloads.mjs",
    "quality": "pnpm format:check && pnpm lint && pnpm check && pnpm test",
    "test:build": "pnpm quality && pnpm seo:check && pnpm build",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^6.3.10",
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/react": "^4.3.0",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.4.0",
    "@calcom/embed-react": "^1.5.3",
    "@iconify-json/simple-icons": "^1.2.85",
    "@lucide/astro": "^0.576.0",
    "@polgubau/astro-reveal": "^1.0.2",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.3",
    "astro": "^5.8.1",
    "astro-icon": "^1.1.5",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "js-yaml": "^5.1.0",
    "lucide-react": "^1.17.0",
    "medium-zoom": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-external-links": "^3.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.3",
    "tailwindcss-motion": "^1.1.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@doscientos/configs": "^0.1.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitest/coverage-v8": "^4.1.10",
    "astro-meta-tags": "^0.3.1",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.0.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "schema-dts": "^2.0.0",
    "sharp": "^0.34.1",
    "tailwindcss-intersect": "^2.0.1",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,astro,svelte}": "oxlint"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "pnpm@11.17.0"
}
